#!/bin/bash
# Runs a command so you can watch it live: prints the command, then streams its output
# into ~/Library/Logs/LittleGuy/live-runs.log (the menu bar app's "What Claude sees" tab) as well as here.
# (Not in the repo: macOS asks before an app may open anything in Documents, and a menu bar app stuck behind that
# question freezes; Library/Logs needs no permission.)
LOGDIR="$HOME/Library/Logs/LittleGuy"
mkdir -p "$LOGDIR"
LOG="$LOGDIR/live-runs.log"
{ echo; echo "──────── $(date +%H:%M:%S) ────────"; echo "\$ $*"; } >> "$LOG"
export PYTHONUNBUFFERED=1
start=$(date +%s)
"$@" 2>&1 | tee -a "$LOG"
code=${PIPESTATUS[0]}
echo "✓ done $(date +%H:%M:%S) in $(( $(date +%s) - start )) s (exit $code)" >> "$LOG"   # the menu bar app bubbles on this line
exit "$code"
