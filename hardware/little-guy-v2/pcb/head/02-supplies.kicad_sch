    )
    (uuid "eb31199b-024f-56c8-a38e-6246343a0bb7")
  )
  (text "XMOS power sequencing: core must remain off while 1.8 V is absent and 3.3 V is present.\nThe two I/O supervisors gate CORE_ENABLE; core supervisor then allows processor reset to release.\nThis circuit has not been measured. Rail timing, inrush, USB current and reset waveform are bench gates."
    (at 15 24 0)
    (effects
      (font
        (size 1.2 1.2)
      )
      (justify left)
    )
    (uuid "724de08d-f369-547f-a842-339f7e1ef938")
