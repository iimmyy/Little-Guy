  )
  (text "TX_ENABLE = software DE AND hardware MOTOR_ARMED. A stuck-high DE cannot override a cleared motor latch.\nPull-downs hold AHCT enables low while the 3.3 V gating supply is absent. MOTOR_ARMED has a local pull-down.\nMeasure actual servo data-pin backfeed with power off; this provision is not physical validation."
    (at 15 24 0)
    (effects
      (font
        (size 1.2 1.2)
      )
      (justify left)
    )
    (uuid "c1c30f4c-f5e0-5c17-81ec-55c7b774a6dc")
  )
