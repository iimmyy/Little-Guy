    )
    (uuid "b0eaa0e8-7476-521e-bdd4-10ea1c9e7b5c")
  )
  (text "Select only one branch at a time. Ch0=left foot, Ch1=right foot, Ch2=BME688, Ch3/4=extra edge sensors.\nStart at 100 kHz; pull-ups and maximum cable capacitance must be qualified together.\nIMU uses a separate four-wire SPI port so an I2C cable fault does not occupy that interface."
    (at 15 24 0)
    (effects
      (font
        (size 1.2 1.2)
      )
      (justify left)
    )
    (uuid "4591f5c7-8810-5bbb-8b45-26844321e9f6")
  )
