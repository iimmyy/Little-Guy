  (text "FOOT / identical PCB fitted twice; each foot has its own spinal I2C mux channel"
    (at 15 15 0)
    (effects
      (font
        (size 1.8 1.8)
      )
      (justify left)
    )
    (uuid "27237175-d7da-5805-9c2d-569cfd03058c")
  )
  (text "5 V cable supply; local 3.3 V powers the bridges and both ADCs. ToF uses a separate local 3.3 V regulator.\nCable order is fixed here and matched by the spinal schematic. Connector family and ESD parts remain open.\nADC addresses 0x40 / 0x41, toe 0x29 (7-bit). Start at 100 kHz; qualify the complete leg cable before 400 kHz."
    (at 15 24 0)
    (effects
      (font
        (size 1.2 1.2)
      )
      (justify left)
    )
    (uuid "ad321949-2bdd-5cdf-a03f-c45821fd659f")
  )
