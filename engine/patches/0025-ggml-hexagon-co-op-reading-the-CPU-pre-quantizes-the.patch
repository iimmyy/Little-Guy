+                lg_prof.cpu += ggml_time_us() - lt0; lg_prof.n_mm++;
+            } else if (it != lg_coop_w.end()) {
                 const lg_cpu_copy & cc = it->second;
                 ggml_tensor fsrc0 = *t->src[0];
                 fsrc0.ne[1] = cc.a; fsrc0.nb[2] = fsrc0.nb[3] = fsrc0.nb[1] * cc.a;
                 ggml_tensor fdst = *t;
                 fdst.ne[0] = cc.a; fdst.src[0] = &fsrc0;
+                const int64_t lt0 = ggml_time_us();
