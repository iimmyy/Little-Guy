 // compute graph nodes on the CPU (prompt reading in co-op mode); the tensors live in host-visible NPU buffers
+// The NPU's share used to start by quantizing all of src1 itself (~2 ms per matmul on its scalar units, whatever
+// its share). The CPU quantizes it once (its own q8_K / q8_0, 4 threads) straight into the layout of the NPU
+// kernels' input buffer (lg-q2k-ops.c), passed as the op's src[2].
+static size_t lg_r128(size_t n) { return (n + 127) & ~(size_t) 127; }
+
+// small persistent pool for the host-side pre-quantization (spawning threads per matmul cost ~0.2 ms each time)
+struct lg_pool {
+    std::vector<std::thread> th;
+    std::mutex m;
+    std::condition_variable cv, done_cv;
+    std::function<void(int)> job;
+    int n = 0, gen = 0, pending = 0;
+    bool quit = false;
+    explicit lg_pool(int nthreads) : n(nthreads) {
+        for (int i = 1; i < n; i++) th.emplace_back([this, i] {
+            int seen = 0;
+            for (;;) {
+                std::unique_lock<std::mutex> lk(m);
+                cv.wait(lk, [&] { return quit || gen != seen; });
+                if (quit) return;
+                seen = gen;
+                auto f = job;
+                lk.unlock();
+                f(i);
+                lk.lock();
+                if (--pending == 0) done_cv.notify_one();
+            }
+        });
+    }
+    void run(const std::function<void(int)> & f) {
+        { std::lock_guard<std::mutex> lk(m); job = f; pending = n - 1; gen++; }
+        cv.notify_all();
+        f(0);
+        std::unique_lock<std::mutex> lk(m);
+        done_cv.wait(lk, [&] { return pending == 0; });
+    }
+    ~lg_pool() { { std::lock_guard<std::mutex> lk(m); quit = true; } cv.notify_all(); for (auto & t : th) t.join(); }
+};
+
+static const void * lg_pq_last[2];   // input last quantized into each format's buffer (reset per graph)
+
+static ggml_tensor * lg_coop_prequant(ggml_hexagon_session * sess, const ggml_tensor * w, const ggml_tensor * x) {
+    const bool q2k = w->type == GGML_TYPE_Q2_K;
+    static ggml_backend_buffer_t bufs[2] = { nullptr, nullptr };
+    static size_t caps[2] = { 0, 0 };
+    static ggml_tensor pqs[2];
+    static int64_t last_ncols[2];
+    ggml_backend_buffer_t & buf = bufs[q2k];
+    size_t & cap = caps[q2k];
+    ggml_tensor & pq = pqs[q2k];
+    const int64_t K = x->ne[0], ncols = x->ne[1];
+    if (lg_pq_last[q2k] == x->data && last_ncols[q2k] == ncols && pq.ne[0]) {
+        return &pq;   // same input as the previous matmul of this format (gate and up, q and k)
+    }
+    const int64_t nsum = q2k ? (K / 256) * 8 : K / 32;      // words per column
+    const int64_t nxd  = q2k ? K / 256 : K / 32;            // floats per column
+    const size_t o_sum = lg_r128((size_t) ncols * K), o_xd = o_sum + lg_r128((size_t) ncols * nsum * 4);
+    const size_t total = o_xd + lg_r128((size_t) ncols * nxd * 4);
+    if (!buf || cap < total) {
+        if (buf) ggml_backend_buffer_free(buf);
+        cap = std::max(total, (size_t) 8 << 20);
+        buf = ggml_backend_buft_alloc_buffer(&sess->buffer_type, cap);
+        if (!buf) { cap = 0; return nullptr; }
+        // compute usage: the NPU then drops its cached copy of the buffer before reading (the CPU rewrites it per matmul)
+        ggml_backend_buffer_set_usage(buf, GGML_BACKEND_BUFFER_USAGE_COMPUTE);
+    }
+    uint8_t * base = (uint8_t *) ggml_backend_buffer_get_base(buf);
+    const ggml_type qt = q2k ? GGML_TYPE_Q8_K : GGML_TYPE_Q8_0;
+    const ggml_from_float_t from_float = ggml_get_type_traits_cpu(qt)->from_float;
+    auto work = [&](int64_t c0, int64_t c1) {
+        thread_local std::vector<uint8_t> tmp;
+        tmp.resize(ggml_row_size(qt, K));
+        for (int64_t col = c0; col < c1; col++) {
+            from_float((const float *) ((const uint8_t *) x->data + col * x->nb[1]), tmp.data(), K);
+            int8_t  * xq  = (int8_t *) (base + (size_t) col * K);
+            int32_t * xs  = (int32_t *) (base + o_sum) + col * nsum;
+            float   * xd  = (float *) (base + o_xd) + col * nxd;
+            if (q2k) {
+                const block_q8_K * b = (const block_q8_K *) tmp.data();
+                for (int64_t s = 0; s < K / 256; s++) {
+                    memcpy(xq + s * 256, b[s].qs, 256);
+                    uint8_t * lo = (uint8_t *) (xs + s * 8), * hi = (uint8_t *) (xs + s * 8 + 4);
+                    for (int g = 0; g < 16; g++) { lo[g] = (uint8_t) (b[s].bsums[g] & 0xff); hi[g] = (uint8_t) (int8_t) (b[s].bsums[g] >> 8); }
+                    xd[s] = b[s].d;
+                }
+            } else {
+                const block_q8_0 * b = (const block_q8_0 *) tmp.data();
+                for (int64_t i = 0; i < K / 32; i++) {
+                    memcpy(xq + i * 32, b[i].qs, 32);
+                    int32_t sum = 0;
+                    for (int j = 0; j < 32; j++) sum += b[i].qs[j];
+                    xs[i] = 8 * sum;
+                    xd[i] = GGML_FP16_TO_FP32(b[i].d);
+                }
+            }
+        }
+    };
+    static lg_pool pool(4);
+    pool.run([&](int t) { work(ncols * t / 4, ncols * (t + 1) / 4); });
+    lg_pq_last[q2k] = x->data;
+    last_ncols[q2k] = ncols;
+    pq = {};
+    pq.type = GGML_TYPE_I8;
+    pq.ne[0] = (int64_t) total; pq.ne[1] = pq.ne[2] = pq.ne[3] = 1;
+    pq.nb[0] = 1; pq.nb[1] = pq.nb[2] = pq.nb[3] = total;
+    pq.data = base; pq.buffer = buf;
+    return &pq;
+}
+
