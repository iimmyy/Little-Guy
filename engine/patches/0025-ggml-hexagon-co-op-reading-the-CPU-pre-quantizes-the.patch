+// Pre-quantized inputs from the host (co-op prompt reading): src[2] holds xq for all columns, then the sums, then
+// the scales, each region 128-byte aligned. Copy this pass's columns into the cached buffer.
+static void lg_copy_prequant(const struct htp_tensor * pq, uint32_t K, uint32_t ncols_all, uint32_t nsum, uint32_t nxd,
+                             uint32_t col0, uint32_t ncols, int8_t * xq, int32_t * xs, float * xd) {
+    const uint8_t * base = (const uint8_t *) pq->data;
+    const uint32_t o_sum = hex_round_up(ncols_all * K, 128), o_xd = o_sum + hex_round_up(ncols_all * nsum * 4, 128);
+    hvx_copy_uu((uint8_t *) xq, base + (size_t) col0 * K, ncols * K, 1);
+    hvx_copy_uu((uint8_t *) xs, base + o_sum + (size_t) col0 * nsum * 4, ncols * nsum * 4, 1);
+    hvx_copy_uu((uint8_t *) xd, base + o_xd + (size_t) col0 * nxd * 4, ncols * nxd * 4, 1);
+}
+
 int lg_op_matmul_q2k(struct htp_ops_context * octx) {
     const struct htp_tensor * src0 = octx->src[0];
     const struct htp_tensor * src1 = octx->src[1];
@@ -394,7 +406,10 @@ int lg_op_matmul_q2k(struct htp_ops_context * octx) {
         c.xd   = (float *) p;
 
