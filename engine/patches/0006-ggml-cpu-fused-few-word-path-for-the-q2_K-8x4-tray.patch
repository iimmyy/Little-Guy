From 8767c5aefeaefe1e2e3afcd5a45367e756c2bb81 Mon Sep 17 00:00:00 2001
From: iimmyy <i.a.martins001@gmail.com>
Date: Sat, 10 Oct 2026 21:51:08 -0700
Subject: [PATCH 06/48] ggml-cpu: fused few-word path for the q2_K 8x4 tray

For up to LG_Q2K_FUSED_MAX words (default 4, the drafter's verification batch) the raw 2-bit codes go straight into lane-indexed dot products and each pouch's partial sums are scaled once, instead of writing and re-reading a pre-scaled 2 KB template per super-block. Same answers as the generic reference to 1.7e-7. One Cortex-A78 core at 1.32 GHz, 4 words: ffn_gate 7.77 -> 7.04 ms, attn_q 1.56 -> 1.41 ms. Whole brain (clean C, drafter n-max 3, greedy): identical text, talking 7-9% faster.
---
 ggml/src/ggml-cpu/arch/arm/repack.cpp | 85 +++++++++++++++++++++++++++
 1 file changed, 85 insertions(+)

diff --git a/ggml/src/ggml-cpu/arch/arm/repack.cpp b/ggml/src/ggml-cpu/arch/arm/repack.cpp
index eee2ab8..95e7f31 100644
--- a/ggml/src/ggml-cpu/arch/arm/repack.cpp
+++ b/ggml/src/ggml-cpu/arch/arm/repack.cpp
@@ -5581,6 +5581,87 @@ void ggml_gemv_q2_K_8x4_q8_K(int n, float * GGML_RESTRICT s, size_t bs, const vo
     ggml_gemv_q2_K_8x4_q8_K_generic(n, s, bs, vx, vy, nr, nc);
 }
 
+#if defined(__aarch64__) && defined(__ARM_NEON) && defined(__ARM_FEATURE_DOTPROD)
+// Few words (checking the drafter's guesses): the template's write-then-read of 2 KB per super-block costs as much as
+// the dot products when only 4 words share it. Here the raw 2-bit codes go straight into lane-indexed dot products for
+// each group of 4 words, one pouch at a time, and each pouch's partial sums are multiplied by its scale ("season the
+// totals", as the one-word oven does). Same answers as the template, up to float rounding.
+static void q2_Kx8_gemm_fused(int nb, float * GGML_RESTRICT s, size_t bs, const block_q2_Kx8 * GGML_RESTRICT bx,
+                              const block_q8_Kx4 * GGML_RESTRICT ay, int nr, int nc) {
+    for (int x = 0; x < nc / 8; x++) {
+        const block_q2_Kx8 * b_ptr = bx + (size_t) x * nb;
+        for (int y = 0; y < nr / 4; y++) {
+            const block_q8_Kx4 * a_ptr = ay + (size_t) y * nb;
+            float32x4_t acc[4][2];
+            for (int m = 0; m < 4; m++) acc[m][0] = acc[m][1] = vdupq_n_f32(0.0f);
+            for (int l = 0; l < nb; l++) {
+                const block_q2_Kx8 & b = b_ptr[l];
+                const block_q8_Kx4 & a = a_ptr[l];
+                int32x4_t isum[4][2];
+                for (int m = 0; m < 4; m++) isum[m][0] = isum[m][1] = vdupq_n_s32(0);
+                for (int h = 0; h < 2; h++) {
+                    for (int odd = 0; odd < 2; odd++) {
+                        // byte groups q = h*8 + odd*4 + G hold, in plane p, elements of pouch h*8 + 2p + odd
+                        const uint8_t * qs = b.qs + (h * 8 + odd * 4) * 32;
+                        const int8_t *  aq = a.qs + (h * 128 + odd * 16) * 4;   // plane 0, G = 0
+#define LG_Q2K_FUSED_PLANE(P)                                                                                    \
+                        {                                                                                        \
+                            int32x4_t ps[4][2];                                                                  \
+                            for (int m = 0; m < 4; m++) ps[m][0] = ps[m][1] = vdupq_n_s32(0);                    \
+                            for (int G = 0; G < 4; G++) {                                                        \
+                                const int8x16_t c0 = vreinterpretq_s8_u8(q2_Kx8_codes<(P) * 2>(vld1q_u8(qs + G * 32)));      \
+                                const int8x16_t c1 = vreinterpretq_s8_u8(q2_Kx8_codes<(P) * 2>(vld1q_u8(qs + G * 32 + 16))); \
+                                const int8x16_t A  = vld1q_s8(aq + (P) * 128 + G * 16);                          \
+                                ps[0][0] = vdotq_laneq_s32(ps[0][0], c0, A, 0);                                  \
+                                ps[0][1] = vdotq_laneq_s32(ps[0][1], c1, A, 0);                                  \
+                                ps[1][0] = vdotq_laneq_s32(ps[1][0], c0, A, 1);                                  \
+                                ps[1][1] = vdotq_laneq_s32(ps[1][1], c1, A, 1);                                  \
+                                ps[2][0] = vdotq_laneq_s32(ps[2][0], c0, A, 2);                                  \
+                                ps[2][1] = vdotq_laneq_s32(ps[2][1], c1, A, 2);                                  \
+                                ps[3][0] = vdotq_laneq_s32(ps[3][0], c0, A, 3);                                  \
+                                ps[3][1] = vdotq_laneq_s32(ps[3][1], c1, A, 3);                                  \
+                            }                                                                                    \
+                            const int        t   = h * 8 + 2 * (P) + odd;                                        \
+                            const uint16x8_t s16 = vmovl_u8(q2_Kx8_pouch_scales(b.scales + 16 * (t / 2), t % 2)); \
+                            const int32x4_t  slo = vreinterpretq_s32_u32(vmovl_u16(vget_low_u16(s16)));          \
+                            const int32x4_t  shi = vreinterpretq_s32_u32(vmovl_u16(vget_high_u16(s16)));         \
+                            for (int m = 0; m < 4; m++) {                                                        \
+                                isum[m][0] = vmlaq_s32(isum[m][0], ps[m][0], slo);                               \
+                                isum[m][1] = vmlaq_s32(isum[m][1], ps[m][1], shi);                               \
+                            }                                                                                    \
+                        }
+                        LG_Q2K_FUSED_PLANE(0) LG_Q2K_FUSED_PLANE(1) LG_Q2K_FUSED_PLANE(2) LG_Q2K_FUSED_PLANE(3)
+#undef LG_Q2K_FUSED_PLANE
+                    }
+                }
+                // word m's sum of pouch t sits at bsums[(t / 4) * 16 + m * 4 + t % 4]
+                int32x4_t mlo[4], mhi[4];
+                q2_Kx8_mins<4>(b, [&](int m, int t) { return a.bsums[(t / 4) * 16 + m * 4 + t % 4]; }, mlo, mhi);
+                float32x4_t d_lo, d_hi, dm_lo, dm_hi;
+                q2_Kx8_load_d(b.d, d_lo, d_hi);
+                q2_Kx8_load_d(b.dmin, dm_lo, dm_hi);
+                for (int m = 0; m < 4; m++) {
+                    acc[m][0] = vfmaq_f32(acc[m][0], vcvtq_f32_s32(isum[m][0]), vmulq_n_f32(d_lo, a.d[m]));
+                    acc[m][1] = vfmaq_f32(acc[m][1], vcvtq_f32_s32(isum[m][1]), vmulq_n_f32(d_hi, a.d[m]));
+                    acc[m][0] = vfmsq_f32(acc[m][0], vcvtq_f32_s32(mlo[m]), vmulq_n_f32(dm_lo, a.d[m]));
+                    acc[m][1] = vfmsq_f32(acc[m][1], vcvtq_f32_s32(mhi[m]), vmulq_n_f32(dm_hi, a.d[m]));
+                }
+            }
+            for (int m = 0; m < 4; m++) {
+                vst1q_f32(s + (size_t) (y * 4 + m) * bs + x * 8, acc[m][0]);
+                vst1q_f32(s + (size_t) (y * 4 + m) * bs + x * 8 + 4, acc[m][1]);
+            }
+        }
+    }
+}
+
+// LG_Q2K_FUSED_MAX: largest word count that takes the fused path (default 4, the size measured faster; 0 = always the template)
+static int q2_Kx8_fused_max() {
+    static const int v = getenv("LG_Q2K_FUSED_MAX") ? atoi(getenv("LG_Q2K_FUSED_MAX")) : 4;
+    return v;
+}
+#endif
+
 void ggml_gemm_q2_K_8x4_q8_K(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr, int nc) {
     constexpr int qk = QK_K;
     const int     nb = n / qk;
@@ -5589,6 +5670,10 @@ void ggml_gemm_q2_K_8x4_q8_K(int n, float * GGML_RESTRICT s, size_t bs, const vo
     assert(nc % 8 == 0);
 
 #if defined(__aarch64__) && defined(__ARM_NEON) && defined(__ARM_FEATURE_DOTPROD)
+    if (!q2_Kx8_use_reference("gemm") && nr <= q2_Kx8_fused_max()) {
+        q2_Kx8_gemm_fused(nb, s, bs, (const block_q2_Kx8 *) vx, (const block_q8_Kx4 *) vy, nr, nc);
+        return;
+    }
     if (!q2_Kx8_use_reference("gemm")) {
     // Overlay order: each tray super-block is decoded once into pre-scaled codes (2 KB, L1-resident), then every group
     // of 4 words is stamped against it with lane-indexed dot products (one 16-byte activation load feeds 8 of them).
