+// Q2_K x8 tray with 4-byte columns (built by make_block_q2_Kx8(.., 4)): reference kernels written straight from the
+// definition, one code at a time. Byte b of row j lives at qs[((b / 4) * 8 + j) * 4 + b % 4]; its plane s (shift 2s)
+// is element e = (b / 32) * 128 + s * 32 + b % 32, in pouch t = e / 16, whose scale/min byte is
+// scales[16 * (t / 2) + 2 * j + t % 2] (low nibble scale, high nibble min).
+static inline int q2_Kx8_c4_code(const block_q2_Kx8 & b, int j, int byte, int s) {
+    return (b.qs[((byte / 4) * 8 + j) * 4 + byte % 4] >> (2 * s)) & 3;
+}
+
+static inline uint8_t q2_Kx8_scale_byte(const block_q2_Kx8 & b, int j, int t) {
+    return b.scales[16 * (t / 2) + 2 * j + t % 2];
+}
