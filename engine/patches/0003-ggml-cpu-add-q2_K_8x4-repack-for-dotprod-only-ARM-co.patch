+#define LG_Q2K_STAMP(S)                                                                                          \
+                    {                                                                                            \
+                        const int8x16_t A  = vld1q_s8(aq + (S) * 128);   /* +32 elements per plane */           \
+                        const int8x16_t w0 = vld1q_s8(o + (S) * 32), w1 = vld1q_s8(o + (S) * 32 + 16);          \
+                        isum[0][0] = vdotq_laneq_s32(isum[0][0], w0, A, 0);                                      \
+                        isum[0][1] = vdotq_laneq_s32(isum[0][1], w1, A, 0);                                      \
+                        isum[1][0] = vdotq_laneq_s32(isum[1][0], w0, A, 1);                                      \
+                        isum[1][1] = vdotq_laneq_s32(isum[1][1], w1, A, 1);                                      \
+                        isum[2][0] = vdotq_laneq_s32(isum[2][0], w0, A, 2);                                      \
+                        isum[2][1] = vdotq_laneq_s32(isum[2][1], w1, A, 2);                                      \
+                        isum[3][0] = vdotq_laneq_s32(isum[3][0], w0, A, 3);                                      \
+                        isum[3][1] = vdotq_laneq_s32(isum[3][1], w1, A, 3);                                      \
+                    }
+                    LG_Q2K_STAMP(0) LG_Q2K_STAMP(1) LG_Q2K_STAMP(2) LG_Q2K_STAMP(3)
