+void ggml_gemv_q2_K_8x4_q8_K_generic(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr, int nc) {
+    const int nb = n / QK_K;
+    assert(n % QK_K == 0);
+    assert(nc % 8 == 0);
+    UNUSED(bs);
+    UNUSED(nr);
+    const block_q8_K * a = (const block_q8_K *) vy;
+    for (int x = 0; x < nc / 8; x++) {
+        const block_q2_Kx8 * b = (const block_q2_Kx8 *) vx + x * nb;
+        for (int j = 0; j < 8; j++) {
+            float sum = 0.0f;
+            for (int l = 0; l < nb; l++) {
+                int sumi = 0, summ = 0;
+                for (int byte = 0; byte < 64; byte++) {
+                    for (int sh = 0; sh < 4; sh++) {
+                        const int e = (byte / 32) * 128 + sh * 32 + byte % 32;
+                        sumi += q2_Kx8_c4_code(b[l], j, byte, sh) * (q2_Kx8_scale_byte(b[l], j, e / 16) & 0xF) * a[l].qs[e];
+                    }
+                }
+                for (int t = 0; t < 16; t++) {
+                    summ += (q2_Kx8_scale_byte(b[l], j, t) >> 4) * a[l].bsums[t];
+                }
+                sum += a[l].d * (GGML_CPU_FP16_TO_FP32(b[l].d[j]) * sumi - GGML_CPU_FP16_TO_FP32(b[l].dmin[j]) * summ);
+            }
+            s[x * 8 + j] = sum;
+        }
+    }
+}
