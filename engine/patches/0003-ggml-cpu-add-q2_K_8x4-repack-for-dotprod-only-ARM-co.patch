+                }
+                // pouch mins x the words' pouch sums; bsums of pouches 4q4..4q4+3 for word m are 4 contiguous int16
+                int32x4_t mlo[4], mhi[4];
+                for (int m = 0; m < 4; m++) {
+                    mlo[m] = vdupq_n_s32(0);
+                    mhi[m] = vdupq_n_s32(0);
+                }
+                for (int q4 = 0; q4 < 4; q4++) {
