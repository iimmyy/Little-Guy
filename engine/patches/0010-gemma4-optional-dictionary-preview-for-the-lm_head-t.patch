From 443dab6a5b03b7d8c979be166e6ce90019c1fa0a Mon Sep 17 00:00:00 2001
From: iimmyy <i.a.martins001@gmail.com>
Date: Mon, 12 Oct 2026 12:41:27 -0700
Subject: [PATCH 10/33] gemma4: optional dictionary preview for the lm_head
 (token_embd_preview, LG_DICT_PREVIEW)

When the GGUF has a rough low-bit copy of the tied dictionary, the lm_head scores that copy first, keeps the
best LG_DICT_PREVIEW words (default 1024, 0 turns it off), and scores only those rows of token_embd at full
quality. The rest get -INF after the softcap, so samplers still see a full-size logit row. Same pattern as the
gemma4-assistant clustered head.

On brain C (Q6_K dictionary, 551 MB) a Q2_K preview cuts the per-word dictionary read to ~222 MB. Greedy replies
are identical; sampled replies keep the same candidates, with odds within ~0.5% because the shortlist is scored
with unrounded activations.
---
 src/llama-arch.cpp    |  2 ++
 src/llama-arch.h      |  1 +
 src/llama-model.h     |  1 +
 src/models/gemma4.cpp | 52 ++++++++++++++++++++++++++++++++++++++-----
 4 files changed, 50 insertions(+), 6 deletions(-)

diff --git a/src/llama-arch.cpp b/src/llama-arch.cpp
index 6f9003d..eed2647 100644
--- a/src/llama-arch.cpp
+++ b/src/llama-arch.cpp
@@ -567,6 +567,7 @@ static const std::map<llm_tensor, const char *> LLM_TENSOR_NAMES = {
     { LLM_TENSOR_INDEXER_ATTN_Q_B,                       "blk.%d.indexer.attn_q_b" },
     { LLM_TENSOR_MASKED_EMBD_CENTROIDS,                  "masked_embd_centroids" },
     { LLM_TENSOR_MASKED_EMBD_ORDERING,                   "masked_embd_ordering" },
+    { LLM_TENSOR_TOKEN_EMBD_PREVIEW,                     "token_embd_preview" },
     { LLM_TENSOR_FC,                                     "fc" },
     { LLM_TENSOR_D2T,                                    "d2t" },
 };
@@ -795,6 +796,7 @@ static const std::map<llm_tensor, llm_tensor_info> LLM_TENSOR_INFOS = {
     {LLM_TENSOR_FFN_LATENT_UP,              {LLM_TENSOR_LAYER_REPEATING, GGML_OP_MUL_MAT}},
     {LLM_TENSOR_MASKED_EMBD_CENTROIDS,      {LLM_TENSOR_LAYER_OUTPUT,    GGML_OP_MUL_MAT}},
     {LLM_TENSOR_MASKED_EMBD_ORDERING,       {LLM_TENSOR_LAYER_OUTPUT,    GGML_OP_GET_ROWS}},
+    {LLM_TENSOR_TOKEN_EMBD_PREVIEW,         {LLM_TENSOR_LAYER_OUTPUT,    GGML_OP_MUL_MAT}},
     // eagle3
     {LLM_TENSOR_FC,                         {LLM_TENSOR_LAYER_OUTPUT,    GGML_OP_MUL_MAT}},
     {LLM_TENSOR_D2T,                        {LLM_TENSOR_LAYER_OUTPUT,    GGML_OP_GET_ROWS}},
diff --git a/src/llama-arch.h b/src/llama-arch.h
index 989da06..355a73f 100644
--- a/src/llama-arch.h
+++ b/src/llama-arch.h
@@ -575,6 +575,7 @@ enum llm_tensor {
     LLM_TENSOR_NEXTN_SHARED_HEAD_NORM,
     LLM_TENSOR_MASKED_EMBD_CENTROIDS,
     LLM_TENSOR_MASKED_EMBD_ORDERING,
+    LLM_TENSOR_TOKEN_EMBD_PREVIEW,
     LLM_TENSOR_FC,
     LLM_TENSOR_D2T,
 };
diff --git a/src/llama-model.h b/src/llama-model.h
index 103e029..46f3526 100644
--- a/src/llama-model.h
+++ b/src/llama-model.h
@@ -576,6 +576,7 @@ struct llama_model {
     // gemma4 assistant: clustered output head (score centroids, then only the tokens in the top clusters)
     struct ggml_tensor * masked_embd_centroids = nullptr;  // [n_embd, n_centroids]
     struct ggml_tensor * masked_embd_ordering  = nullptr;  // [n_vocab] I32, token ids grouped by cluster
+    struct ggml_tensor * tok_embd_preview      = nullptr;  // [n_embd, n_vocab] rough low-bit copy of tok_embd for the shortlist
 
     // unified vector to store target-model extracted layer ids in eagle3, dflash, etc.
     std::vector<int32_t> target_layer_ids;
diff --git a/src/models/gemma4.cpp b/src/models/gemma4.cpp
index 6a96979..3f64ec5 100644
--- a/src/models/gemma4.cpp
+++ b/src/models/gemma4.cpp
@@ -49,6 +49,13 @@ void llama_model_gemma4::load_arch_tensors(llama_model_loader &) {
 
     tok_embd = create_tensor(tn(LLM_TENSOR_TOKEN_EMBD, "weight"), {n_embd, n_vocab}, 0);
 
+    // Optional rough copy of the dictionary (e.g. Q2_K). When present, the lm_head scores it first, keeps a
+    // shortlist and scores only those rows at full quality. LG_DICT_PREVIEW=<n> sets the shortlist, 0 turns it off.
+    tok_embd_preview = create_tensor(tn(LLM_TENSOR_TOKEN_EMBD_PREVIEW, "weight"), {n_embd, n_vocab}, TENSOR_NOT_REQUIRED);
+    if (tok_embd_preview) {
+        LLAMA_LOG_INFO("%s: dictionary preview present (%s)\n", __func__, ggml_type_name(tok_embd_preview->type));
+    }
+
     if (n_embd_per_layer > 0) {
         per_layer_tok_embd   = create_tensor(tn(LLM_TENSOR_PER_LAYER_TOKEN_EMBD, "weight"),    {n_embd_per_layer * n_layer, n_vocab}, 0);
         per_layer_model_proj = create_tensor(tn(LLM_TENSOR_PER_LAYER_MODEL_PROJ, "weight", 0), {n_embd, n_embd_per_layer * n_layer}, 0);
@@ -421,12 +428,45 @@ llama_model_gemma4::graph::graph(const llama_model & model, const llm_graph_para
     res->t_embd = cur;
 
     // lm_head
-    cur = build_lora_mm(model.output, cur, model.output_s);
-
-    if (hparams.f_final_logit_softcapping) {
-        cur = ggml_scale(ctx0, cur, 1.0f / hparams.f_final_logit_softcapping);
-        cur = ggml_tanh(ctx0, cur);
-        cur = ggml_scale(ctx0, cur, hparams.f_final_logit_softcapping);
+    static const int64_t n_shortlist = [] {
+        const char * e = getenv("LG_DICT_PREVIEW");
+        return (int64_t) (e ? atoi(e) : 1024);
+    }();
+    const int64_t n_vocab_out = model.output->ne[1];
+    const bool use_preview = model.tok_embd_preview && !model.output_s && n_shortlist > 0 && n_shortlist < n_vocab_out;
+
+    auto softcap = [&](ggml_tensor * x) {
+        if (hparams.f_final_logit_softcapping) {
+            x = ggml_scale(ctx0, x, 1.0f / hparams.f_final_logit_softcapping);
+            x = ggml_tanh(ctx0, x);
+            x = ggml_scale(ctx0, x, hparams.f_final_logit_softcapping);
+        }
+        return x;
+    };
+
+    if (use_preview) {
+        // Skim the rough copy, keep the best n_shortlist words, score only those at full quality. Everything else
+        // gets -INF (after the softcap, so it stays impossible), and samplers see a normal full-size logit row.
+        const int64_t n_outputs = cur->ne[1];
+        cur = ggml_cont(ctx0, cur);
+
+        ggml_tensor * rough = ggml_mul_mat(ctx0, model.tok_embd_preview, cur);                  // [n_vocab, n_outputs]
+        cb(rough, "dict_preview", -1);
+        ggml_tensor * ids = ggml_top_k(ctx0, rough, n_shortlist);                                // [n_shortlist, n_outputs] I32
+        cb(ids, "dict_shortlist", -1);
+
+        // tok_embd holds the same (tied) weights as output but stays in a get_rows friendly layout (output may be repacked)
+        ggml_tensor * rows = ggml_get_rows(ctx0, model.tok_embd, ggml_reshape_1d(ctx0, ids, n_shortlist * n_outputs));
+        rows = ggml_reshape_3d(ctx0, rows, rows->ne[0], n_shortlist, n_outputs);
+        ggml_tensor * sel = ggml_mul_mat(ctx0, rows, ggml_reshape_3d(ctx0, cur, cur->ne[0], 1, n_outputs)); // [n_shortlist, 1, n_outputs]
+        sel = softcap(sel);
+
+        ggml_tensor * logits = ggml_fill(ctx0, ggml_new_tensor_3d(ctx0, GGML_TYPE_F32, 1, n_vocab_out, n_outputs), -INFINITY);
+        logits = ggml_set_rows(ctx0, logits, ggml_reshape_3d(ctx0, sel, 1, n_shortlist, n_outputs), ids);
+        cur = ggml_reshape_2d(ctx0, logits, n_vocab_out, n_outputs);
+    } else {
+        cur = build_lora_mm(model.output, cur, model.output_s);
+        cur = softcap(cur);
     }
 
     // apply logits bias if needed (e.g. for gemma4_unified patch)
