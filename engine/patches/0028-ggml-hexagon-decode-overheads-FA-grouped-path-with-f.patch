From 578458538d59faf89143052cc5d1c1b2eec59fc6 Mon Sep 17 00:00:00 2001
From: iimmyy <i.a.martins001@gmail.com>
Date: Wed, 14 Oct 2026 04:03:22 -0700
Subject: [PATCH 28/33] ggml-hexagon decode overheads: FA grouped path with
 fixed-size value sums (masked rows in partial blocks zeroed, no per-key
 check) and a 32-key qf32 fold tree for q.k (local layer 190 -> 121 us, global
 388 -> 276); rope cos/sin tables cached per thread (scalar build below v79,
 2.0 -> 0.8 ms/token, bit-identical); one-row GEGLU in one pass split over
 threads; Q2_K/Q4_0 one-column matmuls quantize their input inside the tile
 job from a DMA'd copy (one dispatch, first tiles in flight). ggml-cpu:
 two-pass radix top_k for one long row (1.41 -> 1.09 ms), contiguous FILL
 split by elements (0.85 -> 0.04 ms). Talking d768 9.04 -> 9.5-9.9 tok/s (CPU
 8.9), server 10.07 vs 9.25; decode KL vs CPU 0.0125 (unchanged); behavior
 40x4 within noise

---
 ggml/src/ggml-cpu/ops.cpp                  | 126 ++++++++++++++++++++-
 ggml/src/ggml-hexagon/htp/act-ops.c        |  57 ++++++++++
 ggml/src/ggml-hexagon/htp/flash-attn-ops.c | 122 ++++++++++++++++----
 ggml/src/ggml-hexagon/htp/lg-q2k-ops.c     |  98 +++++++++++++++-
 ggml/src/ggml-hexagon/htp/rope-ops.c       |  49 +++++++-
 tests/test-backend-ops.cpp                 |   5 +
 6 files changed, 426 insertions(+), 31 deletions(-)

diff --git a/ggml/src/ggml-cpu/ops.cpp b/ggml/src/ggml-cpu/ops.cpp
index ad5df8b..9d036c5 100644
--- a/ggml/src/ggml-cpu/ops.cpp
+++ b/ggml/src/ggml-cpu/ops.cpp
@@ -2219,6 +2219,14 @@ static void ggml_compute_forward_gelu(
 static void ggml_compute_forward_fill_f32(const ggml_compute_params * params, ggml_tensor * dst) {
     const float c = ggml_get_op_params_f32(dst, 0);
 
+    if (ggml_is_contiguous(dst)) {
+        // one block: split the elements, not the rows (a [1, n] tensor would be n one-element rows)
+        const int64_t n  = ggml_nelements(dst);
+        const int64_t i0 = n * params->ith / params->nth, i1 = n * (params->ith + 1) / params->nth;
+        ggml_vec_set_f32((int) (i1 - i0), (float *) dst->data + i0, c);
+        return;
+    }
+
     GGML_TENSOR_LOCALS(int64_t, ne, dst, ne);
     GGML_TENSOR_LOCALS(size_t,  nb, dst, nb);
 
@@ -8367,6 +8375,113 @@ static void lg_top_k_row_team(const ggml_compute_params * params, const float *
     ggml_barrier(params->threadpool);   // the shared scratch is reused by the next row
 }
 
+// LG: the same selection in two passes over the row instead of six. Pass 1 copies the slice (once, from memory
+// that may be uncached for the CPU) and builds the top-11-bit histogram. Thread 0 finds the bin b holding the k-th
+// largest key. Pass 2 writes every element of a bin above b straight to dst (offsets come from the histograms) and
+// lists the indices in bin b. Thread 0 then finishes on that short list with the remaining 21 bits, writing those
+// above the k-th key and the ties at it in index order: the same set as lg_top_k_row_team. Falls back to it when a
+// thread's list would not fit its scratch.
+static bool lg_top_k_row_team2(const ggml_compute_params * params, const float * x_src, int64_t n, int k, int32_t * dst,
+                               uint32_t * shared, float * const * locals, int64_t cap) {
+    const int ith = params->ith, nth = params->nth;
+    const int64_t c0 = n * ith / nth, c1 = n * (ith + 1) / nth;
+    float * local = locals[ith];
+    uint32_t * hist  = shared;                    // [nth][2048]
+    uint32_t * state = shared + nth * 2048;       // b, n above b, ok
+    uint32_t * h = hist + ith * 2048;
+    memset(h, 0, 2048 * sizeof(uint32_t));
+    for (int64_t i = c0; i < c1; i++) {
+        const float f = x_src[i];
+        local[i - c0] = f;
+        h[lg_top_k_key(f) >> 21]++;
+    }
+    ggml_barrier(params->threadpool);
+    if (ith == 0) {
+        uint32_t cum = 0;
+        int64_t b = 2047;
+        for (; b > 0; b--) {
+            uint32_t tot = 0;
+            for (int t = 0; t < nth; t++) tot += hist[t * 2048 + b];
+            if (cum + tot >= (uint32_t) k) break;
+            cum += tot;
+        }
+        uint32_t ok = 1;
+        for (int t = 0; t < nth; t++) ok &= hist[t * 2048 + b] <= cap;
+        state[0] = (uint32_t) b; state[1] = cum; state[2] = ok;
+    }
+    ggml_barrier(params->threadpool);
+    const uint32_t b = state[0], n_above = state[1];
+    if (!state[2]) {
+        return false;   // (no thread has written dst yet)
+    }
+    uint32_t a_off = 0;
+    for (int t = 0; t < ith; t++) for (uint32_t j = b + 1; j < 2048; j++) a_off += hist[t * 2048 + j];
+    int32_t * cand = (int32_t *) (local + (c1 - c0));
+    uint32_t nc = 0;
+    for (int64_t i = c0; i < c1; i++) {
+        const uint32_t hb = lg_top_k_key(local[i - c0]) >> 21;
+        if (hb > b) {
+            dst[a_off++] = (int32_t) i;
+        } else if (hb == b) {
+            cand[nc++] = (int32_t) i;
+        }
+    }
+    ggml_barrier(params->threadpool);
+    if (ith == 0) {
+        // the k - n_above best of the bin-b lists (in index order: thread by thread), on the low 21 bits
+        uint32_t need = (uint32_t) k - n_above, prefix = b << 21, mask = 0xFFE00000u;
+        static const int shift[2] = { 10, 0 };
+        static const int width[2] = { 11, 10 };
+        uint32_t h2[2048];
+        for (int pass = 0; pass < 2; pass++) {
+            const uint32_t bins = 1u << width[pass];
+            memset(h2, 0, bins * sizeof(uint32_t));
+            for (int t = 0; t < nth; t++) {
+                const int64_t t0 = n * t / nth, t1 = n * (t + 1) / nth;
+                const int32_t * ct = (const int32_t *) (locals[t] + (t1 - t0));
+                const uint32_t m = hist[t * 2048 + b];
+                for (uint32_t j = 0; j < m; j++) {
+                    const uint32_t key = lg_top_k_key(locals[t][ct[j] - t0]);
+                    if ((key & mask) == prefix) h2[(key >> shift[pass]) & (bins - 1)]++;
+                }
+            }
+            uint32_t cum = 0;
+            for (int64_t bb = bins - 1; bb >= 0; bb--) {
+                if (cum + h2[bb] >= need) {
+                    prefix |= (uint32_t) bb << shift[pass];
+                    mask   |= (bins - 1) << shift[pass];
+                    need   -= cum;
+                    break;
+                }
+                cum += h2[bb];
+            }
+        }
+        uint32_t o = n_above, above = 0;
+        for (int t = 0; t < nth; t++) {   // the count above the k-th key first, so the ties go after them
+            const int64_t t0 = n * t / nth, t1 = n * (t + 1) / nth;
+            const int32_t * ct = (const int32_t *) (locals[t] + (t1 - t0));
+            const uint32_t m = hist[t * 2048 + b];
+            for (uint32_t j = 0; j < m; j++) above += lg_top_k_key(locals[t][ct[j] - t0]) > prefix;
+        }
+        uint32_t e = 0;
+        for (int t = 0; t < nth; t++) {
+            const int64_t t0 = n * t / nth, t1 = n * (t + 1) / nth;
+            const int32_t * ct = (const int32_t *) (locals[t] + (t1 - t0));
+            const uint32_t m = hist[t * 2048 + b];
+            for (uint32_t j = 0; j < m; j++) {
+                const uint32_t key = lg_top_k_key(locals[t][ct[j] - t0]);
+                if (key > prefix) {
+                    dst[o++] = ct[j];
+                } else if (key == prefix && e < need) {
+                    dst[n_above + above + e++] = ct[j];
+                }
+            }
+        }
+    }
+    ggml_barrier(params->threadpool);   // the shared scratch is reused by the next row
+    return true;
+}
+
 static void ggml_compute_forward_top_k_f32(
     const ggml_compute_params * params,
     ggml_tensor * dst) {
@@ -8385,10 +8500,15 @@ static void ggml_compute_forward_top_k_f32(
     const int top_k = ne0;
 
     if (nr < nth && nth > 1 && ne00 >= (int64_t) nth * 2048 + 64 && !getenv("LG_TOPK_SORT")) {
+        float * locals[GGML_MAX_N_THREADS];
+        for (int t = 0; t < nth; t++) locals[t] = (float *) ((int32_t *) params->wdata + (ne00 + CACHE_LINE_SIZE_F32) * t + nth * 2048 + 64);
+        const int64_t cap = (ne00 + CACHE_LINE_SIZE_F32) - (nth * 2048 + 64) - (ne00 / nth + 1);   // room after a local copy
         for (int64_t i = 0; i < nr; i++) {
-            lg_top_k_row_team(params, (const float *) ((const char *) src0->data + i*nb01), ne00, top_k,
-                              (int32_t *) ((char *) dst->data + i*nb1), (uint32_t *) params->wdata,
-                              (float *) ((int32_t *) params->wdata + (ne00 + CACHE_LINE_SIZE_F32) * ith + nth * 2048 + 64));
+            const float * row = (const float *) ((const char *) src0->data + i*nb01);
+            int32_t * out = (int32_t *) ((char *) dst->data + i*nb1);
+            if (getenv("LG_TOPK_OLD") || !lg_top_k_row_team2(params, row, ne00, top_k, out, (uint32_t *) params->wdata, locals, cap)) {
+                lg_top_k_row_team(params, row, ne00, top_k, out, (uint32_t *) params->wdata, locals[ith]);
+            }
         }
         return;
     }
diff --git a/ggml/src/ggml-hexagon/htp/act-ops.c b/ggml/src/ggml-hexagon/htp/act-ops.c
index 6416d2d..5d785a7 100644
--- a/ggml/src/ggml-hexagon/htp/act-ops.c
+++ b/ggml/src/ggml-hexagon/htp/act-ops.c
@@ -621,6 +621,51 @@ static void glu_geglu_f32_per_thread(unsigned int nth, unsigned int ith, void *
          (unsigned) HAP_perf_qtimer_count_to_us(t2 - t1));
 }
 
+// LG: GEGLU for a single row (one word while talking). The general path runs it on one thread as 10 passes over
+// VTCM; here the row is split by columns over all threads and the same 10 steps run in registers in one pass (the
+// same vector ops in the same order, so results are bit-identical).
+#if __HVX_ARCH__ < 79   // same ops as hvx-arith.h's HVX_OP_MUL_F32 / HVX_OP_ADD_F32
+#define LG_MUL_F32(a, b) Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(a, b))
+#define LG_ADD_F32(a, b) Q6_Vsf_equals_Vqf32(Q6_Vqf32_vadd_VsfVsf(a, b))
+#else
+#define LG_MUL_F32(a, b) Q6_Vsf_vmpy_VsfVsf(a, b)
+#define LG_ADD_F32(a, b) Q6_Vsf_vadd_VsfVsf(a, b)
+#endif
+static void lg_geglu_cols_thread(unsigned int nth, unsigned int ith, void * data) {
+    struct htp_act_context * actx = (struct htp_act_context *) data;
+    struct htp_ops_context * octx = actx->octx;
+    const uint32_t per = actx->nc / nth, c0 = per * ith;
+    const HVX_Vector * restrict x = (const HVX_Vector *) (octx->src0_spad.data + ith * octx->src0_spad.size_per_thread);
+    const HVX_Vector * restrict g = (const HVX_Vector *) (octx->src1_spad.data + ith * octx->src1_spad.size_per_thread);
+    HVX_Vector * restrict       d = (HVX_Vector *) (octx->dst_spad.data + ith * octx->dst_spad.size_per_thread);
+    dma_queue * q = octx->ctx->dma[ith];
+
+    dma_queue_push_ddr_to_vtcm(q, dma_make_ptr((void *) x, actx->data_src0 + c0 * sizeof(float)), per * sizeof(float), per * sizeof(float), 1);
+    dma_queue_push_ddr_to_vtcm(q, dma_make_ptr((void *) g, actx->data_src1 + c0 * sizeof(float)), per * sizeof(float), per * sizeof(float), 1);
+    dma_queue_pop(q);
+    dma_queue_pop(q);
+
+    const HVX_Vector va = hvx_vec_splat_f32(GELU_COEF_A), vs = hvx_vec_splat_f32(SQRT_2_OVER_PI);
+    const HVX_Vector one = hvx_vec_splat_f32(1.0f), half = hvx_vec_splat_f32(0.5f), inf = hvx_vec_splat_f32(INFINITY);
+    #pragma unroll(4)
+    for (uint32_t i = 0; i < per / 32; i++) {
+        const HVX_Vector xv = x[i];
+        HVX_Vector r = LG_MUL_F32(xv, xv);
+        r = LG_MUL_F32(r, va);
+        r = Q6_V_vmux_QVV(Q6_Q_vcmp_eq_VwVw(inf, r), inf, LG_ADD_F32(r, one));
+        r = LG_MUL_F32(xv, r);
+        r = LG_MUL_F32(r, vs);
+        r = hvx_vec_tanh_f32(r);
+        r = Q6_V_vmux_QVV(Q6_Q_vcmp_eq_VwVw(inf, r), inf, LG_ADD_F32(r, one));
+        r = LG_MUL_F32(xv, r);
+        r = LG_MUL_F32(r, half);
+        d[i] = LG_MUL_F32(r, g[i]);
+    }
+
+    dma_queue_push_vtcm_to_ddr(q, dma_make_ptr(actx->data_dst + c0 * sizeof(float), (void *) d), per * sizeof(float), per * sizeof(float), 1);
+    dma_queue_flush(q);
+}
+
 static int execute_op_activations_f32(struct htp_ops_context * octx) {
     const struct htp_tensor * src0 = octx->src[0];
     const struct htp_tensor * src1 = octx->src[1];
@@ -761,6 +806,18 @@ static int execute_op_activations_f32(struct htp_ops_context * octx) {
     actx.data_src1 = data_src1;
     actx.data_dst  = (uint8_t *) dst->data;
 
+    const uint32_t lg_nt = octx->n_threads;
+    if (octx->op == HTP_OP_GLU_GEGLU && src0_nrows == 1 && lg_nt > 1 && actx.nc % (32 * lg_nt) == 0 &&
+        3 * lg_nt * hex_round_up(actx.nc / lg_nt * sizeof(float), 128) <= octx->ctx->vtcm_size) {
+        const size_t sz = hex_round_up(actx.nc / lg_nt * sizeof(float), 128);
+        octx->src0_spad.size_per_thread = octx->src1_spad.size_per_thread = octx->dst_spad.size_per_thread = sz;
+        octx->src0_spad.data = octx->ctx->vtcm_base;
+        octx->src1_spad.data = octx->src0_spad.data + sz * lg_nt;
+        octx->dst_spad.data  = octx->src1_spad.data + sz * lg_nt;
+        worker_pool_run_func(octx->ctx->worker_pool, lg_geglu_cols_thread, &actx, lg_nt);
+        return HTP_STATUS_OK;
+    }
+
     worker_pool_run_func(octx->ctx->worker_pool, act_op_func, &actx, n_threads);
     return HTP_STATUS_OK;
 }
diff --git a/ggml/src/ggml-hexagon/htp/flash-attn-ops.c b/ggml/src/ggml-hexagon/htp/flash-attn-ops.c
index 939a5bc..0e4e258 100644
--- a/ggml/src/ggml-hexagon/htp/flash-attn-ops.c
+++ b/ggml/src/ggml-hexagon/htp/flash-attn-ops.c
@@ -634,21 +634,47 @@ static void flash_attn_ext_f16_thread(unsigned int nth, unsigned int ith, void *
 // LG: the blocks of a mask row that have at least one key not at -inf. A block whose every key is -inf (outside the
 // sliding window, or an empty cache cell) adds exactly nothing (P = 0), so its K/V copy and math are skipped, as the
 // CPU skips such keys one by one. One mask block is one HVX vector (64 fp16); the test runs on a cached copy.
+// A live block that also holds -inf keys is marked LG_FA_PARTIAL: its masked K/V rows get zeroed in VTCM, so the value
+// sums need no per-key check (those keys have P = 0 and their rows may be stale or empty cells).
+#define LG_FA_PARTIAL 0x8000
 static uint32_t lg_fa_live_blocks(uint16_t * list, const __fp16 * mrow, uint32_t n_blocks, uint32_t nek1) {
-    uint64_t __attribute__((aligned(VLEN))) buf[VLEN / 8];
+    uint16_t __attribute__((aligned(VLEN))) h[VLEN / 2];
     uint32_t n = 0;
     for (uint32_t ib = 0; ib < n_blocks; ++ib) {
         const uint32_t bs = MIN(FLASH_ATTN_BLOCK_SIZE, nek1 - ib * FLASH_ATTN_BLOCK_SIZE);
-        *(HVX_Vector *) buf = *(const HVX_UVector *) (mrow + ib * FLASH_ATTN_BLOCK_SIZE);
-        const uint16_t * h = (const uint16_t *) buf;
-        bool live = false;
-        uint32_t i = 0;
-        for (; i + 4 <= bs && !live; i += 4) live = buf[i / 4] != 0xFC00FC00FC00FC00ull;
-        for (; i < bs && !live; ++i) live = h[i] != 0xFC00;
-        if (live) list[n++] = ib;
+        *(HVX_Vector *) h = *(const HVX_UVector *) (mrow + ib * FLASH_ATTN_BLOCK_SIZE);
+        uint32_t dead = 0;
+        for (uint32_t i = 0; i < bs; ++i) dead += h[i] == 0xFC00;
+        if (dead < bs) list[n++] = ib | (dead ? LG_FA_PARTIAL : 0);
     }
     return n;
 }
+
+static void lg_fa_zero_masked(uint8_t * k_base, uint8_t * v_base, size_t k_stride, size_t v_stride, uint32_t nk, uint32_t nv,
+                              const __fp16 * mrow, uint32_t bs) {
+    uint16_t __attribute__((aligned(VLEN))) h[VLEN / 2];
+    *(HVX_Vector *) h = *(const HVX_UVector *) mrow;
+    for (uint32_t i = 0; i < bs; ++i) {
+        if (h[i] != 0xFC00) continue;
+        HVX_Vector * kr = (HVX_Vector *) (k_base + i * k_stride);
+        HVX_Vector * vr = (HVX_Vector *) (v_base + i * v_stride);
+        for (uint32_t j = 0; j < nk; ++j) kr[j] = Q6_V_vzero();
+        for (uint32_t j = 0; j < nv; ++j) vr[j] = Q6_V_vzero();
+    }
+}
+
+// value sums for nk keys of one head, NV fp16 vectors per row (a compile-time 4 or 8 after inlining)
+static inline __attribute__((always_inline)) void lg_fa_vsum(HVX_Vector * restrict vacc, const uint8_t * restrict v_base,
+                                                            size_t stride, const __fp16 * restrict p, uint32_t nk, const uint32_t NV) {
+    for (uint32_t jj = 0; jj < nk; jj++) {
+        const HVX_Vector S = hvx_vec_splat_f16(p[jj]);
+        const HVX_Vector * restrict vrow = (const HVX_Vector *) (v_base + jj * stride);
+        #pragma unroll
+        for (uint32_t i = 0; i < NV; i++) {
+            vacc[i] = Q6_Vqf16_vadd_Vqf16Vqf16(vacc[i], Q6_Vqf16_vmpy_VhfVhf(vrow[i], S));
+        }
+    }
+}
 #ifndef LG_FA_GROUPED_OFF
 #define getenv_lg_fa_off() 0
 #else
@@ -687,6 +713,52 @@ static inline HVX_Vector lg_dot_f16_rx32_qf32(const void * restrict y, const uin
     return HVX_OP_MUL_F32(hvx_vec_splat_f32(s), sums);
 }
 
+// q . k for 32 keys, NV fp16 vectors per row (a compile-time 4 or 8 after inlining). Each key's products are summed in
+// qf32; the 32 per-key vectors are then folded in one shuffle-and-add tree (all in qf32) so lane j ends up holding key
+// j's total, instead of a 4-key reduction with float conversions between steps.
+static inline __attribute__((always_inline)) HVX_Vector lg_qf32_fold(HVX_Vector a, HVX_Vector b, int bytes) {
+    const HVX_VectorPair w = Q6_W_vshuff_VVR(b, a, bytes);
+    return Q6_Vqf32_vadd_Vqf32Vqf32(Q6_V_lo_W(w), Q6_V_hi_W(w));
+}
+static inline __attribute__((always_inline)) HVX_Vector lg_dot4_fold(const HVX_Vector * restrict y, const uint8_t * restrict x,
+                                                                    size_t stride, const uint32_t NV) {
+    const HVX_Vector * restrict x0 = (const HVX_Vector *) x;
+    const HVX_Vector * restrict x1 = (const HVX_Vector *) (x + stride);
+    const HVX_Vector * restrict x2 = (const HVX_Vector *) (x + stride * 2);
+    const HVX_Vector * restrict x3 = (const HVX_Vector *) (x + stride * 3);
+    HVX_Vector a0l = Q6_V_vzero(), a0h = Q6_V_vzero(), a1l = Q6_V_vzero(), a1h = Q6_V_vzero();
+    HVX_Vector a2l = Q6_V_vzero(), a2h = Q6_V_vzero(), a3l = Q6_V_vzero(), a3h = Q6_V_vzero();
+    #pragma unroll
+    for (uint32_t i = 0; i < NV; i++) {
+        const HVX_Vector yy = y[i];
+        HVX_VectorPair m;
+        m = Q6_Wqf32_vmpy_VhfVhf(x0[i], yy); a0l = Q6_Vqf32_vadd_Vqf32Vqf32(a0l, Q6_V_lo_W(m)); a0h = Q6_Vqf32_vadd_Vqf32Vqf32(a0h, Q6_V_hi_W(m));
+        m = Q6_Wqf32_vmpy_VhfVhf(x1[i], yy); a1l = Q6_Vqf32_vadd_Vqf32Vqf32(a1l, Q6_V_lo_W(m)); a1h = Q6_Vqf32_vadd_Vqf32Vqf32(a1h, Q6_V_hi_W(m));
+        m = Q6_Wqf32_vmpy_VhfVhf(x2[i], yy); a2l = Q6_Vqf32_vadd_Vqf32Vqf32(a2l, Q6_V_lo_W(m)); a2h = Q6_Vqf32_vadd_Vqf32Vqf32(a2h, Q6_V_hi_W(m));
+        m = Q6_Wqf32_vmpy_VhfVhf(x3[i], yy); a3l = Q6_Vqf32_vadd_Vqf32Vqf32(a3l, Q6_V_lo_W(m)); a3h = Q6_Vqf32_vadd_Vqf32Vqf32(a3h, Q6_V_hi_W(m));
+    }
