+// LG: every layer at the same position with the same rope settings builds the same cos/sin table, and below v79
+// that build is a scalar cosf/sinf loop (~20-30 us per call, each thread). Each thread keeps its last few tables in
+// cached memory and copies a hit into VTCM; a miss builds exactly as before, so the table is bit-identical.
+#define LG_ROPE_NENT  4
+#define LG_ROPE_MAXNE 512
+struct lg_rope_ent {
+    float    tab[LG_ROPE_MAXNE] __attribute__((aligned(128)));
+    int32_t  pos;
+    uint32_t ne0, age;
+    const float * ff;
+    float    ff0, ff1, fs, ts, ef, af, c0, c1;
+};
+static struct lg_rope_ent lg_rope_ents[HTP_MAX_NTHREADS][LG_ROPE_NENT];
+static uint32_t lg_rope_clock[HTP_MAX_NTHREADS];
+
+static void lg_rope_cache_init(uint32_t ith, int32_t pos, const float freq_scale, const float * freq_factors,
+                               float * corr_dims, const uint32_t ne0, const float ext_factor, const float mscale,
+                               float * cache, const float theta_scale) {
+    if (ne0 > LG_ROPE_MAXNE || ith >= HTP_MAX_NTHREADS) {
+        rope_cache_init(pos, freq_scale, freq_factors, corr_dims, ne0, ext_factor, mscale, cache, theta_scale);
+        return;
+    }
+    const float ff0 = freq_factors ? freq_factors[0] : 0.0f, ff1 = freq_factors ? freq_factors[ne0 / 2 - 1] : 0.0f;
+    struct lg_rope_ent * ents = lg_rope_ents[ith];
+    struct lg_rope_ent * e = &ents[0];
+    for (uint32_t i = 0; i < LG_ROPE_NENT; i++) {
+        struct lg_rope_ent * c = &ents[i];
+        if (c->ne0 == ne0 && c->pos == pos && c->ff == freq_factors && c->ff0 == ff0 && c->ff1 == ff1 &&
+            c->fs == freq_scale && c->ts == theta_scale && c->ef == ext_factor && c->af == mscale &&
+            c->c0 == corr_dims[0] && c->c1 == corr_dims[1]) {
+            c->age = ++lg_rope_clock[ith];
+            hvx_copy_f32_ua((uint8_t *) cache, (const uint8_t *) c->tab, ne0);
+            return;
+        }
+        if (c->age < e->age) e = c;
+    }
+    rope_cache_init(pos, freq_scale, freq_factors, corr_dims, ne0, ext_factor, mscale, e->tab, theta_scale);
+    e->pos = pos; e->ne0 = ne0; e->ff = freq_factors; e->ff0 = ff0; e->ff1 = ff1; e->fs = freq_scale;
+    e->ts = theta_scale; e->ef = ext_factor; e->af = mscale; e->c0 = corr_dims[0]; e->c1 = corr_dims[1];
+    e->age = ++lg_rope_clock[ith];
+    hvx_copy_f32_ua((uint8_t *) cache, (const uint8_t *) e->tab, ne0);
+}
