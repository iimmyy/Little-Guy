+// LG: Q3_K in the same 32-row tiles (htp/lg-q2k-ops.c, lg_op_matmul_q3k), the same bytes as the original blocks
+// (32 x 110 per super-block). Super-blocks go in pairs (7040 bytes, 55 vectors); an odd last one takes 3520:
+//   pair:   low0 0, high0 2048, low1 3072, high1 5120, sc0 6144, sc1 6528, d 6912 (lanes 0..31 first, 32..63 second)
+//   single: low 0, high 2048, sc 3072, d 3456
+//   low:  16 x 128 B, the Q2_K tile layout of the low 2 bits
+//   high:  8 x 128 B, vector v, word r, byte j: bit k = high bit of input 32v + 4k + j, bit 4 + k of input 32v + 16 + 4k + j
+//   sc:    3 x 128 B, vector v, word r = bytes 4v..4v+3 of row r's packed 6-bit scales
+// block_q3_K by byte offset: hmask at 0, qs at 32, scales at 96, d at 108. Input 16p + t of a super-block, with
+// n = p / 8, j = (p % 8) / 2, h = p % 2: low bits in qs[32n + 16h + t] at shift 2j, high bit in hmask[16h + t] bit 4n + j.
+#define LG_Q3K_SB_BYTES 3520
+
+static size_t lg_q3k_sb_off(int64_t sb, int64_t nsb, size_t * lo, size_t * hi, size_t * sc, size_t * d) {
+    const size_t base = (size_t) (sb / 2) * 2 * LG_Q3K_SB_BYTES;
+    const bool second = sb % 2, single = (sb == nsb - 1) && (nsb % 2);
+    *lo = base + (second ? 3072 : 0);
+    *hi = *lo + 2048;
+    *sc = base + (single ? 3072 : 6144 + (second ? 384 : 0));
+    *d  = base + (single ? 3456 : 6912 + (second ? 64 : 0));
+    return base;
+}
+
+static void lg_q3k_tile(uint8_t * o, const uint8_t * const * blk, int64_t sb, int64_t nsb) {
+    size_t lo, hi, sc, dd;
+    lg_q3k_sb_off(sb, nsb, &lo, &hi, &sc, &dd);
+    for (int r = 0; r < LG_Q2K_ROWS; r++) {
+        const uint8_t * b = blk[r], * hm = b, * qs = b + 32;
+        for (int p = 0; p < 16; p++) {
+            const int n = p / 8, j = (p % 8) / 2, h = p % 2;
+            for (int jj = 0; jj < 4; jj++) {
+                uint8_t vl = 0, vh = 0;
+                for (int k = 0; k < 4; k++) {
+                    const int t = 4 * k + jj;
+                    vl |= ((qs[32 * n + 16 * h + t] >> (2 * j)) & 3) << (2 * k);
+                    vh |= ((hm[16 * h + t] >> (4 * n + j)) & 1) << k;
+                }
+                o[lo + p * 128 + 4 * r + jj] = vl;
+                o[hi + (p / 2) * 128 + 4 * r + jj] |= vh << (4 * (p % 2));
+            }
+        }
+        for (int v = 0; v < 3; v++) memcpy(o + sc + v * 128 + 4 * r, b + 96 + 4 * v, 4);
+        memcpy(o + dd + 2 * r, b + 108, 2);
+    }
+}
+
+static void lg_q3k_untile(uint8_t * const * blk, const uint8_t * o, int64_t sb, int64_t nsb) {
+    size_t lo, hi, sc, dd;
+    lg_q3k_sb_off(sb, nsb, &lo, &hi, &sc, &dd);
+    for (int r = 0; r < LG_Q2K_ROWS; r++) {
+        uint8_t * b = blk[r], * hm = b, * qs = b + 32;
+        memset(b, 0, 96);
+        for (int p = 0; p < 16; p++) {
+            const int n = p / 8, j = (p % 8) / 2, h = p % 2;
+            for (int jj = 0; jj < 4; jj++) {
+                const uint8_t vl = o[lo + p * 128 + 4 * r + jj];
+                const uint8_t vh = o[hi + (p / 2) * 128 + 4 * r + jj] >> (4 * (p % 2));
+                for (int k = 0; k < 4; k++) {
+                    const int t = 4 * k + jj;
+                    qs[32 * n + 16 * h + t] |= ((vl >> (2 * k)) & 3) << (2 * j);
+                    hm[16 * h + t] |= ((vh >> k) & 1) << (4 * n + j);
+                }
+            }
+        }
+        for (int v = 0; v < 3; v++) memcpy(b + 96 + 4 * v, o + sc + v * 128 + 4 * r, 4);
+        memcpy(b + 108, o + dd + 2 * r, 2);
+    }
+}
+
+static void repack_q3_K_lgtile(ggml_tensor * t, const void * data, size_t size) {
+    const int64_t K = t->ne[0], N = ggml_nrows(t), nsb = K / QK_K;
+    GGML_ASSERT(K % QK_K == 0 && N % LG_Q2K_ROWS == 0 && size == ggml_nbytes(t));
+    const size_t row = ggml_row_size(t->type, K), tile_bytes = (size_t) nsb * LG_Q3K_SB_BYTES;
+    const uint8_t * src = (const uint8_t *) data;
+    uint8_t * dst = (uint8_t *) t->data;
+    std::vector<uint8_t> o(tile_bytes);
+    const uint8_t * blk[LG_Q2K_ROWS];
+    for (int64_t tile = 0; tile < N / LG_Q2K_ROWS; tile++) {
+        std::fill(o.begin(), o.end(), 0);
+        for (int64_t sb = 0; sb < nsb; sb++) {
+            for (int r = 0; r < LG_Q2K_ROWS; r++) blk[r] = src + (tile * LG_Q2K_ROWS + r) * row + sb * sizeof(block_q3_K);
+            lg_q3k_tile(o.data(), blk, sb, nsb);
+        }
+        memcpy(dst + tile * tile_bytes, o.data(), tile_bytes);
+    }
+}
+
+static void repack_lgtile_q3_K(void * data, const ggml_tensor * t, size_t size) {
+    const int64_t K = t->ne[0], N = ggml_nrows(t), nsb = K / QK_K;
+    GGML_ASSERT(size == ggml_nbytes(t));
+    const size_t row = ggml_row_size(t->type, K), tile_bytes = (size_t) nsb * LG_Q3K_SB_BYTES;
+    uint8_t * dst = (uint8_t *) data;
+    const uint8_t * src = (const uint8_t *) t->data;
+    uint8_t * blk[LG_Q2K_ROWS];
+    for (int64_t tile = 0; tile < N / LG_Q2K_ROWS; tile++) {
+        for (int64_t sb = 0; sb < nsb; sb++) {
+            for (int r = 0; r < LG_Q2K_ROWS; r++) blk[r] = dst + (tile * LG_Q2K_ROWS + r) * row + sb * sizeof(block_q3_K);
+            lg_q3k_untile(blk, src + tile * tile_bytes, sb, nsb);
+        }
+    }
+}
