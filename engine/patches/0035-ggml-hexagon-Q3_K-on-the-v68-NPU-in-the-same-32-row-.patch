+
+// ---------------------------------------------------------------------------------------------------------------
+// Q3_K in the same 32-row tiles (repack_q3_K_lgtile in ggml-hexagon.cpp), the same bytes as the original blocks.
+// Super-blocks go in pairs (7040 bytes); an odd last one takes 3520:
+//   pair:   low0 0, high0 2048, low1 3072, high1 5120, sc0 6144, sc1 6528, d 6912 (fp16 lanes 0..31, then 32..63)
+//   single: low 0, high 2048, sc 3072, d 3456
+//   low:  16 x 128 B in the Q2_K tile layout (vector p: inputs 16p..16p+15, word r = row r, bits 2k+1:2k of byte j
+//         = low 2 bits of input 16p + 4k + j)
+//   high:  8 x 128 B, vector v, word r, byte j: bit k = high bit of input 32v + 4k + j, bit 4 + k of 32v + 16 + 4k + j
+//   sc:    3 x 128 B, vector v, word r = bytes 4v..4v+3 of row r's packed 6-bit scales (ggml's Q3_K packing)
+// Inputs are the Q2_K kernel's q8_K (same quantization, same buffers). With codes c = low + 4 * high in 0..7, biased
+// scales s' = scale + 32 in 0..63, pouch sums b and their total B, per row and super-block
+//   sum_p (s'_p - 32) * sum_i (c_i - 4) x_i = S - 32 A - 4 M + 128 B,
+//   S = sum_p s'_p a_p,  A = sum_p a_p,  a_p = sum_i c_i x_i,  M = sum_p s'_p b_p,
+// all integer and exact, as the CPU's ggml_vec_dot_q3_K_q8_K; times d * xd in float.
+
+#define LG_Q3K_SB 3520
+
+static inline HVX_Vector lg_q3k_hbit(HVX_Vector hv, int s) {   // byte bit 2 = bit s of each byte
+    const HVX_Vector four = Q6_Vb_vsplat_R(4);
+    return s >= 2 ? Q6_V_vand_VV(Q6_Vuh_vlsr_VuhR(hv, s - 2), four) : Q6_V_vand_VV(Q6_Vh_vasl_VhR(hv, 2 - s), four);
+}
+
+static inline HVX_Vector lg_q3k_sb(const HVX_Vector * restrict lo, const HVX_Vector * restrict hi, const HVX_Vector * restrict sc,
+                                   const int32_t * restrict x4, const int32_t * restrict xsb, int32_t B) {
+    const HVX_Vector three = Q6_Vb_vsplat_R(3), m6 = Q6_V_vsplat_R(0x3f);
+    const HVX_Vector k1 = Q6_V_vsplat_R(0x03030303), k2 = Q6_V_vsplat_R(0x0f0f0f0f);
+    const HVX_Vector a0 = sc[0], a1 = sc[1], t = sc[2];
+    HVX_Vector sv[4];
+    sv[0] = Q6_V_vor_VV(Q6_V_vand_VV(a0, k2), Q6_Vw_vasl_VwR(Q6_V_vand_VV(t, k1), 4));
+    sv[1] = Q6_V_vor_VV(Q6_V_vand_VV(a1, k2), Q6_Vw_vasl_VwR(Q6_V_vand_VV(Q6_Vuw_vlsr_VuwR(t, 2), k1), 4));
+    sv[2] = Q6_V_vor_VV(Q6_V_vand_VV(Q6_Vuw_vlsr_VuwR(a0, 4), k2), Q6_Vw_vasl_VwR(Q6_V_vand_VV(Q6_Vuw_vlsr_VuwR(t, 4), k1), 4));
+    sv[3] = Q6_V_vor_VV(Q6_V_vand_VV(Q6_Vuw_vlsr_VuwR(a1, 4), k2), Q6_Vw_vasl_VwR(Q6_V_vand_VV(Q6_Vuw_vlsr_VuwR(t, 6), k1), 4));
+    HVX_Vector S = Q6_V_vzero(), A = Q6_V_vzero(), Ml = Q6_V_vzero(), Mh = Q6_V_vzero();
+    #pragma unroll(4)
+    for (int q4 = 0; q4 < 4; q4++) {
+        const HVX_Vector svq = sv[q4];                                 // byte i: s' of pouch 4 * q4 + i
+        Ml = Q6_Vuw_vrmpyacc_VuwVubRub(Ml, svq, xsb[q4]);
+        Mh = Q6_Vw_vrmpyacc_VwVubRb(Mh, svq, xsb[4 + q4]);
+        #pragma unroll(4)
+        for (int i = 0; i < 4; i++) {
+            const int p = 4 * q4 + i, hs = 4 * (p % 2);
+            const HVX_Vector pk = lo[p], hv = hi[p / 2];
+            const int32_t * xb = x4 + 4 * p;
+            HVX_Vector a = Q6_Vw_vrmpy_VubRb(Q6_V_vor_VV(Q6_V_vand_VV(pk, three), lg_q3k_hbit(hv, hs)), xb[0]);
+            a = Q6_Vw_vrmpyacc_VwVubRb(a, Q6_V_vor_VV(Q6_V_vand_VV(Q6_Vuh_vlsr_VuhR(pk, 2), three), lg_q3k_hbit(hv, hs + 1)), xb[1]);
+            a = Q6_Vw_vrmpyacc_VwVubRb(a, Q6_V_vor_VV(Q6_V_vand_VV(Q6_Vuh_vlsr_VuhR(pk, 4), three), lg_q3k_hbit(hv, hs + 2)), xb[2]);
+            a = Q6_Vw_vrmpyacc_VwVubRb(a, Q6_V_vor_VV(Q6_V_vand_VV(Q6_Vuh_vlsr_VuhR(pk, 6), three), lg_q3k_hbit(hv, hs + 3)), xb[3]);
+            A = Q6_Vw_vadd_VwVw(A, a);
+            S = Q6_Vw_vadd_VwVw(S, Q6_Vw_vmpyie_VwVuh(a, Q6_V_vand_VV(Q6_Vuw_vlsr_VuwR(svq, 8 * i), m6)));
+        }
+    }
+    const HVX_Vector M = Q6_Vw_vadd_VwVw(Q6_Vw_vasl_VwR(Mh, 8), Ml);
+    HVX_Vector T = Q6_Vw_vsub_VwVw(S, Q6_Vw_vasl_VwR(A, 5));
+    T = Q6_Vw_vsub_VwVw(T, Q6_Vw_vasl_VwR(M, 2));
+    return Q6_Vw_vadd_VwVw(T, Q6_V_vsplat_R(128 * B));
+}
+
+static inline int32_t lg_q3k_total(const int32_t * xsb) {   // B = sum of the 16 pouch sums (low bytes + 256 * high bytes)
+    const uint8_t * l = (const uint8_t *) xsb;
+    const int8_t  * h = (const int8_t *) (xsb + 4);
+    int32_t B = 0;
+    for (int g = 0; g < 16; g++) B += (int32_t) l[g] + 256 * (int32_t) h[g];
+    return B;
+}
+
+#define LG_Q3K_MAXSB 128
+static int32_t lg_q3k_B[HTP_MAX_NTHREADS][LG_Q3K_MAXSB];
+
+static void lg_q3k_mv_job(unsigned int nth, unsigned int ith, void * data) {
+    struct lg_q2k * c = (struct lg_q2k *) data;
+    const uint32_t per = (c->ntiles + nth - 1) / nth;
+    const uint32_t t0 = MIN(per * ith, c->ntiles), t1 = MIN(t0 + per, c->ntiles);
+    const size_t stride = hex_round_up(c->tile_bytes, 128);
+
+    dma_queue * q = c->ctx->dma[ith];
+    uint8_t * buf0 = c->wbuf + (size_t) ith * LG_NBUF * stride;
+    const uint8_t * w = (const uint8_t *) c->src0->data;
+
+    uint32_t s0 = 0, s1 = 0;
+    float * xin = NULL;
+    if (c->fuse) {
+        const uint32_t ps = (c->nsb + nth - 1) / nth;
+        s0 = MIN(ps * ith, c->nsb); s1 = MIN(s0 + ps, c->nsb);
+        xin = (float *) (c->xin + (size_t) ith * c->K * sizeof(float));
+        if (s0 < s1) {
+            const size_t nb = (size_t) (s1 - s0) * LG_SB_INPUTS * sizeof(float);
+            dma_queue_push_ddr_to_vtcm(q, dma_make_ptr(xin, (const float *) c->src1->data + (size_t) s0 * LG_SB_INPUTS), nb, nb, 1);
+        }
+    }
+    for (uint32_t t = t0; t < MIN(t0 + LG_NBUF - 1, t1); t++) {
+        dma_queue_push_ddr_to_vtcm(q, dma_make_ptr(buf0 + ((t - t0) % LG_NBUF) * stride, w + (size_t) t * c->tile_bytes),
+                                   c->tile_bytes, c->tile_bytes, 1);
+    }
+    if (c->fuse) {
+        if (s0 < s1) {
+            dma_queue_pop(q);
+            float * tmp = c->xtmp + (size_t) ith * 2 * LG_SB_INPUTS;
+            for (uint32_t s = s0; s < s1; s++) {
+                for (int v = 0; v < LG_SB_INPUTS * 4 / 128; v++) {
+                    ((HVX_Vector *) tmp)[v] = ((const HVX_Vector *) (xin + (size_t) (s - s0) * LG_SB_INPUTS))[v];
+                }
+                lg_q2k_quant_sb(tmp, c->xq + (size_t) s * LG_SB_INPUTS, c->xsum + (size_t) s * 8, c->xd + s, (int32_t *) (tmp + LG_SB_INPUTS));
+            }
+        }
+        __atomic_fetch_add(&c->qdone, 1, __ATOMIC_RELEASE);
+        while (__atomic_load_n(&c->qdone, __ATOMIC_ACQUIRE) < nth) { hex_pause(); }
+    }
+    if (t0 >= t1) return;
+
+    int32_t * Bone = lg_q3k_B[ith];   // one column: the totals once per job instead of once per tile
+    if (c->ncols == 1) {
+        for (uint32_t s = 0; s < c->nsb; s++) Bone[s] = lg_q3k_total(c->xsum + (size_t) s * 8);
+    }
+    for (uint32_t t = t0; t < t1; t++) {
+        const uint8_t * tile = (const uint8_t *) dma_queue_pop(q).dst;
+        const uint32_t tn = t + LG_NBUF - 1;
+        if (tn < t1) {
+            dma_queue_push_ddr_to_vtcm(q, dma_make_ptr(buf0 + ((tn - t0) % LG_NBUF) * stride, w + (size_t) tn * c->tile_bytes),
+                                       c->tile_bytes, c->tile_bytes, 1);
+        }
+        for (uint32_t col = 0; col < c->ncols; col++) {
+            const int32_t * x4 = (const int32_t *) (c->xq + (size_t) col * c->K);
+            const int32_t * xs = c->xsum + (size_t) col * (c->nsb * 8);
+            const float   * xd = c->xd + (size_t) col * c->nsb;
+            HVX_Vector acc = Q6_V_vzero();
+            for (uint32_t s = 0; s < c->nsb; s++) {
+                const size_t base = (size_t) (s / 2) * 2 * LG_Q3K_SB;
+                const bool second = s % 2, single = (s == c->nsb - 1) && (c->nsb % 2);
+                const uint8_t * lo = tile + base + (second ? 3072 : 0);
+                const uint8_t * sc = tile + base + (single ? 3072 : 6144 + (second ? 384 : 0));
+                const uint8_t * dv = tile + base + (single ? 3456 : 6912);
+                const int32_t B = c->ncols == 1 ? Bone[s] : lg_q3k_total(xs + s * 8);
+                const HVX_Vector T = lg_q3k_sb((const HVX_Vector *) lo, (const HVX_Vector *) (lo + 2048), (const HVX_Vector *) sc,
+                                               x4 + s * (LG_SB_INPUTS / 4), xs + s * 8, B);
+                const HVX_VectorPair dd = hvx_vec_f16_to_f32(*(const HVX_Vector *) dv);
+                const HVX_Vector d = second ? Q6_V_hi_W(dd) : Q6_V_lo_W(dd);
+                const HVX_Vector a = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(Q6_Vsf_equals_Vw(T), d));
+                acc = Q6_Vqf32_vadd_Vqf32Vqf32(acc, Q6_Vqf32_vmpy_VsfVsf(a, hvx_vec_splat_f32(xd[s])));
+            }
+            float * y = (float *) ((uint8_t *) c->dst->data + (size_t) (c->col0 + col) * c->dst->nb[1]) + (size_t) t * LG_TILE_ROWS;
+            *(HVX_UVector *) y = Q6_Vsf_equals_Vqf32(acc);
+        }
+    }
+}
+
+int lg_op_matmul_q3k(struct htp_ops_context * octx) {
+    const struct htp_tensor * src0 = octx->src[0];
+    const struct htp_tensor * src1 = octx->src[1];
+    const struct htp_tensor * dst  = octx->dst;
+
+    struct lg_q2k c;
+    memset(&c, 0, sizeof(c));
+    c.src0 = src0; c.src1 = src1; c.dst = dst; c.ctx = octx->ctx;
+    c.K = src0->ne[0];
+    c.N = src0->ne[1];
+    if (c.K % LG_SB_INPUTS || c.N % LG_TILE_ROWS || src1->type != HTP_TYPE_F32 || src1->ne[2] != 1 || src1->ne[3] != 1 ||
+        c.K / LG_SB_INPUTS > LG_Q3K_MAXSB) {
+        return HTP_STATUS_NO_SUPPORT;
+    }
+    c.nsb        = c.K / LG_SB_INPUTS;
+    c.ntiles     = c.N / LG_TILE_ROWS;
+    c.tile_bytes = (size_t) c.nsb * LG_Q3K_SB;
+    c.n_jobs     = octx->n_threads;
+
+    // VTCM: per thread LG_NBUF tile buffers, each rounded up to 128 bytes (an odd super-block count leaves a
+    // half vector, and the last d vector is read whole)
+    const size_t wbytes   = hex_round_up(LG_NBUF * hex_round_up(c.tile_bytes, 128) * c.n_jobs, 128) + 128;
+    const size_t col_size = hex_round_up(c.K, 128) + hex_round_up(c.K / 16 * 4, 128) + hex_round_up(c.nsb * 4, 128);
+    if (octx->ctx->vtcm_size < wbytes || c.n_jobs > HTP_MAX_NTHREADS || col_size > LG_XBUF) {
+        return HTP_STATUS_VTCM_TOO_SMALL;
+    }
+    if (octx->flags & HTP_OPFLAGS_SKIP_COMPUTE) {
+        return HTP_STATUS_OK;
+    }
+    if (!lg_xbuf && !(lg_xbuf = memalign(128, LG_XBUF))) return HTP_STATUS_INTERNAL_ERR;
+    if (!lg_tbuf && !(lg_tbuf = memalign(128, HTP_MAX_NTHREADS * 2 * LG_SB_INPUTS * 4))) return HTP_STATUS_INTERNAL_ERR;
+    uint8_t * xbuf = lg_xbuf, * tbuf = lg_tbuf;
+    const uint32_t max_cols = MIN(LG_XBUF / col_size, LG_STAGE_MAXC);
+    const uint32_t ncols    = src1->ne[1];
+    c.wbuf = octx->ctx->vtcm_base;
+    c.xtmp = (float *) tbuf;
+
+    for (uint32_t col0 = 0; col0 < ncols; col0 += max_cols) {
+        c.col0  = col0;
+        c.ncols = MIN(max_cols, ncols - col0);
+        uint8_t * p = xbuf;
+        c.xq   = (int8_t *) p;  p += hex_round_up((size_t) c.ncols * c.K, 128);
+        c.xsum = (int32_t *) p; p += hex_round_up((size_t) c.ncols * (c.K / 16) * 4, 128);
+        c.xd   = (float *) p;
+
+        // the same q8_K inputs as Q2_K: share its cache (gate and up, q/k/v)
+        const bool cached = (ncols <= max_cols && lg_q2k_xcache_src == src1->data && lg_q2k_xcache_ncols == ncols);
+        c.fuse = 0;
+        if (octx->src[2]) {
+            lg_copy_prequant(octx->src[2], c.K, ncols, c.nsb * 8, c.nsb, col0, c.ncols, c.xq, c.xsum, c.xd);
+            lg_q2k_xcache_src = lg_q4_xcache_src = 0;
+        } else if (!cached && ncols == 1 && !getenv_lg_nofuse() && wbytes + (size_t) c.n_jobs * c.K * sizeof(float) <= octx->ctx->vtcm_size) {
+            c.fuse  = 1;
+            c.xin   = octx->ctx->vtcm_base + wbytes;
+            c.qdone = 0;
+            lg_q2k_xcache_src   = src1->data;
+            lg_q2k_xcache_ncols = 1;
+            lg_q4_xcache_src    = 0;
+        } else if (!cached) {
+            worker_pool_run_func(octx->ctx->worker_pool, lg_q2k_quant_job, &c, MIN(c.n_jobs, c.ncols * c.nsb));
+            lg_q2k_xcache_src   = (ncols <= max_cols) ? src1->data : 0;
+            lg_q2k_xcache_ncols = ncols;
+            lg_q4_xcache_src    = 0;
+        }
+        worker_pool_run_func(octx->ctx->worker_pool, lg_q3k_mv_job, &c, c.n_jobs);
+    }
+
+    octx->src1_spad.src = NULL;
+    return HTP_STATUS_OK;
+}
