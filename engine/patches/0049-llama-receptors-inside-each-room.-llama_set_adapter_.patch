 llm_graph_result * llama_context::process_ubatch(const llama_ubatch & ubatch, llm_graph_type gtype, llama_memory_context_i * mctx, ggml_status & ret) {
     if (mctx && !mctx->apply()) {
         LLAMA_LOG_ERROR("%s: failed to apply memory context\n", __func__);
@@ -1315,8 +1326,13 @@ llm_graph_result * llama_context::process_ubatch(const llama_ubatch & ubatch, ll
     // in order to correctly reuse a graph, it's full topology has to be uniquely determined by these parameters
     const auto gparams = graph_params(res, ubatch, mctx, gtype);
 
+    // LG: LG_DECODE_TIMING=1 prints, per ubatch, whether the graph was reused and the time of each phase
+    static const bool lg_timing = getenv("LG_DECODE_TIMING") != nullptr;
+    const int64_t lg_t0 = lg_timing ? ggml_time_us() : 0;
+    bool lg_reused = false;
     if (!graph_reuse_disable && res->can_reuse(gparams)) {
         //LLAMA_LOG_DEBUG("%s: reusing previous graph\n", __func__);
+        lg_reused = true;
 
         // with pipeline parallelism, the previous graph_compute_async may still be running
         // on the GPU. we must synchronize before set_inputs to avoid overwriting input tensors
@@ -1361,12 +1377,18 @@ llm_graph_result * llama_context::process_ubatch(const llama_ubatch & ubatch, ll
         //LLAMA_LOG_INFO("graph set inputs time: %.3f ms\n", (ggml_time_us() - t_start_us)/1000.0);
     }
 
+    const int64_t lg_t2 = lg_timing ? ggml_time_us() : 0;
     const auto status = graph_compute(res->get_gf(), ubatch.n_tokens > 1);
     if (status != GGML_STATUS_SUCCESS) {
         LLAMA_LOG_ERROR("%s: failed to compute graph, compute status: %d\n", __func__, status);
         ret = status;
         return nullptr;
     }
+    if (lg_timing) {
+        LLAMA_LOG_INFO("lg-decode: %d tokens, %d outputs, graph %s, plan+inputs %.2f ms, compute call %.2f ms\n",
+                       (int) ubatch.n_tokens, (int) n_outputs, lg_reused ? "reused" : "REBUILT",
+                       (lg_t2 - lg_t0) / 1000.0, (ggml_time_us() - lg_t2) / 1000.0);
+    }
 
     ret = GGML_STATUS_SUCCESS;
 
@@ -2408,6 +2430,7 @@ llm_graph_params llama_context::graph_params(
         /*.sched       =*/ sched.get(),
         /*.backend_cpu =*/ backend_cpu,
         /*.cvec        =*/ cvec.get(),
+        /*.recep       =*/ recep.get(),
         /*.loras       =*/ loras.get(),
         /*.mctx        =*/ mctx,
         /*.cross       =*/ &cross,
@@ -3820,6 +3843,15 @@ int32_t llama_set_adapter_cvec(
     return res ? 0 : -1;
 }
 
