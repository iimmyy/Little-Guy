+//
+// llama_adapter_recep
+//
+
+// per-layer multipliers set at run time: attention sharpness, FFN gate gain, layer output gain
+enum llama_recep_term {
+    LLAMA_RECEP_FOCUS  = 0,
+    LLAMA_RECEP_EXCITE = 1,
+    LLAMA_RECEP_LOUD   = 2,
+    LLAMA_RECEP_COUNT  = 3,
+};
+
+struct llama_adapter_recep {
+    // a view of one multiplier, nullptr when no multipliers are set
+    ggml_tensor * term_for(ggml_context * ctx, int il, llama_recep_term term) const;
+
+    ggml_tensor * apply_to(ggml_context * ctx, ggml_tensor * cur, int il, llama_recep_term term) const;
+
+    // data: n_layer x LLAMA_RECEP_COUNT floats, or nullptr to disable
+    bool apply(const llama_model & model, const float * data, size_t len);
+
+private:
+    bool init(const llama_model & model);
+
+    bool active = false;
+
+    std::vector<ggml_context_ptr> ctxs;
+    std::vector<ggml_backend_buffer_ptr> bufs;
+
+    std::vector<ggml_tensor *> tensors; // per layer, LLAMA_RECEP_COUNT values each
+};
+
+using llama_adapter_recep_ptr = std::shared_ptr<llama_adapter_recep>;
+
