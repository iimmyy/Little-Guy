             }
         }
         if (best >= start) continue;   // the reference result was already the closest
@@ -1253,9 +1321,9 @@ size_t quantize_q2_K(const float * GGML_RESTRICT src, void * GGML_RESTRICT dst,
     size_t row_size = ggml_row_size(GGML_TYPE_Q2_K, n_per_row);
     if (!quant_weights) {
         static int careful = -1;
