     add_subdirectory(gguf-hash)
     add_subdirectory(gguf)
diff --git a/examples/lg-fingerprint/CMakeLists.txt b/examples/lg-fingerprint/CMakeLists.txt
new file mode 100644
index 0000000..b8dbfa0
--- /dev/null
+++ b/examples/lg-fingerprint/CMakeLists.txt
@@ -0,0 +1,5 @@
+set(TARGET llama-lg-fingerprint)
+add_executable(${TARGET} lg-fingerprint.cpp)
+install(TARGETS ${TARGET} RUNTIME)
+target_link_libraries(${TARGET} PRIVATE llama-common llama ${CMAKE_THREAD_LIBS_INIT})
+target_compile_features(${TARGET} PRIVATE cxx_std_17)
diff --git a/examples/lg-fingerprint/lg-fingerprint.cpp b/examples/lg-fingerprint/lg-fingerprint.cpp
new file mode 100644
index 0000000..07187be
--- /dev/null
+++ b/examples/lg-fingerprint/lg-fingerprint.cpp
@@ -0,0 +1,95 @@
+// LG: fingerprint every operation's output, for finding where two runs of the same input stop being identical.
+// Reads the prompt (-p), then picks -n words greedily; for every graph node whose name matches LG_FP_MATCH (a regex,
+// default: all) it writes "step node-index name op hash sum" to LG_FP_OUT (hash = FNV-1a of the exact output bytes,
+// sum = sum of the values for f32 outputs, to see how far apart two runs are), and "step pick <token>" per word.
+// Reading every node forces the backend to stop after each one, which changes timing; a narrower LG_FP_MATCH keeps
+// most of the graph in one piece.
+#include "arg.h"
+#include "common.h"
+#include "log.h"
+#include "llama.h"
+#include "ggml-backend.h"
+
+#include <clocale>
+#include <cstdio>
+#include <cstdlib>
+#include <regex>
+#include <string>
+#include <vector>
+
+struct fp_state {
+    FILE *     out  = nullptr;
+    std::regex match{".*"};
+    int        step = 0;
+    int        node = 0;
+    std::vector<uint8_t> buf;
+};
+
+static bool fp_cb(struct ggml_tensor * t, bool ask, void * user_data) {
+    auto * s = (fp_state *) user_data;
+    if (ask) {
+        return std::regex_search(t->name, s->match);
+    }
+    const size_t n = ggml_nbytes(t);
+    s->buf.resize(n);
+    ggml_backend_tensor_get(t, s->buf.data(), 0, n);
+    uint64_t h = 1469598103934665603ULL;
+    for (size_t i = 0; i < n; i++) { h ^= s->buf[i]; h *= 1099511628211ULL; }
+    double sum = 0.0;
+    if (t->type == GGML_TYPE_F32 && ggml_is_contiguous(t)) {
+        const float * f = (const float *) s->buf.data();
+        for (size_t i = 0; i < n / 4; i++) sum += f[i];
+    }
+    fprintf(s->out, "%d %d %s %s %016llx %.9g\n", s->step, s->node++, t->name, ggml_op_desc(t), (unsigned long long) h, sum);
+    return true;
+}
+
+int main(int argc, char ** argv) {
+    std::setlocale(LC_NUMERIC, "C");
+    fp_state st;
+    common_params params;
+    common_init();
+    if (!common_params_parse(argc, argv, params, LLAMA_EXAMPLE_COMMON)) {
+        return 1;
+    }
+    const char * out = getenv("LG_FP_OUT");
+    st.out = fopen(out ? out : "fingerprint.txt", "w");
+    if (!st.out) { LOG_ERR("cannot open LG_FP_OUT\n"); return 1; }
+    if (const char * m = getenv("LG_FP_MATCH")) st.match = std::regex(m);
+
+    llama_backend_init();
+    llama_numa_init(params.numa);
+    params.cb_eval = fp_cb;
+    params.cb_eval_user_data = &st;
+    params.warmup = false;
+
+    auto init = common_init_from_params(params);
+    llama_context * ctx = init->context();
+    if (!ctx) { LOG_ERR("failed to init\n"); return 1; }
+    const llama_vocab * vocab = llama_model_get_vocab(llama_get_model(ctx));
+    const int n_vocab = llama_vocab_n_tokens(vocab);
+
+    std::vector<llama_token> toks = common_tokenize(ctx, params.prompt, llama_vocab_get_add_bos(vocab), true);
+    llama_batch batch = llama_batch_get_one(toks.data(), toks.size());
+    const int n_gen = params.n_predict > 0 ? params.n_predict : 20;
+    std::string text;
+    for (int i = 0; i <= n_gen; i++) {
+        st.node = 0;
+        if (llama_decode(ctx, batch)) { LOG_ERR("decode failed\n"); return 1; }
+        const float * logits = llama_get_logits_ith(ctx, -1);
+        llama_token best = 0;
+        for (int v = 1; v < n_vocab; v++) if (logits[v] > logits[best]) best = v;
+        uint64_t lh = 1469598103934665603ULL;   // the word scores themselves: any difference inside shows here
+        const uint8_t * lb = (const uint8_t *) logits;
+        for (size_t k = 0; k < (size_t) n_vocab * sizeof(float); k++) { lh ^= lb[k]; lh *= 1099511628211ULL; }
+        fprintf(st.out, "%d pick %d scores %016llx\n", st.step, best, (unsigned long long) lh);
+        text += common_token_to_piece(ctx, best);
+        st.step++;
+        static llama_token cur; cur = best;
+        batch = llama_batch_get_one(&cur, 1);
+    }
+    fclose(st.out);
+    LOG_INF("\nreply: %s\n", text.c_str());
+    llama_backend_free();
+    return 0;
+}
diff --git a/ggml/src/ggml-hexagon/htp/main.c b/ggml/src/ggml-hexagon/htp/main.c
index 8c7f2a8..6b54f35 100644
--- a/ggml/src/ggml-hexagon/htp/main.c
+++ b/ggml/src/ggml-hexagon/htp/main.c
@@ -937,6 +937,16 @@ static void htp_packet_callback(dspqueue_t queue, int error, void * context) {
                 dspqueue_write_early_wakeup_noblock(queue, 0, 0);
             }
 
+            // LG: drop the whole data cache before every attention op. Without it, fresh runs of the same input differ
+            // (2026-10-17: same prompt, temperature 0, different word scores within 1-5 words; per-op fingerprints
+            // identical with <= 8 ops per batch, differing at a moving spot with 16+). A full clean+invalidate before
+            // FLASH_ATTN_EXT (42 per word) makes runs identical on the chat server (6/6 replies, with and without the
+            // drafter); "save only" (no invalidate) does not, so some op reads a stale cached copy of memory written
+            // behind the cache. Clearing before ROPE or RMS_NORM also cures it, before SET_ROWS does not; once per batch
+            // does not. Broad fix, costs ~4% (decode 7.60 -> 7.27); the stale reader is still to be named.
+            if (ops[i].opcode == HTP_OP_FLASH_ATTN_EXT) {
+                qurt_mem_cache_clean((qurt_addr_t) 0, 0, QURT_MEM_CACHE_FLUSH_INVALIDATE_ALL, QURT_MEM_DCACHE);
+            }
             profile_start(ctx->profiler, &prof);
 
             const int st = proc_op_req(octx, tens, i, &ops[i]);
-- 
