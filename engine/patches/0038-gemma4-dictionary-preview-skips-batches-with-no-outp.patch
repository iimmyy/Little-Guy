From 411aa350261255c2c1883347164faa6482e9d603 Mon Sep 17 00:00:00 2001
From: iimmyy <i.a.martins001@gmail.com>
Date: Fri, 16 Oct 2026 21:04:23 -0700
Subject: [PATCH 38/41] gemma4: dictionary preview skips batches with no
 outputs (zero-row shortlist shapes divided by zero in ggml_mul_mat on CUDA;
 the plain lm_head path handles zero rows)

---
 src/models/gemma4.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/models/gemma4.cpp b/src/models/gemma4.cpp
index adefbc2..2da57b5 100644
--- a/src/models/gemma4.cpp
+++ b/src/models/gemma4.cpp
@@ -440,7 +440,9 @@ llama_model_gemma4::graph::graph(const llama_model & model, const llm_graph_para
         return (int64_t) (e ? atoi(e) : 1024);
     }();
     const int64_t n_vocab_out = model.output->ne[1];
-    const bool use_preview = model.tok_embd_preview && !model.output_s && n_shortlist > 0 && n_shortlist < n_vocab_out;
+    // a batch with no outputs (prompt chunks whose words are not scored) has nothing to shortlist; its zero-row
+    // shapes would divide by zero in ggml_mul_mat's broadcast check, and the plain path handles zero rows
+    const bool use_preview = model.tok_embd_preview && !model.output_s && n_shortlist > 0 && n_shortlist < n_vocab_out && cur->ne[1] > 0;
 
     auto softcap = [&](ggml_tensor * x) {
         if (hparams.f_final_logit_softcapping) {
