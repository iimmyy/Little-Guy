-                            v->ne[0] % 64 == 0 && v->ne[0] <= 64 * LG_FA_MAXV && k->ne[0] % 64 == 0;
+                            v->ne[0] % 64 == 0 && v->ne[0] <= 64 * LG_FA_MAXV && k->ne[0] % 64 == 0 &&
+                            factx.n_blocks <= LG_FA_MAXB;
     if (lg_grouped) {
         size_q_block *= lg_g;
         size_vkq_acc *= lg_g;
