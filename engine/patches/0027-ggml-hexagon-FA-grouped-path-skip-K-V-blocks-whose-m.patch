From 4737ab83f65251bbbeecc52e8ddc8d3350d592b7 Mon Sep 17 00:00:00 2001
From: iimmyy <i.a.martins001@gmail.com>
Date: Wed, 14 Oct 2026 02:03:02 -0700
Subject: [PATCH 27/33] ggml-hexagon FA (grouped path): skip K/V blocks whose
 mask is -inf for every key (outside the sliding window or empty cells), as
 the CPU skips such keys; 2176/2176 FA tests pass; talking d768 9.04 ->
 9.1-9.4, d1800 8.55 -> 8.8-9.1 tok/s (CPU 8.9 / 8.5-8.6)

---
 ggml/src/ggml-hexagon/htp/flash-attn-ops.c | 38 +++++++++++++++++++---
 1 file changed, 33 insertions(+), 5 deletions(-)

diff --git a/ggml/src/ggml-hexagon/htp/flash-attn-ops.c b/ggml/src/ggml-hexagon/htp/flash-attn-ops.c
index 9b5407b..939a5bc 100644
--- a/ggml/src/ggml-hexagon/htp/flash-attn-ops.c
+++ b/ggml/src/ggml-hexagon/htp/flash-attn-ops.c
@@ -629,6 +629,26 @@ static void flash_attn_ext_f16_thread(unsigned int nth, unsigned int ith, void *
 // and there are no sinks; otherwise the original runs.
 #define LG_FA_MAXG 8
 #define LG_FA_MAXV 8   // value rows up to 8 fp16 vectors (512 dims), a multiple of 64 dims
+#define LG_FA_MAXB 512 // blocks per row the skip list holds (32768 keys)
+
+// LG: the blocks of a mask row that have at least one key not at -inf. A block whose every key is -inf (outside the
+// sliding window, or an empty cache cell) adds exactly nothing (P = 0), so its K/V copy and math are skipped, as the
+// CPU skips such keys one by one. One mask block is one HVX vector (64 fp16); the test runs on a cached copy.
+static uint32_t lg_fa_live_blocks(uint16_t * list, const __fp16 * mrow, uint32_t n_blocks, uint32_t nek1) {
+    uint64_t __attribute__((aligned(VLEN))) buf[VLEN / 8];
+    uint32_t n = 0;
+    for (uint32_t ib = 0; ib < n_blocks; ++ib) {
+        const uint32_t bs = MIN(FLASH_ATTN_BLOCK_SIZE, nek1 - ib * FLASH_ATTN_BLOCK_SIZE);
+        *(HVX_Vector *) buf = *(const HVX_UVector *) (mrow + ib * FLASH_ATTN_BLOCK_SIZE);
+        const uint16_t * h = (const uint16_t *) buf;
+        bool live = false;
+        uint32_t i = 0;
+        for (; i + 4 <= bs && !live; i += 4) live = buf[i / 4] != 0xFC00FC00FC00FC00ull;
+        for (; i < bs && !live; ++i) live = h[i] != 0xFC00;
+        if (live) list[n++] = ib;
+    }
+    return n;
+}
 #ifndef LG_FA_GROUPED_OFF
 #define getenv_lg_fa_off() 0
 #else
@@ -721,12 +741,18 @@ static void lg_flash_attn_grouped_thread(unsigned int nth, unsigned int ith, voi
         }
 
         const __fp16 * mp_base = NULL;
+        uint16_t blist[LG_FA_MAXB];
+        uint32_t nbl = factx->n_blocks;
         if (mask) {
             const uint32_t im3 = fastmodulo(iq3, mask->ne[3], &factx->src3_div3);
             mp_base = (const __fp16 *) ((const uint8_t *) mask->data + iq1*mask->nb[1] + im3*mask->nb[3]);
+            nbl = lg_fa_live_blocks(blist, mp_base, factx->n_blocks, nek1);
+        } else {
+            for (uint32_t ib = 0; ib < nbl; ++ib) blist[ib] = ib;
         }
 
-        for (uint32_t ib = 0; ib < MIN(factx->n_blocks, 2); ++ib) {
+        for (uint32_t bi = 0; bi < MIN(nbl, 2); ++bi) {
+            const uint32_t ib = blist[bi];
             const uint32_t ic_start = ib * FLASH_ATTN_BLOCK_SIZE;
             const uint32_t bs = MIN(FLASH_ATTN_BLOCK_SIZE, nek1 - ic_start);
             const uint8_t * k_src = (const uint8_t *) k->data + (ic_start*nbk1 + ik2*nbk2 + ik3*nbk3);
@@ -750,7 +776,8 @@ static void lg_flash_attn_grouped_thread(unsigned int nth, unsigned int ith, voi
             }
         }
 
-        for (uint32_t ib = 0; ib < factx->n_blocks; ++ib) {
+        for (uint32_t bi = 0; bi < nbl; ++bi) {
+            const uint32_t ib = blist[bi];
             const uint32_t ic_start = ib * FLASH_ATTN_BLOCK_SIZE;
             const uint32_t bs = MIN(FLASH_ATTN_BLOCK_SIZE, nek1 - ic_start);
             uint8_t * k_base = dma_queue_pop(dma).dst;
@@ -842,8 +869,8 @@ static void lg_flash_attn_grouped_thread(unsigned int nth, unsigned int ith, voi
                 S_vec[j] = HVX_OP_ADD_F32(HVX_OP_MUL_F32(S_vec[j], ms_vec), p_sum_vec);
             }
 
-            if (ib + 2 < factx->n_blocks) {
-                const uint32_t next_ic_start = (ib + 2) * FLASH_ATTN_BLOCK_SIZE;
+            if (bi + 2 < nbl) {
+                const uint32_t next_ic_start = blist[bi + 2] * FLASH_ATTN_BLOCK_SIZE;
                 const uint32_t nbs = MIN(FLASH_ATTN_BLOCK_SIZE, nek1 - next_ic_start);
                 const uint8_t * k_src = (const uint8_t *) k->data + (next_ic_start*nbk1 + ik2*nbk2 + ik3*nbk3);
                 dma_queue_push(dma, dma_make_ptr(k_base, k_src), factx->size_k_row_padded, nbk1, size_k_row, nbs);
@@ -965,7 +992,8 @@ int op_flash_attn_ext(struct htp_ops_context * octx) {
     const uint32_t lg_g = q->ne[2] / k->ne[2];
     const bool lg_grouped = !getenv_lg_fa_off() && k->ne[2] * lg_g == q->ne[2] && lg_g > 1 && lg_g <= LG_FA_MAXG &&
