From 01d31d0f1b513782c8c8d82a8948ccb389d0cf76 Mon Sep 17 00:00:00 2001
From: iimmyy <i.a.martins001@gmail.com>
Date: Wed, 14 Oct 2026 07:03:41 -0700
Subject: [PATCH 30/35] Memory: with the dictionary preview on, Gemma 4's tied
 output matrix shares tok_embd's mapped copy instead of a second repacked one
 (-525 MiB pinned; LG_DICT_PREVIEW=0 keeps the repacked copy). The per-layer
 token table's pages are released after load (MADV_PAGEOUT) and come in per
 row on use (LG_PLE_LAZY=0 keeps them). E4B mix-21 pinned RAM: CPU 2.57 ->
 2.08 GB, NPU 2.74 -> 2.23, NPU+coop 4.19 -> 3.66; RSS -2.4 to -2.7 GB;
 talking speed unchanged

---
 src/llama-model.cpp   | 29 +++++++++++++++++++++++++++++
 src/models/gemma4.cpp | 19 +++++++++++++------
 2 files changed, 42 insertions(+), 6 deletions(-)

diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index d041a9c..88bed1f 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -24,6 +24,10 @@
 #include <cassert>
 #include <cfloat>
 #include <cstdint>
+#if defined(__linux__)
+#include <sys/mman.h>
+#include <unistd.h>
+#endif
 #include <cstring>
 #include <cmath>
 #include <functional>
@@ -1615,6 +1619,31 @@ bool llama_model_base::load_tensors(llama_model_loader & ml) {
         for (auto & mapping : ml.mappings) {
             pimpl->mappings.emplace_back(std::move(mapping));
         }
+#if defined(__linux__)
+        // LG: the per-layer token table (Gemma 3n/4, 2.2 GB on E4B) is read one row per token, but the mapping was
+        // populated whole at load. Hand its pages back; a row comes in from the file the first time its token is
+        // seen. LG_PLE_LAZY=0 keeps it resident.
+        const char * e = getenv("LG_PLE_LAZY");
+        if (!(e && atoi(e) == 0)) {
+            for (auto & [name, t] : tensors_by_name) {
+                if (name != "per_layer_token_embd.weight" || !t->buffer || !ggml_backend_buffer_is_host(t->buffer)) {
+                    continue;
+                }
+                const size_t pg = (size_t) sysconf(_SC_PAGESIZE);
+                const uintptr_t a = ((uintptr_t) t->data + pg - 1) & ~(uintptr_t) (pg - 1);
+                const uintptr_t b = ((uintptr_t) t->data + ggml_nbytes(t)) & ~(uintptr_t) (pg - 1);
+                if (b > a) {
+#ifndef MADV_PAGEOUT
+#define MADV_PAGEOUT 21
+#endif
+                    if (madvise((void *) a, b - a, MADV_PAGEOUT) != 0) {
+                        madvise((void *) a, b - a, MADV_DONTNEED);
+                    }
+                    LLAMA_LOG_INFO("%s: per-layer token table pages released (%.0f MiB, loaded on use)\n", __func__, (b - a) / 1048576.0);
+                }
+            }
+        }
+#endif
     }
 
     return true;
diff --git a/src/models/gemma4.cpp b/src/models/gemma4.cpp
index 3f64ec5..adefbc2 100644
--- a/src/models/gemma4.cpp
+++ b/src/models/gemma4.cpp
@@ -41,12 +41,6 @@ void llama_model_gemma4::load_arch_tensors(llama_model_loader &) {
         throw std::runtime_error("Gemma 4 requires n_embd_head_k_swa == n_embd_head_v_swa");
     }
 
-    output = create_tensor(tn(LLM_TENSOR_OUTPUT, "weight"), {n_embd, n_vocab}, TENSOR_NOT_REQUIRED);
-    // if output is NULL, init from the input tok embed
-    if (output == NULL) {
-        output = create_tensor(tn(LLM_TENSOR_TOKEN_EMBD, "weight"), {n_embd, n_vocab}, TENSOR_DUPLICATED);
-    }
-
     tok_embd = create_tensor(tn(LLM_TENSOR_TOKEN_EMBD, "weight"), {n_embd, n_vocab}, 0);
 
     // Optional rough copy of the dictionary (e.g. Q2_K). When present, the lm_head scores it first, keeps a
@@ -56,6 +50,19 @@ void llama_model_gemma4::load_arch_tensors(llama_model_loader &) {
         LLAMA_LOG_INFO("%s: dictionary preview present (%s)\n", __func__, ggml_type_name(tok_embd_preview->type));
     }
 
+    output = create_tensor(tn(LLM_TENSOR_OUTPUT, "weight"), {n_embd, n_vocab}, TENSOR_NOT_REQUIRED);
+    // if output is NULL, init from the input tok embed
+    if (output == NULL) {
+        const char * e = getenv("LG_DICT_PREVIEW");
+        if (tok_embd_preview && !(e && atoi(e) <= 0)) {
+            // with the preview on, the full-quality rows are only gathered from tok_embd; the tied output matrix is
+            // just the fallback, so it shares tok_embd's mapped copy instead of a second, repacked one (525 MiB on E4B)
+            output = tok_embd;
+        } else {
+            output = create_tensor(tn(LLM_TENSOR_TOKEN_EMBD, "weight"), {n_embd, n_vocab}, TENSOR_DUPLICATED);
+        }
+    }
+
     if (n_embd_per_layer > 0) {
         per_layer_tok_embd   = create_tensor(tn(LLM_TENSOR_PER_LAYER_TOKEN_EMBD, "weight"),    {n_embd_per_layer * n_layer, n_vocab}, 0);
         per_layer_model_proj = create_tensor(tn(LLM_TENSOR_PER_LAYER_MODEL_PROJ, "weight", 0), {n_embd, n_embd_per_layer * n_layer}, 0);
