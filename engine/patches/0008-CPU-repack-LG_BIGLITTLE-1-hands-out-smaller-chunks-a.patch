From f8a7c13349c740e5b6f2104508abb4a3611a6f96 Mon Sep 17 00:00:00 2001
From: iimmyy <i.a.martins001@gmail.com>
Date: Sun, 11 Oct 2026 14:30:25 -0700
Subject: [PATCH 08/31] CPU repack: LG_BIGLITTLE=1 hands out smaller chunks and
 stops slow cores from taking the last ones

On big.LITTLE boards every thread waits at the end of each matrix for the slowest one. With the rail on,
chunks are four times smaller and a little core stops taking new chunks once only one round remains,
so the fast cores finish the tail. QCS6490, brain C: six threads 4.73 -> 6.33 words/s; four fast
cores alone still lead at 6.90.
---
 ggml/src/ggml-cpu/repack.cpp | 46 +++++++++++++++++++++++++++++++++++-
 1 file changed, 45 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-cpu/repack.cpp b/ggml/src/ggml-cpu/repack.cpp
index 700b138..a2df9da 100644
--- a/ggml/src/ggml-cpu/repack.cpp
+++ b/ggml/src/ggml-cpu/repack.cpp
@@ -18,6 +18,10 @@
 
 #include "repack.h"
 
+#if defined(__linux__)
+#include <sched.h>
+#endif
+
 #if defined(__GNUC__)
 #pragma GCC diagnostic ignored "-Woverlength-strings"
 #endif
@@ -4241,6 +4245,39 @@ class tensor_traits_base : public ggml::cpu::tensor_traits {
     virtual int repack(struct ggml_tensor * t, const void * data, size_t data_size) = 0;
 };
 
+
+// Little Guy big.LITTLE ticket rail (LG_BIGLITTLE=1): smaller chunks, and slow cores stop taking new chunks once only
+// about one round is left, so the fast cores finish each matrix instead of waiting on a slow core's last chunk.
+// A core is "slow" when its cpu_capacity (sysfs) is under 60% of the largest one.
+static bool lg_biglittle_enabled() {
+    static const bool on = getenv("LG_BIGLITTLE") != nullptr && atoi(getenv("LG_BIGLITTLE")) > 0;
+    return on;
+}
+
+static bool lg_on_slow_core() {
+#if defined(__linux__)
+    static int capacity[64] = {0};
+    static int max_capacity = -1;
+    if (max_capacity < 0) {
+        int mx = 0;
+        for (int c = 0; c < 64; c++) {
+            char path[96];
+            snprintf(path, sizeof path, "/sys/devices/system/cpu/cpu%d/cpu_capacity", c);
+            FILE * f = fopen(path, "r");
+            if (!f) break;
+            if (fscanf(f, "%d", &capacity[c]) != 1) capacity[c] = 0;
+            fclose(f);
+            mx = capacity[c] > mx ? capacity[c] : mx;
+        }
+        max_capacity = mx;
+    }
+    const int cpu = sched_getcpu();
+    return max_capacity > 0 && cpu >= 0 && cpu < 64 && capacity[cpu] > 0 && capacity[cpu] * 10 < max_capacity * 6;
+#else
+    return false;
+#endif
+}
+
 template <typename BLOC_TYPE, int64_t INTER_SIZE, int64_t NB_COLS, ggml_type PARAM_TYPE> class tensor_traits : public tensor_traits_base {
 
     bool work_size(int /* n_threads */, const struct ggml_tensor * op, size_t & size) override {
@@ -4400,7 +4437,7 @@ template <typename BLOC_TYPE, int64_t INTER_SIZE, int64_t NB_COLS, ggml_type PAR
         // 4x chunks per thread
         const int64_t nr0 = ggml_nrows(op->src[0]);
 
-        int     nth_scaled  = nth * 4;
+        int     nth_scaled  = nth * (lg_biglittle_enabled() ? 16 : 4);
         int64_t chunk_size0 = (nr0 + nth_scaled - 1) / nth_scaled;
         int64_t nchunk0     = (nr0 + chunk_size0 - 1) / chunk_size0;
 
@@ -4465,6 +4502,13 @@ template <typename BLOC_TYPE, int64_t INTER_SIZE, int64_t NB_COLS, ggml_type PAR
 
             forward_mul_mat_one_chunk(params, dst, src0_start, src0_end, src1_start, src1_end);
 
+            if (lg_biglittle_enabled() && lg_on_slow_core()) {
+                // leave the last round to the fast cores: peek before taking a ticket
+                const int next = ggml_threadpool_chunk_add(params->threadpool, 0);
+                if (nchunk0 * nchunk1 - next <= nth) {
+                    break;
+                }
+            }
             current_chunk = ggml_threadpool_chunk_add(params->threadpool, 1);
         }
     }
