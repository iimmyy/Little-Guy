From 750b59f8a3c7015637bb43fe03087da8371434ef Mon Sep 17 00:00:00 2001
From: iimmyy <i.a.martins001@gmail.com>
Date: Tue, 13 Oct 2026 22:56:22 -0700
Subject: [PATCH 20/34] ggml-cpu top_k: one long row is selected by the whole
 team (radix select on float bits, slice copied to cached memory first)
 instead of one thread's partial_sort; same indices, identical greedy replies

---
 ggml/src/ggml-cpu/ops.cpp        | 89 ++++++++++++++++++++++++++++++++
 ggml/src/ggml-hexagon/htp/main.c | 12 +++++
 2 files changed, 101 insertions(+)

diff --git a/ggml/src/ggml-cpu/ops.cpp b/ggml/src/ggml-cpu/ops.cpp
index 43a2b9b..ad5df8b 100644
--- a/ggml/src/ggml-cpu/ops.cpp
+++ b/ggml/src/ggml-cpu/ops.cpp
@@ -8287,6 +8287,86 @@ struct cmp_top_k {
     }
 };
 
+// LG: one long row (the dictionary preview's shortlist during decode) used to go to a single thread running
+// std::partial_sort over all 262,144 scores while the others waited. Here the whole team does a radix select on
+// the float bits: three histogram passes (11 + 11 + 10 bits) find the k-th largest key exactly, then each thread
+// writes its elements above it, and the ties at it in index order. Same set of indices as partial_sort except
+// which of several exactly equal values at the cut-off is kept. Scratch: the start of thread 0's wdata row is
+// shared (needs ne00 >= nth * 2048 + 64); each thread copies its slice after that offset in its own row.
+static inline uint32_t lg_top_k_key(float f) {
+    uint32_t u;
+    memcpy(&u, &f, 4);
+    return (u & 0x80000000u) ? ~u : (u | 0x80000000u);   // unsigned order == float order
+}
+
+static void lg_top_k_row_team(const ggml_compute_params * params, const float * x_src, int64_t n, int k, int32_t * dst,
+                              uint32_t * shared, float * local) {
+    const int ith = params->ith, nth = params->nth;
+    const int64_t c0 = n * ith / nth, c1 = n * (ith + 1) / nth;
+    // the scores may sit in memory that is uncached for the CPU (an NPU buffer): copy this thread's slice once,
+    // then make the four passes over the cached copy
+    memcpy(local, x_src + c0, (c1 - c0) * sizeof(float));
+    const float * x = local - c0;
+    uint32_t * hist  = shared;                    // [nth][2048]
+    uint32_t * state = shared + nth * 2048;       // prefix, mask, need
+    uint32_t * cnt   = state + 8;                 // [nth][2]: above, equal
+
+    static const int shift[3] = { 21, 10, 0 };
+    static const int width[3] = { 11, 11, 10 };
+    uint32_t prefix = 0, mask = 0, need = (uint32_t) k;
+
+    for (int pass = 0; pass < 3; pass++) {
+        const uint32_t bins = 1u << width[pass];
+        uint32_t * h = hist + ith * 2048;
+        memset(h, 0, bins * sizeof(uint32_t));
+        for (int64_t i = c0; i < c1; i++) {
+            const uint32_t key = lg_top_k_key(x[i]);
+            if ((key & mask) == prefix) h[(key >> shift[pass]) & (bins - 1)]++;
+        }
+        ggml_barrier(params->threadpool);
+        if (ith == 0) {
+            uint32_t cum = 0;
+            for (int64_t b = bins - 1; b >= 0; b--) {
+                uint32_t tot = 0;
+                for (int t = 0; t < nth; t++) tot += hist[t * 2048 + b];
+                if (cum + tot >= need) {
+                    state[0] = prefix | ((uint32_t) b << shift[pass]);
+                    state[1] = mask | ((bins - 1) << shift[pass]);
+                    state[2] = need - cum;
+                    break;
+                }
+                cum += tot;
+            }
+        }
+        ggml_barrier(params->threadpool);
+        prefix = state[0]; mask = state[1]; need = state[2];
+    }
+
+    // prefix is now the k-th largest key; take everything above it and the first `need` equal to it
+    uint32_t above = 0, equal = 0;
+    for (int64_t i = c0; i < c1; i++) {
+        const uint32_t key = lg_top_k_key(x[i]);
+        above += key > prefix;
+        equal += key == prefix;
+    }
+    cnt[2 * ith] = above; cnt[2 * ith + 1] = equal;
+    ggml_barrier(params->threadpool);
+    uint32_t a_off = 0, e_off = 0, n_above = 0;
+    for (int t = 0; t < nth; t++) {
+        if (t < ith) { a_off += cnt[2 * t]; e_off += cnt[2 * t + 1]; }
+        n_above += cnt[2 * t];
+    }
+    for (int64_t i = c0; i < c1; i++) {
+        const uint32_t key = lg_top_k_key(x[i]);
+        if (key > prefix) {
+            dst[a_off++] = (int32_t) i;
+        } else if (key == prefix && e_off < need) {
+            dst[n_above + e_off++] = (int32_t) i;
+        }
+    }
+    ggml_barrier(params->threadpool);   // the shared scratch is reused by the next row
+}
+
 static void ggml_compute_forward_top_k_f32(
     const ggml_compute_params * params,
     ggml_tensor * dst) {
@@ -8304,6 +8384,15 @@ static void ggml_compute_forward_top_k_f32(
 
     const int top_k = ne0;
 
+    if (nr < nth && nth > 1 && ne00 >= (int64_t) nth * 2048 + 64 && !getenv("LG_TOPK_SORT")) {
+        for (int64_t i = 0; i < nr; i++) {
+            lg_top_k_row_team(params, (const float *) ((const char *) src0->data + i*nb01), ne00, top_k,
+                              (int32_t *) ((char *) dst->data + i*nb1), (uint32_t *) params->wdata,
+                              (float *) ((int32_t *) params->wdata + (ne00 + CACHE_LINE_SIZE_F32) * ith + nth * 2048 + 64));
+        }
+        return;
+    }
+
     int32_t * tmp = (int32_t *) params->wdata + (ne00 + CACHE_LINE_SIZE_F32) * ith;
 
     for (int64_t i = ith; i < nr; i += nth) {
diff --git a/ggml/src/ggml-hexagon/htp/main.c b/ggml/src/ggml-hexagon/htp/main.c
index 362fc28..8268092 100644
--- a/ggml/src/ggml-hexagon/htp/main.c
+++ b/ggml/src/ggml-hexagon/htp/main.c
@@ -94,6 +94,18 @@ AEEResult htp_iface_open(const char * uri, remote_handle64 * handle) {
         if ((err = HAP_power_set((void *) ctx, &request)) != 0) {
             return err;
         }
+
+#ifdef LG_BW_VOTE_GBPS
+        // LG: ask the bus for bandwidth too, not only clock corners (experiment)
+        memset(&request, 0, sizeof(request));
+        request.type                        = HAP_power_set_mips_bw;
+        request.mips_bw.set_bus_bw          = TRUE;
+        request.mips_bw.bwBytePerSec        = (uint64_t) LG_BW_VOTE_GBPS * 1000000000ull;
+        request.mips_bw.busbwUsagePercentage = 100;
+        request.mips_bw.set_latency         = TRUE;
+        request.mips_bw.latency             = 1;
+        (void) HAP_power_set((void *) ctx, &request);
+#endif
     }
 
 #if __HVX_ARCH__ >= 75
