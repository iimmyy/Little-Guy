+// LG: q . k for 4 keys with the running sums kept in qf32 (one multiply and two adds per 64 values instead of the
+// convert-every-step hvx_vec_mpyacc_f32_f16 on v68); converted to sf once before the cross-lane reduction.
+static inline HVX_Vector lg_dot_f16_rx4_qf32(const HVX_Vector * restrict y, const uint8_t * restrict x, size_t stride_x, uint32_t nvec) {
+    const HVX_Vector * restrict x0 = (const HVX_Vector *) x;
+    const HVX_Vector * restrict x1 = (const HVX_Vector *) (x + stride_x);
+    const HVX_Vector * restrict x2 = (const HVX_Vector *) (x + stride_x * 2);
+    const HVX_Vector * restrict x3 = (const HVX_Vector *) (x + stride_x * 3);
+    HVX_Vector a0l = Q6_V_vzero(), a0h = Q6_V_vzero(), a1l = Q6_V_vzero(), a1h = Q6_V_vzero();
+    HVX_Vector a2l = Q6_V_vzero(), a2h = Q6_V_vzero(), a3l = Q6_V_vzero(), a3h = Q6_V_vzero();
+    for (uint32_t i = 0; i < nvec; i++) {
+        const HVX_Vector yy = y[i];
+        HVX_VectorPair m;
+        m = Q6_Wqf32_vmpy_VhfVhf(x0[i], yy); a0l = Q6_Vqf32_vadd_Vqf32Vqf32(a0l, Q6_V_lo_W(m)); a0h = Q6_Vqf32_vadd_Vqf32Vqf32(a0h, Q6_V_hi_W(m));
+        m = Q6_Wqf32_vmpy_VhfVhf(x1[i], yy); a1l = Q6_Vqf32_vadd_Vqf32Vqf32(a1l, Q6_V_lo_W(m)); a1h = Q6_Vqf32_vadd_Vqf32Vqf32(a1h, Q6_V_hi_W(m));
+        m = Q6_Wqf32_vmpy_VhfVhf(x2[i], yy); a2l = Q6_Vqf32_vadd_Vqf32Vqf32(a2l, Q6_V_lo_W(m)); a2h = Q6_Vqf32_vadd_Vqf32Vqf32(a2h, Q6_V_hi_W(m));
+        m = Q6_Wqf32_vmpy_VhfVhf(x3[i], yy); a3l = Q6_Vqf32_vadd_Vqf32Vqf32(a3l, Q6_V_lo_W(m)); a3h = Q6_Vqf32_vadd_Vqf32Vqf32(a3h, Q6_V_hi_W(m));
+    }
+    HVX_Vector_x4 r = { .v = { Q6_Vsf_equals_Vqf32(Q6_Vqf32_vadd_Vqf32Vqf32(a0l, a0h)), Q6_Vsf_equals_Vqf32(Q6_Vqf32_vadd_Vqf32Vqf32(a1l, a1h)),
+                               Q6_Vsf_equals_Vqf32(Q6_Vqf32_vadd_Vqf32Vqf32(a2l, a2h)), Q6_Vsf_equals_Vqf32(Q6_Vqf32_vadd_Vqf32Vqf32(a3l, a3h)) } };
+    return hvx_vec_reduce_sum_f32x4(r);
+}
+
+static inline HVX_Vector lg_dot_f16_rx32_qf32(const void * restrict y, const uint8_t * restrict x, size_t stride_x, uint32_t nvec, float s) {
+    HVX_Vector sums = Q6_V_vzero();
+    for (uint32_t j = 0; j < VLEN_FP32; j += 4) {
+        const HVX_Vector sums_x4 = lg_dot_f16_rx4_qf32((const HVX_Vector *) y, x, stride_x, nvec);
+        sums = Q6_V_vmux_QVV(Q6_Q_vsetq_R(j * SIZEOF_FP32), sums, sums_x4);
+        x += stride_x * 4;
+    }
+    return HVX_OP_MUL_F32(hvx_vec_splat_f32(s), sums);
+}
