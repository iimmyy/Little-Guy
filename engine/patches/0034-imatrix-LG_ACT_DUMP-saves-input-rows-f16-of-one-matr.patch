From de70e0e8b585df78f2e17ed748249f929db478d9 Mon Sep 17 00:00:00 2001
From: iimmyy <i.a.martins001@gmail.com>
Date: Thu, 15 Oct 2026 20:29:25 -0700
Subject: [PATCH 34/40] imatrix: LG_ACT_DUMP saves input rows (f16) of one
 matrix per distinct input, LG_ACT_MAX caps rows, for output-matching
 quantization

---
 tools/imatrix/imatrix.cpp | 27 +++++++++++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/tools/imatrix/imatrix.cpp b/tools/imatrix/imatrix.cpp
index 3431a4e..85e9f3a 100644
--- a/tools/imatrix/imatrix.cpp
+++ b/tools/imatrix/imatrix.cpp
@@ -384,6 +384,33 @@ bool IMatrixCollector::collect_imatrix(struct ggml_tensor * t, bool ask, void *
                 }
             }
         }
+        // Little Guy: LG_ACT_DUMP=<dir> saves the input rows (f16, appended) of one matrix per distinct input
+        // (attn_q also feeds k/v, ffn_gate also feeds up), at most LG_ACT_MAX rows each, for output-matching quantization
+        static const char * lg_act_dir = getenv("LG_ACT_DUMP");
+        if (lg_act_dir && n_mat == 1) {
+            static const char * lg_wanted[] = { ".attn_q.weight", ".ffn_gate.weight", ".attn_output.weight", ".ffn_down.weight" };
+            static const int64_t lg_max = getenv("LG_ACT_MAX") ? atoll(getenv("LG_ACT_MAX")) : INT64_MAX;
+            static std::unordered_map<std::string, int64_t> lg_rows;
+            bool want = false;
+            for (const char * s : lg_wanted) {
+                want |= wname.size() > strlen(s) && wname.compare(wname.size() - strlen(s), strlen(s), s) == 0;
+            }
+            int64_t & have = lg_rows[wname];
+            if (want && have < lg_max) {
+                FILE * f = fopen((std::string(lg_act_dir) + "/" + wname + ".f16").c_str(), "ab");
+                std::vector<ggml_fp16_t> buf(src1->ne[0]);
+                for (int64_t i3 = 0; i3 < src1->ne[3] && have < lg_max; ++i3) {
+                    for (int64_t i2 = 0; i2 < src1->ne[2] && have < lg_max; ++i2) {
+                        for (int64_t row = 0; row < src1->ne[1] && have < lg_max; ++row, ++have) {
+                            const float * x = (const float *) (data + row * src1->nb[1] + i2 * src1->nb[2] + i3 * src1->nb[3]);
+                            ggml_fp32_to_fp16_row(x, buf.data(), src1->ne[0]);
+                            fwrite(buf.data(), sizeof(ggml_fp16_t), buf.size(), f);
+                        }
+                    }
+                }
+                fclose(f);
+            }
+        }
         // only 1 count in practice, except when a tensor is used for both MUL_MAT_ID and MUL_MAT
         for (size_t i = 0; i < e.counts.size(); ++i) {
             e.counts[i] += ggml_nrows(src1) / n_mat;
