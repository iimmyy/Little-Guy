+// ---------------------------------------------------------------------------------------------------------------
+// LG: co-op prompt reading (LG_COOP=1). Reading a prompt is arithmetic-bound, and the NPU's vector unit reads
+// ~16 tokens/s while the CPU's oven kernels read ~37. For a several-token matmul on Q2_K/Q4_0 weights the NPU
+// computes the first rows (LG_COOP_NPU, default 30%) from its tiles while the CPU computes the rest at the same
+// time from its own repacked copy of those rows (made at load). Single-token decode stays NPU-only.
+struct lg_cpu_copy {
+    ggml_context *        ctx;
+    ggml_backend_buffer_t buf;
+    ggml_tensor *         w;     // rows [a, N) of the weight, repacked for the CPU
+    int64_t               a;     // rows [0, a) stay on the NPU
+};
+static std::unordered_map<const ggml_tensor *, lg_cpu_copy> lg_coop_w;
+static std::mutex lg_coop_mtx;
+
+static bool lg_coop_on() {
+    static int on = -1;
+    if (on < 0) { const char * e = getenv("LG_COOP"); on = e && atoi(e) > 0; }
+    return on;
+}
+
+static ggml_backend_buffer_type_t lg_cpu_repack_buft() {
+    static ggml_backend_buffer_type_t buft = nullptr;
+    static bool done = false;
+    if (done) return buft;
+    done = true;
+    ggml_backend_dev_t cpu = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
+    if (!cpu) return nullptr;
+    auto get_extra = (ggml_backend_dev_get_extra_bufts_t) ggml_backend_reg_get_proc_address(ggml_backend_dev_backend_reg(cpu), "ggml_backend_dev_get_extra_bufts");
+    if (get_extra) {
+        for (ggml_backend_buffer_type_t * b = get_extra(cpu); b && *b; b++) {
+            if (strcmp(ggml_backend_buft_name(*b), "CPU_REPACK") == 0) buft = *b;
+        }
+    }
+    if (!buft) buft = ggml_backend_dev_buffer_type(cpu);
+    return buft;
+}
+
+static void lg_coop_make_copy(const ggml_tensor * t, const void * data) {
+    if (!lg_coop_on() || (t->type != GGML_TYPE_Q2_K && t->type != GGML_TYPE_Q4_0)) return;
+    const int64_t K = t->ne[0], N = t->ne[1];
+    if (ggml_nrows(t) != N || N > 16384 || N % 32) return;
+    const char * f = getenv("LG_COOP_NPU");
+    const int64_t a = ((int64_t) (N * (f ? atof(f) : 0.3)) / 32) * 32;
+    if (a <= 0 || a >= N) return;
+    ggml_backend_buffer_type_t buft = lg_cpu_repack_buft();
+    if (!buft) return;
+    ggml_init_params ip = { ggml_tensor_overhead() * 2, nullptr, true };
+    ggml_context * ctx = ggml_init(ip);
+    ggml_tensor * w = ggml_new_tensor_2d(ctx, t->type, K, N - a);
+    ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors_from_buft(ctx, buft);
+    if (!buf) { ggml_free(ctx); return; }
+    ggml_backend_buffer_set_usage(buf, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    const size_t row = ggml_row_size(t->type, K);
+    ggml_backend_tensor_set(w, (const uint8_t *) data + a * row, 0, (N - a) * row);
+    std::lock_guard<std::mutex> lk(lg_coop_mtx);
+    lg_coop_w[t] = { ctx, buf, w, a };
+}
+
+static ggml_backend_t lg_coop_cpu() {
+    static ggml_backend_t b = nullptr;
+    if (b) return b;
+    b = ggml_backend_cpu_init();
+    const char * te = getenv("LG_COOP_THREADS");
+    const int nt = te ? atoi(te) : 4;
+    ggml_backend_cpu_set_n_threads(b, nt);
+    ggml_threadpool_params tp = ggml_threadpool_params_default(nt);
+    for (int i = 4; i < 4 + nt && i < GGML_MAX_N_THREADS; i++) tp.cpumask[i] = true;   // the big cores
+    tp.strict_cpu = true;
+    ggml_threadpool * pool = ggml_threadpool_new(&tp);
+    if (pool) ggml_backend_cpu_set_threadpool(b, pool);
+    return b;
+}
+
+// rows [a, N) of dst = W_cpu x src1, written into the (host-visible) NPU buffer next to the NPU's rows
+static void lg_coop_cpu_part(const lg_cpu_copy & cc, const ggml_tensor * dst, const ggml_tensor * src1) {
+    const int64_t K = src1->ne[0], ncols = src1->ne[1], Nc = cc.w->ne[1];
+    static std::vector<uint8_t> meta, out;
+    meta.resize(ggml_tensor_overhead() * 8 + ggml_graph_overhead() + 4096);
+    out.resize((size_t) Nc * ncols * sizeof(float));
+    ggml_init_params ip = { meta.size(), meta.data(), true };
+    ggml_context * ctx = ggml_init(ip);
+    ggml_tensor * x = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, K, ncols);
+    x->data  = src1->data;
+    x->nb[1] = src1->nb[1]; x->nb[2] = x->nb[1] * ncols; x->nb[3] = x->nb[2];
+    ggml_tensor * y = ggml_mul_mat(ctx, cc.w, x);
+    y->data = out.data();
+    ggml_cgraph * gf = ggml_new_graph(ctx);
+    ggml_build_forward_expand(gf, y);
+    ggml_backend_graph_compute(lg_coop_cpu(), gf);
+    for (int64_t col = 0; col < ncols; col++) {
+        memcpy((uint8_t *) dst->data + col * dst->nb[1] + cc.a * sizeof(float), out.data() + (size_t) col * Nc * sizeof(float), Nc * sizeof(float));
+    }
+    ggml_free(ctx);
+}
+
+// compute graph nodes on the CPU (prompt reading in co-op mode); the tensors live in host-visible NPU buffers
+static void lg_cpu_compute_nodes(ggml_tensor * const * n, int count) {
+    static std::vector<uint8_t> meta;
+    meta.resize(ggml_graph_overhead_custom(16, false) + 1024);
+    ggml_init_params ip = { meta.size(), meta.data(), true };
+    ggml_context * ctx = ggml_init(ip);
+    ggml_cgraph * gf = ggml_new_graph_custom(ctx, 16, false);
+    for (int i = 0; i < count; i++) gf->nodes[gf->n_nodes++] = n[i];
+    ggml_backend_graph_compute(lg_coop_cpu(), gf);
+    ggml_free(ctx);
+}
+
 static void ggml_backend_hexagon_buffer_set_tensor(ggml_backend_buffer_t buffer,
                                                    ggml_tensor *         tensor,
                                                    const void *          data,
@@ -1744,6 +1853,7 @@ static void ggml_backend_hexagon_buffer_set_tensor(ggml_backend_buffer_t buffer,
             GGML_ASSERT(offset == 0);
             GGML_ASSERT(offset + size <= ggml_nbytes(tensor));
             repack_q4_0_lgtile(tensor, data, size);   // LG
+            lg_coop_make_copy(tensor, data);
             break;
 
         case GGML_TYPE_Q4_1:
@@ -1774,6 +1884,7 @@ static void ggml_backend_hexagon_buffer_set_tensor(ggml_backend_buffer_t buffer,
         case GGML_TYPE_Q2_K:
             GGML_ASSERT(offset == 0);
             repack_q2_K_lgtile(tensor, data, size);
+            lg_coop_make_copy(tensor, data);
             break;
 
         default:
@@ -3490,9 +3601,64 @@ static ggml_status ggml_backend_hexagon_graph_compute(ggml_backend_t backend, gg
         nodes.push_back(std::move(node));
     }
 
+    // LG: prompt reading in co-op mode: the CPU computes every op except the NPU's share of the big matmuls
+    bool lg_reading = false;
+    if (lg_coop_on() && !getenv("LG_COOP_NPU_OPS")) {
+        for (const auto & node : nodes) {
+            const ggml_tensor * t = node.node;
+            if (node.opcode == HTP_OP_MUL_MAT && t->src[1] && t->src[1]->ne[1] > 1 && lg_coop_w.count(t->src[0])) { lg_reading = true; break; }
+        }
+    }
+    if (lg_reading) {
+        for (const auto & node : nodes) {
+            ggml_tensor * t = node.node;
+            auto it = (node.opcode == HTP_OP_MUL_MAT && t->src[1]->ne[1] > 1) ? lg_coop_w.find(t->src[0]) : lg_coop_w.end();
+            if (it != lg_coop_w.end()) {
+                const lg_cpu_copy & cc = it->second;
+                ggml_tensor fsrc0 = *t->src[0];
+                fsrc0.ne[1] = cc.a; fsrc0.nb[2] = fsrc0.nb[3] = fsrc0.nb[1] * cc.a;
+                ggml_tensor fdst = *t;
+                fdst.ne[0] = cc.a; fdst.src[0] = &fsrc0;
+                htp_opnode fn = { &fdst, {}, HTP_OP_MUL_MAT };
+                sess->enqueue_op(fn);
+                sess->flush_batch();
+                lg_coop_cpu_part(cc, t, t->src[1]);
+                sess->flush_pending(true);
+            } else if (t->src[0] && t->src[0]->buffer && ggml_backend_buffer_is_hexagon_repack(t->src[0]->buffer)) {
+                sess->enqueue_op(node);   // weights only the NPU can read (its tiles)
+                sess->flush();
+            } else {
+                ggml_tensor * n[16];
+                int count = 0;
+                n[count++] = t;
+                for (auto * f : node.fused) if (count < 16) n[count++] = f;
+                lg_cpu_compute_nodes(n, count);
+            }
+        }
+        return GGML_STATUS_SUCCESS;
+    }
+
     // Queue and execute
     if (opt_opstage & HTP_OPSTAGE_QUEUE) {
         for (const auto & node : nodes) {
+            const ggml_tensor * t = node.node;
+            if (lg_coop_on() && node.opcode == HTP_OP_MUL_MAT && t->src[1] && t->src[1]->ne[1] > 1 && t->src[1]->type == GGML_TYPE_F32) {
+                auto it = lg_coop_w.find(t->src[0]);
+                if (it != lg_coop_w.end()) {
+                    const lg_cpu_copy & cc = it->second;
+                    sess->flush();                                   // its input must be complete
+                    ggml_tensor fsrc0 = *t->src[0];                  // the NPU takes rows [0, a)
+                    fsrc0.ne[1] = cc.a; fsrc0.nb[2] = fsrc0.nb[3] = fsrc0.nb[1] * cc.a;
+                    ggml_tensor fdst = *t;
+                    fdst.ne[0] = cc.a; fdst.src[0] = &fsrc0;
+                    htp_opnode fn = { &fdst, {}, HTP_OP_MUL_MAT };
+                    sess->enqueue_op(fn);
+                    sess->flush_batch();                             // send without waiting
+                    lg_coop_cpu_part(cc, t, t->src[1]);              // the CPU takes rows [a, N) meanwhile
+                    sess->flush_pending(true);
+                    continue;
+                }
+            }
             sess->enqueue_op(node);
         }
     }
diff --git a/ggml/src/ggml-hexagon/htp/lg-q2k-ops.c b/ggml/src/ggml-hexagon/htp/lg-q2k-ops.c
