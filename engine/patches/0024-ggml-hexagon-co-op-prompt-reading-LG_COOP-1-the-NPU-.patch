     struct lg_q2k * c = (struct lg_q2k *) data;
     const uint32_t per = (c->ntiles + nth - 1) / nth;
@@ -270,6 +289,14 @@ static void lg_q2k_mv_job(unsigned int nth, unsigned int ith, void * data) {
                         x4[k]  = (const int32_t *) (c->xq + (size_t) ck * c->K) + s * (LG_SB_INPUTS / 4);
                         xsb[k] = c->xsum + (size_t) ck * (c->nsb * 8) + s * 8;
                     }
+                    if (s + 1 < c->nsb) {   // pull the next super-block's inputs into L1 while this one computes
+                        for (int k = 0; k < LG_MC; k++) {
+                            const uint8_t * nx = (const uint8_t *) (x4[k] + LG_SB_INPUTS / 4);
+                            Q6_dcfetch_A((void *) nx); Q6_dcfetch_A((void *) (nx + 64));
+                            Q6_dcfetch_A((void *) (nx + 128)); Q6_dcfetch_A((void *) (nx + 192));
+                            Q6_dcfetch_A((void *) (xsb[k] + 8));
+                        }
+                    }
                     const HVX_Vector * sb = (const HVX_Vector *) (tile + (size_t) s * LG_SB_BYTES);
                     HVX_Vector S[LG_MC], M[LG_MC];
                     lg_q2k_sb_mc(sb, sb + 16, x4, xsb, S, M);
@@ -349,8 +376,11 @@ int lg_op_matmul_q2k(struct htp_ops_context * octx) {
