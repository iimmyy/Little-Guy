@@ -35,6 +35,7 @@
 #define LG_SB_BYTES  2688   // one tile super-block
 #define LG_SB_INPUTS 256
 #define LG_XBUF      (256 * 1024)   // cached heap buffer for quantized inputs
+#define LG_STAGE_MAXC 128           // columns the result staging holds (per pass)
 #define LG_NBUF      3              // tile buffers per thread: two transfers in flight while one tile is computed
 
 // The quantized inputs of the last Q2_K matmul stay in VTCM; the next one with the same input (gate and up, the
@@ -229,6 +230,24 @@ static inline void lg_q2k_sb_mc(const HVX_Vector * restrict wv, const HVX_Vector
     }
 }
 
+// Several-column results: each tile gives 32 floats per column; writing those straight to DDR scatters 128-byte
+// stores over ncols rows. They are collected for LG_STAGE_T tiles in cached memory and written per column as one
+// contiguous run.
+#define LG_STAGE_T 16
+static uint8_t * lg_stage[HTP_MAX_NTHREADS];   // per thread: [LG_MC-col group capacity ncols][LG_STAGE_T][32] floats
+
+static inline float * lg_stage_slot(unsigned ith, uint32_t col, uint32_t tl) {
+    return (float *) lg_stage[ith] + ((size_t) col * LG_STAGE_T + tl) * LG_TILE_ROWS;
+}
+
+static void lg_stage_flush(unsigned ith, const struct htp_tensor * dst, uint32_t col0_abs, uint32_t ncols, uint32_t tfirst, uint32_t ntl) {
+    for (uint32_t col = 0; col < ncols; col++) {
+        float * y = (float *) ((uint8_t *) dst->data + (size_t) (col0_abs + col) * dst->nb[1]) + (size_t) tfirst * LG_TILE_ROWS;
+        const HVX_Vector * src = (const HVX_Vector *) lg_stage_slot(ith, col, 0);
+        for (uint32_t i = 0; i < ntl; i++) ((HVX_UVector *) y)[i] = src[i];
+    }
+}
+
