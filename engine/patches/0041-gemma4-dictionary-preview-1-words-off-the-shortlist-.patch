From: iimmyy <i.a.martins001@gmail.com>
Date: Sat, 17 Oct 2026 01:14:28 -0700
Subject: [PATCH 41/48] gemma4 dictionary preview: (1) words off the shortlist
 keep their rough-copy score instead of -INF (LG_DICT_TAIL=0 restores -INF):
 engine-side drift vs the 16-bit at 4096, wiki 0.000669 / chat 0.000292
 (preview off 0.000478 / 0.000273; -INF tail reads infinite), offline 2.5-3x
 less added drift at every size; (2) where the dictionary is in host memory,
 shortlist rows are unpacked into a per-thread buffer and dotted there (custom
 op) instead of get_rows to f32 + mul_mat, so the chosen rows are never
 written to memory as f32; greedy replies 8/8 identical to the old route
 (LG_SHORTLIST_GATHER=1)

---
 src/models/gemma4.cpp | 58 ++++++++++++++++++++++++++++++++++++++++---
 1 file changed, 54 insertions(+), 4 deletions(-)

diff --git a/src/models/gemma4.cpp b/src/models/gemma4.cpp
index 1d7803a..43d104a 100644
--- a/src/models/gemma4.cpp
+++ b/src/models/gemma4.cpp
@@ -1,5 +1,41 @@
 #include "models.h"
 
+#include <algorithm>
+#include <vector>
+
+// Little Guy: score the dictionary preview's shortlist straight from the packed dictionary rows. Each chosen row is
+// unpacked into a small per-thread buffer that stays in cache and dotted with the hidden state there, so only the
+// packed rows are read from memory (34 MB for 16384 Q6_K rows on E4B). The get_rows + mul_mat route instead wrote
+// every chosen row to memory as f32 and read it back (2 x 168 MB), more traffic than reading the whole dictionary.
+// Same arithmetic as that route (rows unpacked to f32, f32 dot). Runs where the dictionary is in host memory;
+// LG_SHORTLIST_GATHER=1 forces the old route, for comparing the two.
+static void lg_shortlist_dot(ggml_tensor * dst, int ith, int nth, void * /*userdata*/) {
+    const ggml_tensor * dict = dst->src[0];   // [n_embd, n_vocab], any type with to_float
+    const ggml_tensor * h    = dst->src[1];   // [n_embd, n_outputs] f32, contiguous rows
+    const ggml_tensor * ids  = dst->src[2];   // [n_shortlist, n_outputs] i32
+    const int64_t n_embd = dict->ne[0], n_sl = ids->ne[0], n_out = ids->ne[1];
+    const auto * tt = ggml_get_type_traits(dict->type);
+    std::vector<float> row(dict->type == GGML_TYPE_F32 ? 0 : n_embd);
+    const int64_t total = n_sl * n_out, per = (total + nth - 1) / nth;
+    const int64_t i0 = std::min<int64_t>(total, ith * per), i1 = std::min<int64_t>(total, i0 + per);
+    for (int64_t i = i0; i < i1; ++i) {
+        const int64_t j = i / n_sl, k = i % n_sl;
+        const int32_t id = ((const int32_t *) ((const char *) ids->data + j * ids->nb[1]))[k];
+        const char * src = (const char *) dict->data + (int64_t) id * dict->nb[1];
+        const float * w = (const float *) src;
+        if (dict->type != GGML_TYPE_F32) {
+            tt->to_float(src, row.data(), n_embd);
+            w = row.data();
+        }
+        const float * x = (const float *) ((const char *) h->data + j * h->nb[1]);
+        float sum = 0.0f;
+        for (int64_t c = 0; c < n_embd; ++c) {
+            sum += w[c] * x[c];
+        }
+        ((float *) ((char *) dst->data + j * dst->nb[1]))[k] = sum;
+    }
+}
