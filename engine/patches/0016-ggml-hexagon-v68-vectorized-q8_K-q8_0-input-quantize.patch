-            if (src0->ne[0] % QK_K || src0->ne[1] % 32 || src0->ne[2] != 1 || src0->ne[3] != 1) {
+            if (getenv("LG_HEX_NO_Q2K") || src0->ne[0] % QK_K || src0->ne[1] % 32 || src0->ne[2] != 1 || src0->ne[3] != 1) {
                 return false;
             }
             if (src1->type != GGML_TYPE_F32 || src1->ne[2] != 1 || src1->ne[3] != 1 || ggml_nrows(src1) > 1024) {
@@ -2815,7 +2815,7 @@ static bool ggml_hexagon_supported_mul_mat(const struct ggml_hexagon_session * s
             break;
 
         case GGML_TYPE_Q4_0:   // LG: 32-row tiles (htp/lg-q2k-ops.c)
-            if (src0->ne[0] % 256 || src0->ne[1] % 32 || src0->ne[2] != 1 || src0->ne[3] != 1) {
+            if (getenv("LG_HEX_NO_Q4") || src0->ne[0] % 256 || src0->ne[1] % 32 || src0->ne[2] != 1 || src0->ne[3] != 1) {
                 return false;
             }
             if (src1->type != GGML_TYPE_F32 || src1->ne[2] != 1 || src1->ne[3] != 1 || ggml_nrows(src1) > 1024) {
@@ -2849,6 +2849,11 @@ static bool ggml_hexagon_supported_mul_mat(const struct ggml_hexagon_session * s
             break;
 
         case GGML_TYPE_F16:
+            // LG: LG_HEX_F16_CPU=1 leaves F16-weight matmuls (Gemma 4's per_layer_model_proj) to the CPU; this path
