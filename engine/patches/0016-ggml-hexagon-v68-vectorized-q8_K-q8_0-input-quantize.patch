+#ifdef LG_TRACE
+static unsigned lgq4_n, lgq4_bad, lgq4_dbad;
+static void lg_q4_quant_check(const float * x, const int8_t * q, float dq) {   // CPU: ggml_quantize_mat_q8_0_4x4
+    float amax = 0.0f;
+    for (int j = 0; j < 32; j++) amax = fmaxf(amax, fabsf(x[j]));
+    const float d = amax / 127.0f, id = d ? 1.0f / d : 0.0f;
+    if (dq != (float) (__fp16) d) lgq4_dbad++;
+    for (int j = 0; j < 32; j++) {
+        float v = x[j] * id + 12582912.0f; int32_t i; memcpy(&i, &v, 4); i = (i & 0x007fffff) - 0x00400000;
+        if (i != q[j]) lgq4_bad++;
+    }
+    if (++lgq4_n % 20000 == 0) { lg_trace_kv("q8_0 blocks", lgq4_n); lg_trace_kv("  values differing", lgq4_bad); lg_trace_kv("  scales differing", lgq4_dbad); }
+}
+#endif
+
 static void lg_q4_quant_job(unsigned int nth, unsigned int ith, void * data) {
     struct lg_q4 * c = (struct lg_q4 *) data;
     const uint32_t nchunk = c->K / 256;                     // copy in 256 inputs (8 blocks) at a time
     const uint32_t total = c->ncols * nchunk;
     const uint32_t per = (total + nth - 1) / nth;
     const uint32_t i0 = per * ith, i1 = MIN(i0 + per, total);
-    float * tmp = c->xtmp + (size_t) ith * 256;
+    float * tmp = c->xtmp + (size_t) ith * 2 * LG_SB_INPUTS;
     for (uint32_t i = i0; i < i1; i++) {
         const uint32_t col = i / nchunk, ch = i % nchunk;
         const float * xs = (const float *) ((const uint8_t *) c->src1->data + (size_t) (c->col0 + col) * c->src1->nb[1]) + ch * 256;
         for (int v = 0; v < 8; v++) ((HVX_Vector *) tmp)[v] = ((const HVX_UVector *) xs)[v];
+        int32_t * w = (int32_t *) (tmp + 256);
         for (int b = 0; b < 8; b++) {
-            const float * x = tmp + 32 * b;
-            float amax = 0.0f;
-            for (int j = 0; j < 32; j++) amax = fmaxf(amax, fabsf(x[j]));
+            const HVX_Vector vx = ((const HVX_Vector *) tmp)[b];
+            const float amax = hvx_vec_get_f32(hvx_vec_reduce_max_f32(Q6_V_vand_VV(vx, Q6_V_vsplat_R(0x7fffffff))));
             const float d  = amax / 127.0f;
             const float id = d ? 1.0f / d : 0.0f;
+            ((HVX_Vector *) w)[b] = lg_round_sf_to_w(Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(vx, hvx_vec_splat_f32(id))));
             const uint32_t blk = ch * 8 + b;
             int8_t * q = c->xq + (size_t) col * c->K + blk * 32;
             int32_t s = 0;
-            for (int j = 0; j < 32; j++) {
-                float v = x[j] * id + 12582912.0f;           // round to nearest even, as vcvtnq_s32_f32
-                int32_t k;
-                memcpy(&k, &v, 4);
-                k = (k & 0x007fffff) - 0x00400000;
-                q[j] = (int8_t) k;
-                s += k;
-            }
+            for (int j = 0; j < 32; j++) { const int32_t k = w[32 * b + j]; q[j] = (int8_t) k; s += k; }
             c->xsum8[(size_t) col * (c->K / 32) + blk] = 8 * s;
             c->xd[(size_t) col * (c->K / 32) + blk]    = (float) (__fp16) d;
+#ifdef LG_TRACE
+            lg_q4_quant_check(tmp + 32 * b, q, c->xd[(size_t) col * (c->K / 32) + blk]);
+#endif
+        }
+    }
+}
