diff --git a/ggml/src/ggml-hexagon/htp/lg-q2k-ops.c b/ggml/src/ggml-hexagon/htp/lg-q2k-ops.c
index 8efc3e1..014d8ae 100644
--- a/ggml/src/ggml-hexagon/htp/lg-q2k-ops.c
+++ b/ggml/src/ggml-hexagon/htp/lg-q2k-ops.c
@@ -58,41 +58,86 @@ struct lg_q2k {
     uint32_t n_jobs;
 };
 
-// one super-block of one column, as the CPU's quantize_row_q8_K
-static void lg_q2k_quant_sb(const float * restrict x, int8_t * restrict q, int32_t * restrict bsum, float * restrict d) {
-    float amax = 0.0f, max = 0.0f;
-    for (int j = 0; j < LG_SB_INPUTS; j++) {
-        const float ax = fabsf(x[j]);
-        if (ax > amax) { amax = ax; max = x[j]; }
+// one super-block of one column, as the CPU's quantize_row_q8_K. x is 128-byte aligned in cached memory; w is a
+// 1 KB aligned scratch. The product runs in qf32 (v68 has no IEEE vector float math) and is rounded with
+// lg_round_sf_to_w; it can differ from the CPU's nearest_int only on exact .5 ties.
+static inline HVX_Vector lg_reduce_min_f32(HVX_Vector v) {
+    for (unsigned width = 4; width < 128; width <<= 1) v = Q6_Vsf_vmin_VsfVsf(Q6_V_vror_VR(v, width), v);
+    return v;
+}
+
+// Round an sf vector (|v| < 2^22) to the nearest int32, ties away from zero, with integer ops only: v68 has no
+// IEEE vector float math and qf32 cannot carry the magic-number trick's 24 integer bits.
+static inline HVX_Vector lg_round_sf_to_w(HVX_Vector v) {
+    const HVX_Vector e  = Q6_V_vand_VV(Q6_Vuw_vlsr_VuwR(v, 23), Q6_V_vsplat_R(0xff));
+    const HVX_Vector m  = Q6_V_vor_VV(Q6_V_vand_VV(v, Q6_V_vsplat_R(0x7fffff)), Q6_V_vsplat_R(0x800000));
+    const HVX_Vector sh = Q6_Vw_vmin_VwVw(Q6_Vw_vsub_VwVw(Q6_V_vsplat_R(150), e), Q6_V_vsplat_R(31));  // |v| < 0.5 -> 0
+    const HVX_Vector hf = Q6_Vw_vasl_VwVw(Q6_V_vsplat_R(1), Q6_Vw_vsub_VwVw(sh, Q6_V_vsplat_R(1)));
+    const HVX_Vector r  = Q6_Vw_vasr_VwVw(Q6_Vw_vadd_VwVw(m, hf), sh);
+    return Q6_V_vmux_QVV(Q6_Q_vcmp_gt_VwVw(Q6_V_vzero(), v), Q6_Vw_vsub_VwVw(Q6_V_vzero(), r), r);
+}
+
+static void lg_q2k_quant_sb(const float * restrict x, int8_t * restrict q, int32_t * restrict bsum, float * restrict d,
+                            int32_t * restrict w) {
+    const HVX_Vector * vx = (const HVX_Vector *) x;
+    HVX_Vector vmx = vx[0], vmn = vx[0];
+    for (int i = 1; i < 8; i++) {
+        vmx = Q6_Vsf_vmax_VsfVsf(vmx, vx[i]);
+        vmn = Q6_Vsf_vmin_VsfVsf(vmn, vx[i]);
     }
-    if (amax == 0.0f) {
+    const float mx = hvx_vec_get_f32(hvx_vec_reduce_max_f32(vmx));
+    const float mn = hvx_vec_get_f32(lg_reduce_min_f32(vmn));
+    // the value with the largest magnitude; on a tie between +a and -a the result is the same either way
+    // (q and the scale both flip sign)
+    const float max = (mx >= -mn) ? mx : mn;
+    if (max == 0.0f) {
         *d = 0.0f;
         memset(q, 0, LG_SB_INPUTS);
         for (int g = 0; g < LG_SB_INPUTS / 16; g++) bsum[g] = 0;
         return;
     }
     const float iscale = -127.0f / max;
-    for (int j = 0; j < LG_SB_INPUTS; j++) {
-        float v = iscale * x[j] + 12582912.0f;          // nearest_int, as in ggml-quants.c
-        int32_t i;
-        memcpy(&i, &v, 4);
-        i = (i & 0x007fffff) - 0x00400000;
-        q[j] = (int8_t) (i < 127 ? i : 127);
+    const HVX_Vector vs = hvx_vec_splat_f32(iscale), lim = Q6_V_vsplat_R(127);
+    HVX_Vector * vw = (HVX_Vector *) w;
+    for (int i = 0; i < 8; i++) {
+        vw[i] = Q6_Vw_vmin_VwVw(lg_round_sf_to_w(Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(vx[i], vs))), lim);
     }
     for (int g = 0; g < LG_SB_INPUTS / 16; g++) {
-        int32_t s = 0;
-        for (int t = 0; t < 16; t++) s += q[16 * g + t];
-        bsum[g] = s;
+        int32_t sum = 0;
+        for (int t = 0; t < 16; t++) { const int32_t k = w[16 * g + t]; q[16 * g + t] = (int8_t) k; sum += k; }
+        bsum[g] = sum;
     }
     *d = 1.0f / iscale;
 }
 
+#include "lg-trace.h"
+#ifdef LG_TRACE
+static unsigned lg_chk_n, lg_chk_bad, lg_chk_maxd, lg_chk_dbad;
+static void lg_q2k_quant_check(const float * x, const int8_t * q, float d) {
+    float amax = 0.0f, max = 0.0f;
+    for (int j = 0; j < 256; j++) { const float ax = fabsf(x[j]); if (ax > amax) { amax = ax; max = x[j]; } }
+    if (amax == 0.0f) return;
+    const float iscale = -127.0f / max;
+    if (d != 1.0f / iscale) lg_chk_dbad++;
+    for (int j = 0; j < 256; j++) {
+        float v = iscale * x[j] + 12582912.0f; int32_t i; memcpy(&i, &v, 4); i = (i & 0x007fffff) - 0x00400000;
+        if (i > 127) i = 127;
+        int df = i - q[j]; if (df < 0) df = -df;
+        if (df) { lg_chk_bad++; if ((unsigned) df > lg_chk_maxd) lg_chk_maxd = df; }
+    }
+    if (++lg_chk_n % 2000 == 0) {
+        lg_trace_kv("q8K blocks checked", lg_chk_n); lg_trace_kv("  values differing", lg_chk_bad);
+        lg_trace_kv("  max diff", lg_chk_maxd); lg_trace_kv("  scale differs", lg_chk_dbad);
+    }
+}
+#endif
