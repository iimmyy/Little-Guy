+#ifdef LG_TRACE
+static unsigned lg4_bad, lg4_rows; static float lg4_maxrel;
+// scalar reference for row 0 of a tile, from the tile layout itself
+static void lg_q4_row_check(const struct lg_q4 * c, const uint8_t * tile, uint32_t col, float got) {
+    const int8_t * xq = c->xq + (size_t) col * c->K;
+    const float * xd = c->xd + (size_t) col * (c->K / 32);
+    double ref = 0.0;
+    for (uint32_t p = 0; p < c->npair; p++) {
+        const uint8_t * pv = tile + (size_t) p * LG_Q4_PAIR_BYTES;
+        for (int b = 0; b < 2; b++) {
+            int32_t isum = 0;
+            for (int v = 0; v < 4; v++) for (int j = 0; j < 4; j++) {
+                const uint8_t byte = pv[(4 * b + v) * 128 + j];         // row 0
+                isum += ((byte & 15) - 8) * xq[(2 * p + b) * 32 + 4 * v + j];
+                isum += ((byte >> 4) - 8) * xq[(2 * p + b) * 32 + 16 + 4 * v + j];
+            }
+            const float d = (float) ((const __fp16 *) (pv + 1024))[b];
+            ref += (double) isum * d * xd[2 * p + b];
         }
     }
+    const float rel = fabsf(got - (float) ref) / (fabsf((float) ref) + 1e-3f);
+    if (rel > lg4_maxrel) lg4_maxrel = rel;
+    if (rel > 1e-3f) lg4_bad++;
+    if (++lg4_rows % 4000 == 0) {
+        lg_trace_kv("q4 rows checked", lg4_rows); lg_trace_kv("  rel err > 1e-3", lg4_bad);
+        lg_trace_kv("  max rel err x1e6", (unsigned) (lg4_maxrel * 1e6f));
+    }
 }
