     const uint32_t i0 = per * ith, i1 = MIN(i0 + per, total);
-    float * tmp = c->xtmp + (size_t) ith * LG_SB_INPUTS;
+    float * tmp = c->xtmp + (size_t) ith * 2 * LG_SB_INPUTS;
     for (uint32_t i = i0; i < i1; i++) {
         const uint32_t col = i / c->nsb, s = i % c->nsb;
         const float * xs = (const float *) ((const uint8_t *) c->src1->data + (size_t) (c->col0 + col) * c->src1->nb[1]) + s * LG_SB_INPUTS;
@@ -100,7 +145,10 @@ static void lg_q2k_quant_job(unsigned int nth, unsigned int ith, void * data) {
             ((HVX_Vector *) tmp)[v] = ((const HVX_UVector *) xs)[v];
         }
         lg_q2k_quant_sb(tmp, c->xq + (size_t) col * c->K + s * LG_SB_INPUTS, c->xsum + (size_t) col * (c->K / 16) + s * 16,
-                        c->xd + (size_t) col * c->nsb + s);
+                        c->xd + (size_t) col * c->nsb + s, (int32_t *) (tmp + LG_SB_INPUTS));
+#ifdef LG_TRACE
+        lg_q2k_quant_check(tmp, c->xq + (size_t) col * c->K + s * LG_SB_INPUTS, c->xd[(size_t) col * c->nsb + s]);
+#endif
     }
 }
 
@@ -165,10 +213,10 @@ static void lg_q2k_mv_job(unsigned int nth, unsigned int ith, void * data) {
                 const HVX_Vector a  = Q6_Vqf32_vmpy_VsfVsf(Q6_Vsf_equals_Vw(S), d);
                 const HVX_Vector b  = Q6_Vqf32_vmpy_VsfVsf(Q6_Vsf_equals_Vw(M), mn);
                 const HVX_Vector ab = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vsub_Vqf32Vqf32(a, b));
-                acc = Q6_Vqf32_vadd_Vqf32Vqf32(acc, Q6_Vqf32_vmpy_VsfVsf(ab, hvx_vec_splat_f32(xd[s])));
+                acc = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vadd_Vqf32Vsf(Q6_Vqf32_vmpy_VsfVsf(ab, hvx_vec_splat_f32(xd[s])), acc));  // keep acc in sf: qf32 sums drift
             }
             float * y = (float *) ((uint8_t *) c->dst->data + (size_t) (c->col0 + col) * c->dst->nb[1]) + (size_t) t * LG_TILE_ROWS;
-            *(HVX_UVector *) y = Q6_Vsf_equals_Vqf32(acc);
