 static void ggml_backend_hexagon_buffer_set_tensor(ggml_backend_buffer_t buffer,
                                                    ggml_tensor *         tensor,
                                                    const void *          data,
@@ -1617,7 +1743,7 @@ static void ggml_backend_hexagon_buffer_set_tensor(ggml_backend_buffer_t buffer,
         case GGML_TYPE_Q4_0:
             GGML_ASSERT(offset == 0);
             GGML_ASSERT(offset + size <= ggml_nbytes(tensor));
-            repack_q4_0_q4x4x2(tensor, data, size);
+            repack_q4_0_lgtile(tensor, data, size);   // LG
             break;
 
         case GGML_TYPE_Q4_1:
@@ -1645,6 +1771,11 @@ static void ggml_backend_hexagon_buffer_set_tensor(ggml_backend_buffer_t buffer,
             repack_mxfp4_mxfp4x4x2(tensor, data, size);
             break;
 
+        case GGML_TYPE_Q2_K:
+            GGML_ASSERT(offset == 0);
+            repack_q2_K_lgtile(tensor, data, size);
+            break;
+
         default:
             memcpy((char *) tensor->data + offset, data, size);
             break;
@@ -1665,7 +1796,7 @@ static void ggml_backend_hexagon_buffer_get_tensor(ggml_backend_buffer_t buffer,
         case GGML_TYPE_Q4_0:
             GGML_ASSERT(offset == 0);
             GGML_ASSERT(offset + size <= ggml_nbytes(tensor));
-            repack_q4x4x2_q4_0(data, tensor, size);
+            repack_lgtile_q4_0(data, tensor, size);   // LG
             break;
 
         case GGML_TYPE_Q4_1:
@@ -1692,6 +1823,11 @@ static void ggml_backend_hexagon_buffer_get_tensor(ggml_backend_buffer_t buffer,
             repack_mxfp4x4x2_mxfp4(data, tensor, size);
             break;
 
+        case GGML_TYPE_Q2_K:
+            GGML_ASSERT(offset == 0);
+            repack_lgtile_q2_K(data, tensor, size);
+            break;
+
         default:
             memcpy(data, (const char *) tensor->data + offset, size);
             break;
@@ -2666,7 +2802,30 @@ static bool ggml_hexagon_supported_mul_mat(const struct ggml_hexagon_session * s
     }
 
