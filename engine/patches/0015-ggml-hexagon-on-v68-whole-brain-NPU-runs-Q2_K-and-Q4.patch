diff --git a/ggml/src/ggml-hexagon/htp/lg-q2k-ops.c b/ggml/src/ggml-hexagon/htp/lg-q2k-ops.c
new file mode 100644
index 0000000..8efc3e1
--- /dev/null
+++ b/ggml/src/ggml-hexagon/htp/lg-q2k-ops.c
@@ -0,0 +1,401 @@
+// LG: Q2_K weights times f32 inputs on the v68 NPU (HVX only, this chip has no HMX).
+//
+// The host repacks Q2_K weights into tiles of 32 rows (repack_q2_K_lgtile in ggml-hexagon.cpp). Per (tile,
+// super-block of 256 inputs) there are 2688 bytes, the same as 32 original Q2_K blocks:
+//   16 x 128 B weights  vector p covers inputs 16p..16p+15; word r is row r; bits 2k+1:2k of its byte j hold
+//                       the 2-bit weight of input 16p + 4k + j
+//    4 x 128 B scales   vector v, word r, byte i: scales[4v + i] of row r (scale low nibble, min high nibble)
+//    1 x 128 B d/dmin   fp16 lane 2r = d of row r, lane 2r + 1 = dmin of row r
+// With 32 rows side by side no row ever has to be summed across a vector, and a whole tile is one contiguous
+// DMA transfer into VTCM, which the next tile's transfer overlaps.
+//
+// Inputs are quantized exactly like the CPU's q8_K: per 256 inputs iscale = -127 / (the input with the largest
+// magnitude), q = min(127, round-to-nearest-even(iscale * x)) with the same magic-number rounding, scale 1 / iscale,
+// plus the sum of every 16 quantized inputs. Per row and super-block the answer is then
+//   xd * (d * S - dmin * M),  S = sum over 16 pouches of scale * sum(q * xq),  M = sum of min * sum(xq),
+// the integer parts exact and the float part in the same order as the CPU's dot product.
+
+#pragma clang diagnostic ignored "-Wunused-function"
+
+#include <HAP_farf.h>
+#include <HAP_perf.h>
+#include <math.h>
+#include <string.h>
+#include <stdlib.h>
+
+#include "hex-dma.h"
+#include "hvx-utils.h"
+
+#define GGML_COMMON_DECL_C
+#include "ggml-common.h"
+#include "htp-ctx.h"
+#include "htp-ops.h"
+
+#define LG_TILE_ROWS 32
+#define LG_SB_BYTES  2688   // one tile super-block
+#define LG_SB_INPUTS 256
+#define LG_XBUF      (256 * 1024)   // cached heap buffer for quantized inputs
+#define LG_NBUF      3              // tile buffers per thread: two transfers in flight while one tile is computed
+
+// The quantized inputs of the last Q2_K matmul stay in VTCM; the next one with the same input (gate and up, the
+// attention projections) reuses them. Any other op may overwrite VTCM, so main.c clears this before other ops.
+uint32_t lg_q2k_xcache_src;
+static uint32_t lg_q2k_xcache_ncols;
+uint32_t lg_q4_xcache_src;
+static uint8_t * lg_xbuf, * lg_tbuf;   // cached heap: quantized inputs (shared by both formats), raw-input scratch
+
+struct lg_q2k {
+    const struct htp_tensor * src0, * src1, * dst;
+    struct htp_context * ctx;
+    uint32_t K, N, nsb, ntiles;
+    uint32_t col0, ncols;            // the columns of src1 handled in this pass
+    size_t   tile_bytes;
+    int8_t  * xq;                    // [ncols][K]       quantized inputs, in cached heap memory: the kernel reads
+    int32_t * xsum;                  // [ncols][K / 16]  them with scalar loads, which stall on VTCM
+    float   * xd;                    // [ncols][nsb]
+    uint8_t * wbuf;                  // VTCM per thread: two tile buffers
+    float   * xtmp;                  // per thread: one super-block of raw inputs, copied in with HVX (cached heap)
+    uint32_t n_jobs;
+};
+
+// one super-block of one column, as the CPU's quantize_row_q8_K
+static void lg_q2k_quant_sb(const float * restrict x, int8_t * restrict q, int32_t * restrict bsum, float * restrict d) {
+    float amax = 0.0f, max = 0.0f;
+    for (int j = 0; j < LG_SB_INPUTS; j++) {
+        const float ax = fabsf(x[j]);
+        if (ax > amax) { amax = ax; max = x[j]; }
+    }
+    if (amax == 0.0f) {
+        *d = 0.0f;
+        memset(q, 0, LG_SB_INPUTS);
+        for (int g = 0; g < LG_SB_INPUTS / 16; g++) bsum[g] = 0;
+        return;
+    }
+    const float iscale = -127.0f / max;
+    for (int j = 0; j < LG_SB_INPUTS; j++) {
+        float v = iscale * x[j] + 12582912.0f;          // nearest_int, as in ggml-quants.c
+        int32_t i;
+        memcpy(&i, &v, 4);
+        i = (i & 0x007fffff) - 0x00400000;
+        q[j] = (int8_t) (i < 127 ? i : 127);
+    }
+    for (int g = 0; g < LG_SB_INPUTS / 16; g++) {
+        int32_t s = 0;
+        for (int t = 0; t < 16; t++) s += q[16 * g + t];
+        bsum[g] = s;
+    }
+    *d = 1.0f / iscale;
+}
+
+static void lg_q2k_quant_job(unsigned int nth, unsigned int ith, void * data) {
+    struct lg_q2k * c = (struct lg_q2k *) data;
+    const uint32_t total = c->ncols * c->nsb;
+    const uint32_t per   = (total + nth - 1) / nth;
+    const uint32_t i0 = per * ith, i1 = MIN(i0 + per, total);
+    float * tmp = c->xtmp + (size_t) ith * LG_SB_INPUTS;
+    for (uint32_t i = i0; i < i1; i++) {
+        const uint32_t col = i / c->nsb, s = i % c->nsb;
+        const float * xs = (const float *) ((const uint8_t *) c->src1->data + (size_t) (c->col0 + col) * c->src1->nb[1]) + s * LG_SB_INPUTS;
+        for (int v = 0; v < LG_SB_INPUTS * 4 / 128; v++) {
+            ((HVX_Vector *) tmp)[v] = ((const HVX_UVector *) xs)[v];
+        }
+        lg_q2k_quant_sb(tmp, c->xq + (size_t) col * c->K + s * LG_SB_INPUTS, c->xsum + (size_t) col * (c->K / 16) + s * 16,
+                        c->xd + (size_t) col * c->nsb + s);
+    }
+}
+
+// 32 rows x one super-block: integer totals S (scale * q . x) and M (min * sum x) per row
+static inline void lg_q2k_sb(const HVX_Vector * restrict wv, const HVX_Vector * restrict sv, const int32_t * restrict x4,
+                             const int32_t * restrict xs, HVX_Vector * S_out, HVX_Vector * M_out) {
+    const HVX_Vector three = Q6_Vb_vsplat_R(3), nib = Q6_V_vsplat_R(0x0f);
+    HVX_Vector S = Q6_V_vzero(), M = Q6_V_vzero();
+    #pragma unroll(4)
+    for (int p = 0; p < 16; p++) {
+        const HVX_Vector pk = wv[p];
+        const int32_t * xb = x4 + 4 * p;
+        HVX_Vector a = Q6_Vw_vrmpy_VubRb(Q6_V_vand_VV(pk, three), xb[0]);
+        HVX_Vector b = Q6_Vw_vrmpy_VubRb(Q6_V_vand_VV(Q6_Vuh_vlsr_VuhR(pk, 2), three), xb[1]);
+        a = Q6_Vw_vrmpyacc_VwVubRb(a, Q6_V_vand_VV(Q6_Vuh_vlsr_VuhR(pk, 4), three), xb[2]);
+        b = Q6_Vw_vrmpyacc_VwVubRb(b, Q6_V_vand_VV(Q6_Vuh_vlsr_VuhR(pk, 6), three), xb[3]);
+        const HVX_Vector pouch = Q6_Vw_vadd_VwVw(a, b);
+        const HVX_Vector byte  = Q6_Vuw_vlsr_VuwR(sv[p / 4], 8 * (p % 4));
+        const HVX_Vector scale = Q6_V_vand_VV(byte, nib);
+        const HVX_Vector mn    = Q6_V_vand_VV(Q6_Vuw_vlsr_VuwR(byte, 4), nib);
+        S = Q6_Vw_vadd_VwVw(S, Q6_Vw_vmpyie_VwVuh(pouch, scale));
+        M = Q6_Vw_vadd_VwVw(M, Q6_Vw_vmpyi_VwRh(mn, Q6_R_combine_RlRl(xs[p], xs[p])));
+    }
+    *S_out = S;
+    *M_out = M;
+}
+
+static void lg_q2k_mv_job(unsigned int nth, unsigned int ith, void * data) {
+    struct lg_q2k * c = (struct lg_q2k *) data;
+    const uint32_t per = (c->ntiles + nth - 1) / nth;
+    const uint32_t t0 = per * ith, t1 = MIN(t0 + per, c->ntiles);
+    if (t0 >= t1) return;
+
+    dma_queue * q = c->ctx->dma[ith];
+    uint8_t * buf0 = c->wbuf + (size_t) ith * LG_NBUF * c->tile_bytes;
+    const uint8_t * w = (const uint8_t *) c->src0->data;
+    for (uint32_t t = t0; t < MIN(t0 + LG_NBUF - 1, t1); t++) {
+        dma_queue_push_ddr_to_vtcm(q, dma_make_ptr(buf0 + ((t - t0) % LG_NBUF) * c->tile_bytes, w + (size_t) t * c->tile_bytes),
+                                   c->tile_bytes, c->tile_bytes, 1);
+    }
+
+    const HVX_Vector one_hf = Q6_Vh_vsplat_R(0x3c00);   // 1.0 in fp16
+    for (uint32_t t = t0; t < t1; t++) {
+        const uint8_t * tile = (const uint8_t *) dma_queue_pop(q).dst;
+        const uint32_t tn = t + LG_NBUF - 1;
+        if (tn < t1) {
+            dma_queue_push_ddr_to_vtcm(q, dma_make_ptr(buf0 + ((tn - t0) % LG_NBUF) * c->tile_bytes, w + (size_t) tn * c->tile_bytes),
+                                       c->tile_bytes, c->tile_bytes, 1);
+        }
+        for (uint32_t col = 0; col < c->ncols; col++) {
+            const int32_t * x4 = (const int32_t *) (c->xq + (size_t) col * c->K);
+            const int32_t * xs = c->xsum + (size_t) col * (c->K / 16);
+            const float   * xd = c->xd + (size_t) col * c->nsb;
+            HVX_Vector acc = Q6_V_vzero();
+            for (uint32_t s = 0; s < c->nsb; s++) {
+                const HVX_Vector * sb = (const HVX_Vector *) (tile + (size_t) s * LG_SB_BYTES);
+                HVX_Vector S, M;
+                lg_q2k_sb(sb, sb + 16, x4 + s * (LG_SB_INPUTS / 4), xs + s * 16, &S, &M);
+                const HVX_VectorPair dm = Q6_Wqf32_vmpy_VhfVhf(sb[20], one_hf);       // lo: d, hi: dmin
+                const HVX_Vector d  = Q6_Vsf_equals_Vqf32(Q6_V_lo_W(dm));
+                const HVX_Vector mn = Q6_Vsf_equals_Vqf32(Q6_V_hi_W(dm));
+                const HVX_Vector a  = Q6_Vqf32_vmpy_VsfVsf(Q6_Vsf_equals_Vw(S), d);
+                const HVX_Vector b  = Q6_Vqf32_vmpy_VsfVsf(Q6_Vsf_equals_Vw(M), mn);
+                const HVX_Vector ab = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vsub_Vqf32Vqf32(a, b));
+                acc = Q6_Vqf32_vadd_Vqf32Vqf32(acc, Q6_Vqf32_vmpy_VsfVsf(ab, hvx_vec_splat_f32(xd[s])));
+            }
+            float * y = (float *) ((uint8_t *) c->dst->data + (size_t) (c->col0 + col) * c->dst->nb[1]) + (size_t) t * LG_TILE_ROWS;
+            *(HVX_UVector *) y = Q6_Vsf_equals_Vqf32(acc);
+        }
+    }
+}
+
+int lg_op_matmul_q2k(struct htp_ops_context * octx) {
+    const struct htp_tensor * src0 = octx->src[0];
+    const struct htp_tensor * src1 = octx->src[1];
+    const struct htp_tensor * dst  = octx->dst;
+
+    struct lg_q2k c;
+    memset(&c, 0, sizeof(c));
+    c.src0 = src0; c.src1 = src1; c.dst = dst; c.ctx = octx->ctx;
+    c.K = src0->ne[0];
+    c.N = src0->ne[1];
+    if (c.K % LG_SB_INPUTS || c.N % LG_TILE_ROWS || src1->type != HTP_TYPE_F32 || src1->ne[2] != 1 || src1->ne[3] != 1) {
+        return HTP_STATUS_NO_SUPPORT;
+    }
+    c.nsb        = c.K / LG_SB_INPUTS;
+    c.ntiles     = c.N / LG_TILE_ROWS;
+    c.tile_bytes = (size_t) c.nsb * LG_SB_BYTES;
+    c.n_jobs     = octx->n_threads;
+
+    // VTCM: per thread two tile buffers. The quantized inputs and the raw-input scratch live in cached heap memory
+    // (scalar loads stall on VTCM): LG_XBUF bytes, as many columns per pass as fit.
+    const size_t wbytes   = hex_round_up(LG_NBUF * c.tile_bytes * c.n_jobs, 128);
+    const size_t col_size = hex_round_up(c.K, 128) + hex_round_up(c.K / 16 * 4, 128) + hex_round_up(c.nsb * 4, 128);
+    if (octx->ctx->vtcm_size < wbytes || c.n_jobs > HTP_MAX_NTHREADS || col_size > LG_XBUF) {
+        return HTP_STATUS_VTCM_TOO_SMALL;
+    }
+    if (octx->flags & HTP_OPFLAGS_SKIP_COMPUTE) {
+        return HTP_STATUS_OK;
+    }
+    if (!lg_xbuf && !(lg_xbuf = memalign(128, LG_XBUF))) return HTP_STATUS_INTERNAL_ERR;
+    if (!lg_tbuf && !(lg_tbuf = memalign(128, HTP_MAX_NTHREADS * LG_SB_INPUTS * 4))) return HTP_STATUS_INTERNAL_ERR;
+    uint8_t * xbuf = lg_xbuf, * tbuf = lg_tbuf;
+    const uint32_t max_cols = LG_XBUF / col_size;
+    const uint32_t ncols    = src1->ne[1];
+    c.wbuf = octx->ctx->vtcm_base;
+    c.xtmp = (float *) tbuf;
+
+    for (uint32_t col0 = 0; col0 < ncols; col0 += max_cols) {
+        c.col0  = col0;
+        c.ncols = MIN(max_cols, ncols - col0);
+        uint8_t * p = xbuf;
+        c.xq   = (int8_t *) p;  p += hex_round_up((size_t) c.ncols * c.K, 128);
+        c.xsum = (int32_t *) p; p += hex_round_up((size_t) c.ncols * (c.K / 16) * 4, 128);
+        c.xd   = (float *) p;
+
+        const bool cached = (ncols <= max_cols && lg_q2k_xcache_src == src1->data && lg_q2k_xcache_ncols == ncols);
+        if (!cached) {
+            worker_pool_run_func(octx->ctx->worker_pool, lg_q2k_quant_job, &c, MIN(c.n_jobs, c.ncols * c.nsb));
+            lg_q2k_xcache_src   = (ncols <= max_cols) ? src1->data : 0;
+            lg_q2k_xcache_ncols = ncols;
+            lg_q4_xcache_src    = 0;   // both formats share lg_xbuf
+        }
+        worker_pool_run_func(octx->ctx->worker_pool, lg_q2k_mv_job, &c, c.n_jobs);
+    }
+
+    octx->src1_spad.src = NULL;   // the q8 matmul path must not reuse what is now in VTCM
+    return HTP_STATUS_OK;
+}
+
+// ---------------------------------------------------------------------------------------------------------------
+// Q4_0 in the same 32-row tiles (repack_q4_0_lgtile in ggml-hexagon.cpp). Per (tile, pair of 32-input blocks)
+// 1152 bytes, the same as the 64 original blocks:
+//    8 x 128 B weights  vector 4b + v, word r = bytes qs[4v .. 4v+3] of row r's block b: low nibbles are inputs
+//                       32b + 4v + j, high nibbles inputs 32b + 16 + 4v + j (unsigned 0..15, the weight is q - 8)
+//    1 x 128 B d        fp16 lane 2r = d of row r's first block, lane 2r + 1 = its second block
+// Inputs are quantized exactly like the board CPU's q8_0 (ggml_quantize_mat_q8_0_4x4: d = amax / 127 in f32,
+// stored and used as fp16, q = round-to-nearest-even(x / d)), so the integer parts match the CPU bit for bit.
+
+#define LG_Q4_PAIR_BYTES 1152
+#define LG_Q4_PAIR       64
+
+static uint32_t lg_q4_xcache_ncols;
+
+struct lg_q4 {
+    const struct htp_tensor * src0, * src1, * dst;
+    struct htp_context * ctx;
+    uint32_t K, N, npair, ntiles, col0, ncols, n_jobs;
+    size_t   tile_bytes;
+    int8_t  * xq;       // [ncols][K]
+    int32_t * xsum8;    // [ncols][K / 32]  8 * sum of each block's quantized inputs
+    float   * xd;       // [ncols][K / 32]  the block scale, rounded to fp16 like the CPU's
+    float   * xtmp;     // per thread: 256 raw inputs
+    uint8_t * wbuf;
+};
+
+static void lg_q4_quant_job(unsigned int nth, unsigned int ith, void * data) {
+    struct lg_q4 * c = (struct lg_q4 *) data;
+    const uint32_t nchunk = c->K / 256;                     // copy in 256 inputs (8 blocks) at a time
+    const uint32_t total = c->ncols * nchunk;
+    const uint32_t per = (total + nth - 1) / nth;
+    const uint32_t i0 = per * ith, i1 = MIN(i0 + per, total);
+    float * tmp = c->xtmp + (size_t) ith * 256;
+    for (uint32_t i = i0; i < i1; i++) {
+        const uint32_t col = i / nchunk, ch = i % nchunk;
+        const float * xs = (const float *) ((const uint8_t *) c->src1->data + (size_t) (c->col0 + col) * c->src1->nb[1]) + ch * 256;
+        for (int v = 0; v < 8; v++) ((HVX_Vector *) tmp)[v] = ((const HVX_UVector *) xs)[v];
+        for (int b = 0; b < 8; b++) {
+            const float * x = tmp + 32 * b;
+            float amax = 0.0f;
+            for (int j = 0; j < 32; j++) amax = fmaxf(amax, fabsf(x[j]));
+            const float d  = amax / 127.0f;
+            const float id = d ? 1.0f / d : 0.0f;
+            const uint32_t blk = ch * 8 + b;
+            int8_t * q = c->xq + (size_t) col * c->K + blk * 32;
+            int32_t s = 0;
+            for (int j = 0; j < 32; j++) {
+                float v = x[j] * id + 12582912.0f;           // round to nearest even, as vcvtnq_s32_f32
+                int32_t k;
+                memcpy(&k, &v, 4);
+                k = (k & 0x007fffff) - 0x00400000;
+                q[j] = (int8_t) k;
+                s += k;
+            }
+            c->xsum8[(size_t) col * (c->K / 32) + blk] = 8 * s;
+            c->xd[(size_t) col * (c->K / 32) + blk]    = (float) (__fp16) d;
+        }
+    }
+}
+
+static void lg_q4_mv_job(unsigned int nth, unsigned int ith, void * data) {
+    struct lg_q4 * c = (struct lg_q4 *) data;
+    const uint32_t per = (c->ntiles + nth - 1) / nth;
+    const uint32_t t0 = per * ith, t1 = MIN(t0 + per, c->ntiles);
+    if (t0 >= t1) return;
+
+    dma_queue * q = c->ctx->dma[ith];
+    uint8_t * buf0 = c->wbuf + (size_t) ith * LG_NBUF * c->tile_bytes;
+    const uint8_t * w = (const uint8_t *) c->src0->data;
+    for (uint32_t t = t0; t < MIN(t0 + LG_NBUF - 1, t1); t++) {
+        dma_queue_push_ddr_to_vtcm(q, dma_make_ptr(buf0 + ((t - t0) % LG_NBUF) * c->tile_bytes, w + (size_t) t * c->tile_bytes),
+                                   c->tile_bytes, c->tile_bytes, 1);
+    }
+
+    const HVX_Vector one_hf = Q6_Vh_vsplat_R(0x3c00);
+    const HVX_Vector nib    = Q6_Vb_vsplat_R(0x0f);
+    for (uint32_t t = t0; t < t1; t++) {
+        const uint8_t * tile = (const uint8_t *) dma_queue_pop(q).dst;
+        const uint32_t tn = t + LG_NBUF - 1;
+        if (tn < t1) {
+            dma_queue_push_ddr_to_vtcm(q, dma_make_ptr(buf0 + ((tn - t0) % LG_NBUF) * c->tile_bytes, w + (size_t) tn * c->tile_bytes),
+                                       c->tile_bytes, c->tile_bytes, 1);
+        }
+        for (uint32_t col = 0; col < c->ncols; col++) {
+            const int32_t * x4 = (const int32_t *) (c->xq + (size_t) col * c->K);
+            const int32_t * s8 = c->xsum8 + (size_t) col * (c->K / 32);
+            const float   * xd = c->xd + (size_t) col * (c->K / 32);
+            HVX_Vector acc = Q6_V_vzero();
+            for (uint32_t p = 0; p < c->npair; p++) {
+                const HVX_Vector * pv = (const HVX_Vector *) (tile + (size_t) p * LG_Q4_PAIR_BYTES);
+                const HVX_VectorPair dw = Q6_Wqf32_vmpy_VhfVhf(pv[8], one_hf);      // lo: block 0's d, hi: block 1's
+                #pragma unroll(2)
+                for (int b = 0; b < 2; b++) {
+                    const int32_t * xb = x4 + (2 * p + b) * 8;                       // 32 inputs = 8 words
+                    HVX_Vector s0 = Q6_V_vzero(), s1 = Q6_V_vzero();
+                    #pragma unroll(4)
+                    for (int v = 0; v < 4; v++) {
+                        const HVX_Vector pk = pv[4 * b + v];
+                        s0 = Q6_Vw_vrmpyacc_VwVubRb(s0, Q6_V_vand_VV(pk, nib), xb[v]);
+                        s1 = Q6_Vw_vrmpyacc_VwVubRb(s1, Q6_V_vand_VV(Q6_Vuh_vlsr_VuhR(pk, 4), nib), xb[4 + v]);
+                    }
+                    const HVX_Vector isum = Q6_Vw_vsub_VwVw(Q6_Vw_vadd_VwVw(s0, s1), Q6_V_vsplat_R(s8[2 * p + b]));
+                    const HVX_Vector d = Q6_Vsf_equals_Vqf32(b ? Q6_V_hi_W(dw) : Q6_V_lo_W(dw));
+                    const HVX_Vector a = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(Q6_Vsf_equals_Vw(isum), d));
+                    acc = Q6_Vqf32_vadd_Vqf32Vqf32(acc, Q6_Vqf32_vmpy_VsfVsf(a, hvx_vec_splat_f32(xd[2 * p + b])));
+                }
+            }
+            float * y = (float *) ((uint8_t *) c->dst->data + (size_t) (c->col0 + col) * c->dst->nb[1]) + (size_t) t * LG_TILE_ROWS;
+            *(HVX_UVector *) y = Q6_Vsf_equals_Vqf32(acc);
+        }
+    }
+}
+
+int lg_op_matmul_q4_0(struct htp_ops_context * octx) {
+    const struct htp_tensor * src0 = octx->src[0];
+    const struct htp_tensor * src1 = octx->src[1];
+    const struct htp_tensor * dst  = octx->dst;
+
+    struct lg_q4 c;
+    memset(&c, 0, sizeof(c));
+    c.src0 = src0; c.src1 = src1; c.dst = dst; c.ctx = octx->ctx;
+    c.K = src0->ne[0];
+    c.N = src0->ne[1];
+    if (c.K % 256 || c.N % LG_TILE_ROWS || src1->type != HTP_TYPE_F32 || src1->ne[2] != 1 || src1->ne[3] != 1) {
+        return HTP_STATUS_NO_SUPPORT;
+    }
+    c.npair      = c.K / LG_Q4_PAIR;
+    c.ntiles     = c.N / LG_TILE_ROWS;
+    c.tile_bytes = (size_t) c.npair * LG_Q4_PAIR_BYTES;
+    c.n_jobs     = octx->n_threads;
+
+    const size_t wbytes   = hex_round_up(LG_NBUF * c.tile_bytes * c.n_jobs, 128);
+    const size_t col_size = hex_round_up(c.K, 128) + 2 * hex_round_up(c.K / 32 * 4, 128);
+    if (octx->ctx->vtcm_size < wbytes || c.n_jobs > HTP_MAX_NTHREADS || col_size > LG_XBUF) {
+        return HTP_STATUS_VTCM_TOO_SMALL;
+    }
+    if (octx->flags & HTP_OPFLAGS_SKIP_COMPUTE) {
+        return HTP_STATUS_OK;
+    }
+    if (!lg_xbuf && !(lg_xbuf = memalign(128, LG_XBUF))) return HTP_STATUS_INTERNAL_ERR;
+    if (!lg_tbuf && !(lg_tbuf = memalign(128, HTP_MAX_NTHREADS * LG_SB_INPUTS * 4))) return HTP_STATUS_INTERNAL_ERR;
+    uint8_t * xbuf = lg_xbuf, * tbuf = lg_tbuf;
+
+    const uint32_t max_cols = LG_XBUF / col_size;
+    const uint32_t ncols    = src1->ne[1];
+    c.wbuf = octx->ctx->vtcm_base;
+    c.xtmp = (float *) tbuf;
+
+    for (uint32_t col0 = 0; col0 < ncols; col0 += max_cols) {
+        c.col0  = col0;
+        c.ncols = MIN(max_cols, ncols - col0);
+        uint8_t * p = xbuf;
+        c.xq    = (int8_t *) p;  p += hex_round_up((size_t) c.ncols * c.K, 128);
+        c.xsum8 = (int32_t *) p; p += hex_round_up((size_t) c.ncols * (c.K / 32) * 4, 128);
+        c.xd    = (float *) p;
+
+        const bool cached = (ncols <= max_cols && lg_q4_xcache_src == src1->data && lg_q4_xcache_ncols == ncols);
+        if (!cached) {
+            worker_pool_run_func(octx->ctx->worker_pool, lg_q4_quant_job, &c, MIN(c.n_jobs, c.ncols * (c.K / 256)));
+            lg_q4_xcache_src   = (ncols <= max_cols) ? src1->data : 0;
+            lg_q4_xcache_ncols = ncols;
+            lg_q2k_xcache_src  = 0;   // both formats share xbuf
+        }
+        worker_pool_run_func(octx->ctx->worker_pool, lg_q4_mv_job, &c, c.n_jobs);
+    }
+    octx->src1_spad.src = NULL;
+    return HTP_STATUS_OK;
+}
