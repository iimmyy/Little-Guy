+// LG: Q2_K for the v68 NPU (htp/lg-q2k-ops.c). Rows go in tiles of 32; per (tile, super-block of 256 inputs)
+// 2688 bytes, the same as the 32 original blocks:
+//   16 x 128 B weights: vector p covers inputs 16p..16p+15, word r = row r, bits 2k+1:2k of byte j = 2-bit weight
+//                       of input 16p + 4k + j
+//    4 x 128 B scales:  vector v, word r, byte i = scales[4v + i] of row r
+//    1 x 128 B d/dmin:  fp16 lane 2r = d of row r, lane 2r + 1 = dmin of row r
+// block_q2_K is read by byte offset: scales at 0, qs at 16, d at 80, dmin at 82.
+#define LG_Q2K_ROWS     32
+#define LG_Q2K_SB_BYTES 2688
+
+static void lg_q2k_tile_sb(uint8_t * o, const uint8_t * const * blk) {
+    memset(o, 0, LG_Q2K_SB_BYTES);
+    for (int r = 0; r < LG_Q2K_ROWS; r++) {
+        const uint8_t * b  = blk[r];
+        const uint8_t * qs = b + 16;
+        for (int p = 0; p < 16; p++) {
+            // input 16p + t lives in qs[32 * (p / 8) + 16 * (p % 2) + t] at bit shift 2 * ((p % 8) / 2)
+            const uint8_t * src = qs + 32 * (p / 8) + 16 * (p % 2);
+            const int shift = 2 * ((p % 8) / 2);
+            for (int j = 0; j < 4; j++) {
+                uint8_t v = 0;
+                for (int k = 0; k < 4; k++) v |= ((src[4 * k + j] >> shift) & 3) << (2 * k);
+                o[p * 128 + 4 * r + j] = v;
+            }
+            o[2048 + (p / 4) * 128 + 4 * r + p % 4] = b[p];
+        }
+        memcpy(o + 2560 + 4 * r, b + 80, 4);   // d, dmin
+    }
+}
+
+static void lg_q2k_untile_sb(uint8_t * const * blk, const uint8_t * o) {
+    for (int r = 0; r < LG_Q2K_ROWS; r++) {
+        uint8_t * b  = blk[r];
+        uint8_t * qs = b + 16;
+        memset(qs, 0, 64);
+        for (int p = 0; p < 16; p++) {
+            uint8_t * dst = qs + 32 * (p / 8) + 16 * (p % 2);
+            const int shift = 2 * ((p % 8) / 2);
+            for (int j = 0; j < 4; j++) {
+                const uint8_t v = o[p * 128 + 4 * r + j];
+                for (int k = 0; k < 4; k++) dst[4 * k + j] |= ((v >> (2 * k)) & 3) << shift;
+            }
+            b[p] = o[2048 + (p / 4) * 128 + 4 * r + p % 4];
+        }
+        memcpy(b + 80, o + 2560 + 4 * r, 4);
+    }
+}
+
+static void repack_q2_K_lgtile(ggml_tensor * t, const void * data, size_t size) {
+    const int64_t K = t->ne[0], N = ggml_nrows(t), nsb = K / QK_K;
+    GGML_ASSERT(K % QK_K == 0 && N % LG_Q2K_ROWS == 0 && size == ggml_nbytes(t));
+    const size_t row = ggml_row_size(t->type, K);
+    const uint8_t * src = (const uint8_t *) data;
+    uint8_t * dst = (uint8_t *) t->data;
+    std::vector<uint8_t> o(LG_Q2K_SB_BYTES);
+    const uint8_t * blk[LG_Q2K_ROWS];
+    for (int64_t tile = 0; tile < N / LG_Q2K_ROWS; tile++) {
+        for (int64_t sb = 0; sb < nsb; sb++) {
+            for (int r = 0; r < LG_Q2K_ROWS; r++) blk[r] = src + (tile * LG_Q2K_ROWS + r) * row + sb * sizeof(block_q2_K);
+            lg_q2k_tile_sb(o.data(), blk);
+            memcpy(dst + (tile * nsb + sb) * LG_Q2K_SB_BYTES, o.data(), LG_Q2K_SB_BYTES);
+        }
+    }
+}
+
+static void repack_lgtile_q2_K(void * data, const ggml_tensor * t, size_t size) {
+    const int64_t K = t->ne[0], N = ggml_nrows(t), nsb = K / QK_K;
+    GGML_ASSERT(size == ggml_nbytes(t));
+    const size_t row = ggml_row_size(t->type, K);
+    uint8_t * dst = (uint8_t *) data;
+    const uint8_t * src = (const uint8_t *) t->data;
+    uint8_t * blk[LG_Q2K_ROWS];
+    for (int64_t tile = 0; tile < N / LG_Q2K_ROWS; tile++) {
+        for (int64_t sb = 0; sb < nsb; sb++) {
+            for (int r = 0; r < LG_Q2K_ROWS; r++) blk[r] = dst + (tile * LG_Q2K_ROWS + r) * row + sb * sizeof(block_q2_K);
+            lg_q2k_untile_sb(blk, src + (tile * nsb + sb) * LG_Q2K_SB_BYTES);
+        }
+    }
+}
+
+// LG: Q4_0 in the same 32-row tiles (htp/lg-q2k-ops.c, lg_op_matmul_q4_0). Per (tile, pair of 32-input blocks)
+// 1152 bytes: 8 x 128 B weights (vector 4b + v, word r = qs[4v .. 4v+3] of row r's block b) and 1 x 128 B scales
+// (fp16 lane 2r = d of row r's first block, 2r + 1 = its second). block_q4_0 = d (2 bytes) then qs[16].
+#define LG_Q4_PAIR_BYTES 1152
+
+static void repack_q4_0_lgtile(ggml_tensor * t, const void * data, size_t size) {
+    const int64_t K = t->ne[0], N = ggml_nrows(t), npair = K / 64;
+    GGML_ASSERT(K % 256 == 0 && N % 32 == 0 && size == ggml_nbytes(t));
+    const size_t row = ggml_row_size(t->type, K);
+    const uint8_t * src = (const uint8_t *) data;
+    uint8_t * dst = (uint8_t *) t->data;
+    std::vector<uint8_t> o(LG_Q4_PAIR_BYTES);
+    for (int64_t tile = 0; tile < N / 32; tile++) {
+        for (int64_t p = 0; p < npair; p++) {
+            for (int r = 0; r < 32; r++) {
+                for (int b = 0; b < 2; b++) {
+                    const uint8_t * blk = src + (tile * 32 + r) * row + (2 * p + b) * sizeof(block_q4_0);
+                    for (int v = 0; v < 4; v++) memcpy(&o[(4 * b + v) * 128 + 4 * r], blk + 2 + 4 * v, 4);
+                    memcpy(&o[1024 + 4 * r + 2 * b], blk, 2);
+                }
+            }
+            memcpy(dst + (tile * npair + p) * LG_Q4_PAIR_BYTES, o.data(), LG_Q4_PAIR_BYTES);
+        }
+    }
+}
+
+static void repack_lgtile_q4_0(void * data, const ggml_tensor * t, size_t size) {
+    const int64_t K = t->ne[0], N = ggml_nrows(t), npair = K / 64;
+    GGML_ASSERT(size == ggml_nbytes(t));
+    const size_t row = ggml_row_size(t->type, K);
+    uint8_t * dst = (uint8_t *) data;
+    const uint8_t * src = (const uint8_t *) t->data;
+    for (int64_t tile = 0; tile < N / 32; tile++) {
+        for (int64_t p = 0; p < npair; p++) {
+            const uint8_t * o = src + (tile * npair + p) * LG_Q4_PAIR_BYTES;
+            for (int r = 0; r < 32; r++) {
+                for (int b = 0; b < 2; b++) {
+                    uint8_t * blk = dst + (tile * 32 + r) * row + (2 * p + b) * sizeof(block_q4_0);
+                    for (int v = 0; v < 4; v++) memcpy(blk + 2 + 4 * v, &o[(4 * b + v) * 128 + 4 * r], 4);
+                    memcpy(blk, &o[1024 + 4 * r + 2 * b], 2);
+                }
+            }
+        }
+    }
+}
