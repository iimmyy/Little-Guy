+// LG: NPU-side trace for debugging on v68 (FARF output is not visible on this board). Writes go through the
+// FastRPC file service into the directory of ADSP_LIBRARY_PATH. No printf: the op threads have small stacks.
+#pragma once
+// #define LG_TRACE 1   // turn on to debug (each write is a round trip to the host: never leave on in timing runs)
+#ifdef LG_TRACE
+#include <stdio.h>
+#include <string.h>
+extern FILE * lg_trace_f;   // one handle for all files (defined in main.c)
+static inline void lg_trace_kv(const char * tag, unsigned v) {
+    if (!lg_trace_f) lg_trace_f = fopen("htp_trace.txt", "a");
+    FILE * f = lg_trace_f;
+    if (!f) return;
+    char b[16]; int n = 0; char t[12]; int k = 0;
+    do { t[k++] = '0' + v % 10; v /= 10; } while (v && k < 11);
+    while (k) b[n++] = t[--k];
+    b[n++] = '\n';
+    fwrite(tag, 1, strlen(tag), f); fwrite(" ", 1, 1, f); fwrite(b, 1, n, f);
+    fflush(f);
+}
+#else
+#define lg_trace_kv(...) ((void) 0)
+#endif
