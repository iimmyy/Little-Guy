+#if __HVX_ARCH__ < 73
+// LG: on v68 a DMA transfer whose destination is DDR (VTCM -> DDR write-back) kills the DSP process, while
+// DDR -> VTCM reads work. Transfers that do not land in VTCM are done here with a synchronous copy instead and
+// queued as already complete, so the push/pop pairing of the callers is unchanged.
+extern uint8_t * lg_vtcm_lo;
+extern uint8_t * lg_vtcm_hi;
+static inline bool lg_dma_lands_in_vtcm(const void * p) {
+    return (const uint8_t *) p >= lg_vtcm_lo && (const uint8_t *) p < lg_vtcm_hi;
+}
+static inline bool lg_copy_push(dma_queue * q, dma_ptr dptr, size_t dst_stride, size_t src_stride, size_t row_size, size_t nrows) {
+    // HVX vector copy (callers run on HVX worker threads): DDR is uncached on the DSP side, so a scalar memcpy
+    // here costs ~50 cycles per byte while 128-byte vector stores run near memory speed.
+    for (size_t r = 0; r < nrows; r++) {
+        hvx_copy_uu((uint8_t *) dptr.dst + r * dst_stride, (const uint8_t *) dptr.src + r * src_stride, row_size, 1);
+    }
+    return dma_queue_push_single_1d(q, dptr, 0);   // size 0: recorded as done, nothing sent to the DMA engine
+}
+#endif
+
 #if __HVX_ARCH__ < 75
 
