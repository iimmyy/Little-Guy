From dffbc50c00d026c99c14ea0073171c96efc8eca9 Mon Sep 17 00:00:00 2001
From: iimmyy <i.a.martins001@gmail.com>
Date: Wed, 14 Oct 2026 14:38:12 -0700
Subject: [PATCH 31/38] perplexity: LG_PPL_SPECIAL=1 reads chat markers in the
 text as control tokens, so an instruction-tuned model can be scored on
 chat-formatted text

---
 tools/perplexity/perplexity.cpp | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/tools/perplexity/perplexity.cpp b/tools/perplexity/perplexity.cpp
index 92f8830..7147107 100644
--- a/tools/perplexity/perplexity.cpp
+++ b/tools/perplexity/perplexity.cpp
@@ -37,6 +37,13 @@ struct results_log_softmax {
     float  prob;
 };
 
+// LG: LG_PPL_SPECIAL=1 reads chat markers (e.g. Gemma's <|turn>) in the text as the model's control tokens, so an
+// instruction-tuned model can be scored on chat-formatted text
+static bool lg_parse_special() {
+    static const bool on = [] { const char * e = getenv("LG_PPL_SPECIAL"); return e && atoi(e) > 0; }();
+    return on;
+}
+
 static std::vector<float> softmax(const std::vector<float>& logits) {
     std::vector<float> probs(logits.size());
     float max_logit = logits[0];
@@ -307,7 +314,7 @@ static results_perplexity perplexity_v2(llama_context * ctx, const common_params
 
     LOG_INF("%s: tokenizing the input ..\n", __func__);
 
-    std::vector<llama_token> tokens = common_tokenize(ctx, params.prompt, true);
+    std::vector<llama_token> tokens = common_tokenize(ctx, params.prompt, true, lg_parse_special());
 
     const int n_ctx = llama_n_ctx(ctx);
 
@@ -472,7 +479,7 @@ static results_perplexity perplexity(llama_context * ctx, const common_params &
     auto tim1 = std::chrono::high_resolution_clock::now();
     LOG_INF("%s: tokenizing the input ..\n", __func__);
 
-    std::vector<llama_token> tokens = common_tokenize(ctx, params.prompt, true);
+    std::vector<llama_token> tokens = common_tokenize(ctx, params.prompt, true, lg_parse_special());
 
     auto tim2 = std::chrono::high_resolution_clock::now();
     LOG_INF("%s: tokenization took %g ms\n",__func__,1e-3*std::chrono::duration_cast<std::chrono::microseconds>(tim2-tim1).count());
