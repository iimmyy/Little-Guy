# Copy to littleguy.env (ignored by git) and fill in your own values.
# How the Mac reaches the board over ssh (a host alias from ~/.ssh/config works best).
LITTLEGUY_BOARD_SSH=myboard
# The board's status page (board/web/littleguy_web.py), read by the menu bar app.
LITTLEGUY_BOARD_URL=http://192.168.1.50:8080
